# ==================== 公共配置（所有环境共享） ====================
# 本文件可提交到仓库，严禁写入连接串、密码、密钥等任何真实敏感信息。
# 加载顺序（后加载的同名变量覆盖先加载的）：
#   .env（公共） → .env.${APP_ENV}（.env.dev / .env.prod） → .env.local（仅非生产环境）
# 环境相关配置请放到对应文件：
#   - 开发默认值：.env.dev
#   - 本机覆盖：  .env.local（已 gitignore）
#   - 生产配置：  .env.prod（已 gitignore，通过 Docker Compose env_file 注入）

# ==================== 服务监听 ====================
# 服务监听端口，需与前端代理及移动端 config/env.ts 的 LOCAL_HOST 端口一致。
APP_PORT=5193

# ==================== 业务展示 ====================
# 工作台「今日新增 / 近 N 日趋势」按该时区切分自然日；数据库仍统一存储 UTC。
BUSINESS_TIMEZONE=Asia/Shanghai

# ==================== 日志 ====================
# 日志级别：DEBUG / INFO / WARNING / ERROR。
LOG_LEVEL=INFO
# 是否写本地轮转文件 logs/app.log、logs/error.log；生产容器建议 false，仅输出 stdout。
LOG_TO_FILE=false
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# 是否输出 SQLAlchemy SQL 日志；默认关闭，生产禁止开启。
SQL_ECHO=false
# 是否输出 HTTP 访问日志。
ACCESS_LOG_ENABLED=true
# 慢请求阈值（毫秒）。
SLOW_REQUEST_MS=2000
ACCESS_LOG_SKIP_PATHS=/health/live,/health/ready,/favicon.ico

# ==================== MinIO 通用参数 ====================
# 是否使用 HTTPS 连接 MinIO；若生产改用 HTTPS，可在 .env.prod 中覆盖。
MINIO_SECURE=false
# MinIO 服务区域；未配置区域时留空。
MINIO_REGION=

# ==================== 管理端会话 ====================
# 管理端 HttpOnly 会话 Cookie 名称。
SESSION_COOKIE_NAME=neighinn_admin_session
# 管理端会话有效期，单位为分钟。
SESSION_TTL_MINUTES=480
# 是否校验管理端写操作的 CSRF Token。
AUTH_ENFORCE_CSRF=true

# ==================== 进程内调度 ====================
# 单 worker 运行时保持 true；若改为多 worker，需要把调度器拆成独立进程，避免重复执行。
ENABLE_SCHEDULER=true
OUTBOX_INTERVAL_SECONDS=5
TIMEOUT_INTERVAL_SECONDS=60
