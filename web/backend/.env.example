# ==================== 应用基础配置 ====================
# 运行环境：dev 开发、test 测试、prod 生产。
APP_ENV=dev
# 服务监听地址；127.0.0.1 仅允许本机访问，0.0.0.0 允许外部访问（真机联调时临时改为 0.0.0.0）。
APP_HOST=127.0.0.1
# 服务监听端口，需与前端代理及移动端本地环境地址一致（移动端 config/env.ts 的 LOCAL_HOST:5193）。
APP_PORT=5193
# 是否启用调试模式及 SQL 日志；生产环境应设为 false。
DEBUG=true
# 数据加密、签名等安全功能的密钥；生产环境必须替换为至少 32 字节的强随机值。
SECRET_KEY=dev-only-change-me-please-32bytes-min

# ==================== PostgreSQL 数据库 ====================
# 异步 SQLAlchemy 数据库连接串，包含数据库类型、账号、密码、主机、端口和库名。
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/neighinn_platform

# ==================== Redis 会话与缓存 ====================
# Redis 连接串；开发环境留空时使用进程内会话，服务重启后登录状态失效。
# 若 Redis 需要认证，请在 URL 中携带密码（redis://:密码@host:port/db）；否则启动时自动降级为内存并告警。
REDIS_URL=redis://127.0.0.1:6379/0
# 短信验证码存储后端：memory（进程内，重启失效）| redis（推荐，重启/多副本不丢）。
SMS_CODE_BACKEND=memory

# ==================== RabbitMQ 消息队列 ====================
# RabbitMQ 连接串；留空时 Outbox 事件仅记录到进程日志，不投递到消息队列。
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# ==================== MinIO 对象存储 ====================
# MinIO 服务地址，格式为“主机:端口”，不包含 http:// 或 https://。
MINIO_ENDPOINT=127.0.0.1:9000
# MinIO 访问账号。
MINIO_ACCESS_KEY=minioadmin
# MinIO 访问密钥。
MINIO_SECRET_KEY=minioadmin
# 是否使用 HTTPS 连接 MinIO。
MINIO_SECURE=false
# MinIO 服务区域；未配置区域时留空。
MINIO_REGION=
# 存放公开访问文件的存储桶。
MINIO_BUCKET_PUBLIC=ni-public
# 存放认证材料等私有文件的存储桶。
MINIO_BUCKET_PRIVATE=ni-private
# 存放系统内部文件的存储桶。
MINIO_BUCKET_SYSTEM=ni-system

# ==================== 管理端会话与认证 ====================
# 管理端 HttpOnly 会话 Cookie 名称。
SESSION_COOKIE_NAME=ni_admin_session
# 管理端会话有效期，单位为分钟。
SESSION_TTL_MINUTES=480
# 是否强制已绑定双因素认证的管理员在登录时提供动态验证码。
AUTH_REQUIRE_2FA=false
# 是否校验管理端写操作的 CSRF Token。
AUTH_ENFORCE_CSRF=true

# ==================== 跨域访问控制 ====================
# 允许携带凭据访问后端的前端来源，多个来源使用英文逗号分隔。
# 5191 = 移动端 H5 端口（manifest.json 的 web.devServer.port / h5.devServer.port）；
# 5192 = Web 管理端前端；5173 = Vite 默认端口（兼容保留）。
CORS_ORIGINS=http://localhost:5191,http://127.0.0.1:5191,http://localhost:5192,http://127.0.0.1:5192,http://localhost:5173,http://127.0.0.1:5173
# 开发环境额外允许的跨域来源正则：本机/私网 IP 的任意端口（真机调试用私网 IP，端口变化时也兼容）；生产环境不生效。
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}):\d{1,5}$
