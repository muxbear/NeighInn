# ==================== 配置模板与加载规则 ====================
# 本文件仅作配置项参考，不会被自动加载，请勿整份复制为 .env。
#
# 加载顺序（后加载的同名变量覆盖先加载的）：
#   .env  →  .env.${APP_ENV}（.env.dev / .env.prod）  →  .env.local（APP_ENV != prod 时）
#
# 文件职责：
#   .env        公共配置，所有环境共享（可提交，禁止写入密钥）
#   .env.dev    开发环境默认值（可提交，禁止写入真实密钥）
#   .env.local  本机覆盖配置（已 gitignore）
#   .env.prod   生产配置（已 gitignore，由 Docker Compose env_file 注入）
#
# 首次本地开发：
#   1. 将下方“公共配置”复制到 .env；
#   2. .env.dev 仓库已提供，按需修改；
#   3. 将本机数据库/Redis/MinIO 连接串写入 .env.local。

# ==================== 公共配置 → .env ====================
# 服务监听端口，需与前端代理及移动端 config/env.ts 的 LOCAL_HOST 端口一致。
APP_PORT=5193
# 工作台「今日新增 / 近 N 日趋势」按该时区切分自然日；数据库仍统一存储 UTC。
BUSINESS_TIMEZONE=Asia/Shanghai

LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
SQL_ECHO=false
ACCESS_LOG_ENABLED=true
SLOW_REQUEST_MS=2000
ACCESS_LOG_SKIP_PATHS=/health/live,/health/ready,/favicon.ico

MINIO_SECURE=false
MINIO_REGION=

SESSION_COOKIE_NAME=neighinn_admin_session
SESSION_TTL_MINUTES=480
# 会话 Cookie 的 Secure 属性：不设置时按请求协议自动判定
#（X-Forwarded-Proto / scheme 为 https 才带 Secure）；可显式 true/false 强制。
# SESSION_COOKIE_SECURE=true
AUTH_ENFORCE_CSRF=true

ENABLE_SCHEDULER=true
OUTBOX_INTERVAL_SECONDS=5
TIMEOUT_INTERVAL_SECONDS=60

# 邻居好友（消息-邻居 Tab）运行参数，默认值见 src/core/config.py
# NEIGHBOR_FRIENDS_ENABLED=true
# NEIGHBOR_EMOJI_ENABLED=true
# NEIGHBOR_BLOCK_ENABLED=true
# NEIGHBOR_BLOCK_MAX_COUNT=1000
# NEIGHBOR_MESSAGE_MAX_LENGTH=500
# NEIGHBOR_MESSAGE_RATE_PER_MINUTE=20
# NEIGHBOR_PAGE_SIZE=50
# NEIGHBOR_RETENTION_DAYS=1095

# ==================== 开发环境默认值 → .env.dev ====================
APP_ENV=dev
APP_HOST=127.0.0.1
DEBUG=true
SECRET_KEY=dev-only-change-me-please-32bytes-min
LOG_FORMAT=console

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/neighinn_dev
REDIS_URL=redis://127.0.0.1:6379/0
SMS_CODE_BACKEND=memory
# 真实短信通道未接入时的临时演示开关：true 时非 dev 环境也会回显验证码（仅内网演示）。
SMS_MOCK_ENABLED=false
RABBITMQ_URL=

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PUBLIC=neighinn-public
MINIO_BUCKET_PRIVATE=neighinn-private
MINIO_BUCKET_SYSTEM=neighinn-system

AUTH_REQUIRE_2FA=false
CORS_ORIGINS=http://localhost:5191,http://127.0.0.1:5191,http://localhost:5192,http://127.0.0.1:5192,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}):\d{1,5}$

# ==================== 本机覆盖示例 → .env.local ====================
# 仅列出与 .env.dev 不同、且因人/因机而异的配置；同名变量会覆盖前面的值。
# APP_ENV=dev
# APP_HOST=0.0.0.0
# DEBUG=true
# SECRET_KEY=dev-only-change-me-please-32bytes-min
# LOG_FORMAT=console
# DATABASE_URL=postgresql+psycopg://admin:password@10.8.0.32:5432/neighinn_dev
# REDIS_URL=redis://:password@10.8.0.32:6379/10
# SMS_CODE_BACKEND=redis
# SMS_MOCK_ENABLED=false
# RABBITMQ_URL=
# MINIO_ENDPOINT=10.8.0.32:9000
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_BUCKET_PUBLIC=neighinn-public
# MINIO_BUCKET_PRIVATE=neighinn-private
# MINIO_BUCKET_SYSTEM=neighinn-system
# AUTH_REQUIRE_2FA=false
# CORS_ORIGINS=http://localhost:5191,http://127.0.0.1:5191,http://localhost:5192,http://127.0.0.1:5192,http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}):\d{1,5}$

# ==================== 生产环境 → .env.prod ====================
# 生产文件需保持完整（可直接用于 docker run --env-file / compose env_file），
# 至少覆盖以下差异项；完整字段参考当前 .env.prod。
# APP_ENV=prod
# APP_HOST=0.0.0.0
# DEBUG=false
# SECRET_KEY=请替换为至少 32 字节的强随机值
# LOG_FORMAT=json
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5205/neighinn_prod
# REDIS_URL=redis://default:password@127.0.0.1:5201/0
# SMS_CODE_BACKEND=redis
# 临时演示才设为 true；正式上线必须保持 false。
# SMS_MOCK_ENABLED=false
# RABBITMQ_URL=
# MINIO_ENDPOINT=127.0.0.1:5206
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_BUCKET_PUBLIC=ni-public
# MINIO_BUCKET_PRIVATE=ni-private
# MINIO_BUCKET_SYSTEM=ni-system
# AUTH_REQUIRE_2FA=false
# CORS_ORIGINS=http://127.0.0.1:5191,http://localhost:5191,http://127.0.0.1:5192,http://localhost:5192
# CORS_ORIGIN_REGEX=
