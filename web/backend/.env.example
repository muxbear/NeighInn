# ==================== 应用基础配置 ====================
# 运行环境：dev 开发、test 测试、prod 生产。
APP_ENV=dev
# 服务监听地址；127.0.0.1 仅允许本机访问，0.0.0.0 允许外部访问。
APP_HOST=127.0.0.1
# 服务监听端口，需与前端代理及移动端本地环境地址一致。
APP_PORT=5194
# 是否启用调试模式及 SQL 日志；生产环境应设为 false。
DEBUG=true
# 数据加密、签名等安全功能的密钥；生产环境必须替换为至少 32 字节的强随机值。
SECRET_KEY=dev-only-change-me-please-32bytes-min

# ==================== PostgreSQL 数据库 ====================
# 异步 SQLAlchemy 数据库连接串，包含数据库类型、账号、密码、主机、端口和库名。
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/neighinn_platform

# ==================== Redis 会话与缓存 ====================
# Redis 连接串；开发环境留空时使用进程内会话，服务重启后登录状态失效。
REDIS_URL=redis://127.0.0.1:6379/0

# ==================== RabbitMQ 消息队列 ====================
# RabbitMQ 连接串；留空时 Outbox 事件仅记录到进程日志，不投递到消息队列。
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# ==================== MinIO 对象存储 ====================
# MinIO 服务地址，格式为“主机:端口”，不包含 http:// 或 https://。
MINIO_ENDPOINT=127.0.0.1:9000
# MinIO 访问账号。
MINIO_ACCESS_KEY=minioadmin
# MinIO 访问密钥。
MINIO_SECRET_KEY=minioadmin
# 是否使用 HTTPS 连接 MinIO。
MINIO_SECURE=false
# MinIO 服务区域；未配置区域时留空。
MINIO_REGION=
# 存放公开访问文件的存储桶。
MINIO_BUCKET_PUBLIC=ni-public
# 存放认证材料等私有文件的存储桶。
MINIO_BUCKET_PRIVATE=ni-private
# 存放系统内部文件的存储桶。
MINIO_BUCKET_SYSTEM=ni-system

# ==================== 管理端会话与认证 ====================
# 管理端 HttpOnly 会话 Cookie 名称。
SESSION_COOKIE_NAME=ni_admin_session
# 管理端会话有效期，单位为分钟。
SESSION_TTL_MINUTES=480
# 是否强制已绑定双因素认证的管理员在登录时提供动态验证码。
AUTH_REQUIRE_2FA=false
# 是否校验管理端写操作的 CSRF Token。
AUTH_ENFORCE_CSRF=true

# ==================== 跨域访问控制 ====================
# 允许携带凭据访问后端的前端来源，多个来源使用英文逗号分隔。
CORS_ORIGINS=http://localhost:5191,http://127.0.0.1:5191,http://localhost:5192,http://127.0.0.1:5192
