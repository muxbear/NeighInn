# ==================== 开发环境默认配置 ====================
# 本文件可提交到仓库，仅存放开发环境的默认值，禁止写入真实密钥。
# 本机差异（远程数据库地址、个人账号、调试端口等）请写入 .env.local，不要修改本文件。

# 运行环境：dev 开发、test 测试、prod 生产。
APP_ENV=dev
# 服务监听地址；127.0.0.1 仅允许本机访问，0.0.0.0 允许外部访问（真机联调时在 .env.local 覆盖）。
APP_HOST=127.0.0.1
# 调试标记（保留）；SQL 日志已与 DEBUG 解耦，请使用 SQL_ECHO 控制。
DEBUG=true
# 数据加密、签名等安全功能的密钥；开发占位值，生产必须替换。
SECRET_KEY=dev-only-change-me-please-32bytes-min

# ==================== 日志 ====================
# 开发输出可读的 console 格式；生产使用 json。
LOG_FORMAT=console

# ==================== PostgreSQL 数据库 ====================
# 异步 SQLAlchemy 数据库连接串；默认指向本机开发库。
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/neighinn_dev

# ==================== Redis 会话与缓存 ====================
# 留空时使用进程内会话，服务重启后登录状态失效。
# 若 Redis 需要认证，请在 URL 中携带密码（redis://:密码@host:port/db）。
REDIS_URL=redis://127.0.0.1:6379/0
# 短信验证码存储后端：memory（进程内，重启失效）| redis（推荐，重启/多副本不丢）。
SMS_CODE_BACKEND=memory

# ==================== RabbitMQ 消息队列 ====================
# 留空时 Outbox 事件仅记录到进程日志，不投递到消息队列。
RABBITMQ_URL=

# ==================== MinIO 对象存储 ====================
# MinIO 服务地址，格式为“主机:端口”，不包含 http:// 或 https://。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# 存放公开访问文件的存储桶。
MINIO_BUCKET_PUBLIC=neighinn-public
# 存放认证材料等私有文件的存储桶。
MINIO_BUCKET_PRIVATE=neighinn-private
# 存放系统内部文件的存储桶。
MINIO_BUCKET_SYSTEM=neighinn-system

# ==================== 管理端认证 ====================
# 是否强制已绑定双因素认证的管理员在登录时提供动态验证码。
AUTH_REQUIRE_2FA=false

# ==================== 跨域访问控制 ====================
# 5191 = 移动端 H5；5192 = Web 管理端前端；5173 = Vite 默认端口（兼容保留）。
CORS_ORIGINS=http://localhost:5191,http://127.0.0.1:5191,http://localhost:5192,http://127.0.0.1:5192,http://localhost:5173,http://127.0.0.1:5173
# 开发环境额外允许的跨域来源正则：本机/私网 IP 的任意端口（真机调试用私网 IP）；生产不生效。
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}):\d{1,5}$
