{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "types/**/*.d.ts",
    "models/**/*.ts",
    "utils/**/*.ts",
    "config/**/*.ts",
    "api/**/*.ts",
    "services/**/*.ts",
    "stores/**/*.ts",
    "composables/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "unpackage"
  ]
}
