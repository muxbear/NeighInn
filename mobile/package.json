{
  "name": "neighinn-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "邻里小栈移动端（uni-app x Vapor + Vue 3 + TypeScript）",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "check:uvue": "node scripts/check-uvue.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check": "npm run type-check && npm run check:uvue && npm run check:links && npm run test",
    "icons": "node scripts/generate-icons.mjs && node scripts/generate-avatars.mjs"
  },
  "dependencies": {
    "pinia": "^2.2.6"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.45",
    "sass": "^1.108.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
