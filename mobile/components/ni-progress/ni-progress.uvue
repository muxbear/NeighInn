<template>
  <view class="ni-progress-wrap">
    <view class="ni-progress" :style="{ height: height + 'px' }">
      <view
        class="ni-progress__bar"
        :style="{ width: safePercent + '%', backgroundColor: color }"
      />
    </view>
    <text v-if="showText" class="ni-progress__text">{{ Math.round(safePercent) }}%</text>
  </view>
</template>

<script setup lang="ts">
import { computed } from 'vue'

const props = withDefaults(
  defineProps<{
    percent: number
    color?: string
    height?: number
    showText?: boolean
  }>(),
  {
    color: '#FF7A3D',
    height: 6,
    showText: false,
  },
)

const safePercent = computed(() => Math.min(100, Math.max(0, Number(props.percent) || 0)))
</script>

<style scoped lang="scss">
.ni-progress-wrap {
  flex-direction: row;
  align-items: center;
}
.ni-progress {
  flex: 1;
  border-radius: 5px;
  background-color: #f0edea;
  overflow: hidden;
}
.ni-progress__bar {
  height: 100%;
  border-radius: 5px;
  transition: width 0.3s ease-out;
}
.ni-progress__text {
  margin-left: 8px;
  font-size: $ni-font-9;
  color: $ni-color-text-tertiary;
}
</style>
