<template>
  <view class="ni-empty">
    <view class="ni-empty__icon">
      <ni-icon :name="icon" :size="38" state="active" />
    </view>
    <text class="ni-empty__title">{{ title }}</text>
    <text v-if="desc" class="ni-empty__desc">{{ desc }}</text>
    <view v-if="actionText" class="ni-empty__action" hover-class="ni-empty__action--pressed" @click="onAction">
      <text class="ni-empty__action-text">{{ actionText }}</text>
    </view>
  </view>
</template>

<script setup lang="ts">
const props = withDefaults(
  defineProps<{
    icon?: string
    title?: string
    desc?: string
    actionText?: string
  }>(),
  {
    icon: 'box',
    title: '这里还空空的',
    desc: '',
    actionText: '',
  },
)

const emit = defineEmits<{ (event: 'action'): void }>()

function onAction(): void {
  if (props.actionText) emit('action')
}
</script>

