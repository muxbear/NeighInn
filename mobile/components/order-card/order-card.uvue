  width: 42px;
  align-items: center;
  justify-content: center;
}
.order-card__swap-title {
  margin-top: 7px;
  font-size: $ni-font-10;
  line-height: 15px;
  font-weight: 600;
  color: $ni-color-text-primary;
}
.order-card__swap-progress {
  flex-direction: row;
  align-items: flex-start;
  margin-top: 10px;
}
.order-card__swap-step {
  flex: 1;
  flex-direction: row;
  align-items: center;
}
.order-card__step-dot {
  width: 16px;
  height: 16px;
  border-radius: 8px;
  background-color: #eee9e4;
  align-items: center;
  justify-content: center;
}
.order-card__step-dot--done {
  background-color: $ni-color-gift;
}
.order-card__step-dot--active {
  background-color: $ni-color-primary;
}
.order-card__step-label {
  margin-left: 3px;
  font-size: 7px;
  color: $ni-color-text-tertiary;
}
.order-card__step-label--done {
  color: $ni-color-gift-deep;
}
.order-card__step-label--active {
  color: $ni-color-primary-dark;
  font-weight: 600;
}
.order-card__step-line {
  flex: 1;
  height: 1px;
  background-color: #eee9e4;
