  margin-right: 4px;
}
.order-card__step-line--done {
  background-color: $ni-color-gift;
}
.order-card__product {
  flex-direction: row;
  align-items: center;
  margin-top: 11px;
}
.order-card__product-image {
  width: 68px;
  height: 68px;
  border-radius: $ni-radius-12;
  background-color: #f3ede7;
}
.order-card__product-copy {
  flex: 1;
  margin-left: 10px;
}
.order-card__product-title {
  font-size: $ni-font-10;
  line-height: 15px;
  font-weight: 600;
  color: $ni-color-text-primary;
}
.order-card__product-desc {
  margin-top: 3px;
