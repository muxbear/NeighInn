  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 5px;
}
.order-card__amount {
  font-size: $ni-font-12;
  font-weight: 700;
  color: $ni-color-primary-dark;
}
.order-card__free {
  font-size: $ni-font-10;
  font-weight: 600;
  color: $ni-color-gift;
}
.order-card__role {
  font-size: 7px;
  color: $ni-color-text-tertiary;
}
.order-card__review-tip {
  flex-direction: row;
  align-items: center;
  height: 28px;
  padding-left: 8px;
  padding-right: 8px;
  margin-top: 9px;
  border-radius: $ni-radius-8;
  background-color: $ni-color-credit-bg-2;
}
.order-card__review-text {
  margin-left: 4px;
  font-size: 7px;
  color: $ni-color-credit-deep;
}
.order-card__actions {
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 10px;
}
.order-card__action {
  height: 30px;
  padding-left: 12px;
  padding-right: 12px;
  border-radius: 10px;
  background-color: $ni-color-primary-bg;
  align-items: center;
  justify-content: center;
  margin-left: 8px;
}
.order-card__action--ghost {
  background-color: $ni-color-white;
  border: 1px solid #ffb68e;
}
.order-card__action-text {
  font-size: $ni-font-9;
  font-weight: 600;
  color: $ni-color-primary-dark;
}
.order-card__action-text--ghost {
  color: $ni-color-primary-dark;
}
</style>
