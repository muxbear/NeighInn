  margin-left: 4px;
  font-size: $ni-font-12;
  font-weight: 600;
  color: $ni-color-text-secondary;
}
.travel__grid {
  flex-direction: row;
  align-items: center;
  margin-top: 6px;
}
.travel__cell {
  flex: 1;
  align-items: center;
}
.travel__value {
  margin-top: 3px;
  font-size: $ni-font-10;
  font-weight: 700;
  color: $ni-color-text-primary;
}
.travel__label {
  margin-top: 1px;
  font-size: $ni-font-9;
