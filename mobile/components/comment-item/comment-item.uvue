<template>
  <view class="comment">
    <ni-avatar :src="comment.avatar" :name="comment.author" :size="34" variant="orange" />
    <view class="comment__body">
      <view class="comment__head">
        <text class="comment__name">{{ comment.author }}</text>
        <text class="comment__time">{{ comment.time }}</text>
      </view>
      <text v-if="comment.replyTo" class="comment__reply">回复 {{ comment.replyTo }}</text>
      <text class="comment__content">{{ comment.content }}</text>
      <view class="comment__actions">
        <text class="comment__action" @click="onReply">回复</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import type { ItemComment } from '../../models'

withDefaults(
  defineProps<{
    comment: ItemComment
  }>(),
  {},
)

const emit = defineEmits<{ (event: 'reply'): void }>()

function onReply(): void {
  emit('reply')
}
</script>

