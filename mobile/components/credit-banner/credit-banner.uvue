<template>
  <view class="credit" @click="onDetail">
    <view class="credit__icon">
      <ni-icon name="shield" :size="20" state="gold" />
    </view>
    <view class="credit__copy">
      <text class="credit__title">{{ level }} · {{ score }} 分</text>
      <text class="credit__desc" :lines="1">{{ desc }}</text>
    </view>
    <text class="credit__action">查看详情</text>
    <ni-icon name="chevron" :size="13" state="gold" />
  </view>
</template>

<script setup lang="ts">
withDefaults(
  defineProps<{
    score: number
    level: string
    desc?: string
  }>(),
  { desc: '完成交易、按时赴约、收到好评都能提升信用分' },
)

const emit = defineEmits<{ (event: 'detail'): void }>()

function onDetail(): void {
  emit('detail')
}
</script>

