<template>
  <view class="community-card" hover-class="community-card--pressed" :hover-stay-time="100" @click="onTap">
    <view class="community-card__icon">
      <ni-icon name="pin" :size="20" state="active" />
    </view>
    <view class="community-card__copy">
      <view class="community-card__name-row">
        <text class="community-card__name">{{ community.name }}</text>
        <ni-tag v-if="community.status === '已认证'" type="verified" size="xs">已认证</ni-tag>
        <ni-tag v-else-if="community.status === '审核中'" type="neutral" size="xs">审核中</ni-tag>
      </view>
      <text class="community-card__meta" :lines="1">
        {{ community.address || '小区地址' }} · {{ community.distance || '附近' }}
      </text>
      <text class="community-card__stats">
        {{ community.memberCount }} 位邻居 · {{ community.itemCount }} 件在售
      </text>
    </view>
    <view
      v-if="community.status !== '已认证' && community.status !== '审核中'"
      class="community-card__action"
      @click.stop="onApply"
    >
      <text class="community-card__action-text">申请加入</text>
    </view>
    <ni-icon v-else name="chevron" :size="15" state="tertiary" />
  </view>
</template>

<script setup lang="ts">
import type { CommunityBinding } from '../../models'

const props = defineProps<{ community: CommunityBinding }>()
const emit = defineEmits<{
  (event: 'tap'): void
  (event: 'apply'): void
}>()

function onTap(): void {
  emit('tap')
}
function onApply(): void {
  emit('apply')
}
</script>

