<template>
  <view class="conversation" hover-class="conversation--pressed" :hover-stay-time="100" @click="onTap">
    <view class="conversation__avatar-wrap">
      <ni-avatar :src="conversation.peerAvatar" :name="conversation.peerName" :size="48" variant="orange" />
      <view v-if="conversation.unread > 0" class="conversation__badge">
        <text class="conversation__badge-text">{{ conversation.unread > 99 ? '99+' : conversation.unread }}</text>
      </view>
    </view>
    <view class="conversation__body">
      <view class="conversation__head">
        <view class="conversation__name-row">
          <text class="conversation__name">{{ conversation.peerName }}</text>
          <ni-icon v-if="conversation.peerVerified" name="shield" :size="9" state="gold" />
        </view>
        <text class="conversation__time">{{ conversation.lastTime }}</text>
      </view>
      <text class="conversation__summary" :lines="1">{{ conversation.lastMessage }}</text>
    </view>
  </view>
</template>

<script setup lang="ts">
import type { Conversation } from '../../models'

defineProps<{ conversation: Conversation }>()
const emit = defineEmits<{ (event: 'tap'): void }>()

function onTap(): void {
  emit('tap')
}
</script>

