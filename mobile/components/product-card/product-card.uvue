<template>
  <view class="product-card" hover-class="product-card--pressed" :hover-stay-time="100" @click="onTap">
    <view class="product-card__media">
      <image class="product-card__image" :src="imageSrc" mode="aspectFill" lazy-load @error="imageFailed = true" />

      <view v-if="item.aiVerified" class="product-card__ai">
        <ni-icon name="spark" :size="10" state="white" />
        <text class="product-card__ai-text">AI 验真</text>
      </view>
      <view class="product-card__fav" :class="{ 'product-card__fav--active': item.favorite }" @click.stop="onFavorite">
        <ni-icon name="heart" :size="16" :state="item.favorite ? 'active' : 'white'" :filled="item.favorite" />
      </view>
      <view class="product-card__tag">
        <trade-tag :type="item.type" size="xs" />
      </view>
      <view v-if="item.distance" class="product-card__distance-badge">
        <ni-icon name="pin" :size="10" state="green" />
        <text class="product-card__distance-badge-text">{{ distanceShort }}</text>
      </view>
    </view>

    <view class="product-card__body">
      <text class="product-card__title" :lines="1">{{ item.title }}</text>

      <view class="product-card__price-row">
        <ni-price
          :value="item.price"
          :type="item.type === '免费' ? 'free' : item.type === '互换' ? 'swap' : 'sale'"
          size="md"
        />
        <view class="product-card__condition">
          <text class="product-card__condition-text">{{ item.condition }}</text>
        </view>
      </view>

      <view v-if="item.distance" class="product-card__distance">
        <view class="product-card__distance-left">
          <ni-icon name="walk" :size="12" state="green" />
          <text class="product-card__distance-text">{{ walkText }}</text>
        </view>
        <text class="product-card__time">{{ publishedText }}</text>
      </view>

      <view v-if="seller" class="product-card__owner">
        <ni-avatar :src="seller.avatar" :name="seller.name" :size="28" variant="orange" />
        <view class="product-card__owner-copy">
          <view class="product-card__owner-name-row">
            <text class="product-card__owner-name">{{ seller.name }}</text>
            <view class="product-card__level">
              <text class="product-card__level-text">LV.{{ sellerLevel }}</text>
            </view>
            <view v-if="seller.verified" class="product-card__verified">
              <ni-icon name="shield" :size="8" state="green" />
              <text class="product-card__verified-text">已认证</text>
            </view>
          </view>

          <view class="product-card__trust-row">
            <view class="product-card__community" :class="{ 'product-card__community--nearby': !isSameCommunity }">
              <ni-icon name="home" :size="8" :state="isSameCommunity ? 'green' : 'blue'" />
              <text class="product-card__community-text" :class="{ 'product-card__community-text--nearby': !isSameCommunity }">
                {{ communityLabel }}
              </text>
            </view>
            <view class="product-card__credit">
              <ni-icon name="spark" :size="8" state="gold" />
              <text class="product-card__credit-text">信用 {{ creditRating }}</text>
            </view>
            <text class="product-card__deals">成交 {{ seller.dealCount }} 次</text>
          </view>

        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed, ref, watch } from 'vue'
import type { Item } from '../../models'
import { ERROR_IMAGE } from '../../utils/image'
import { formatRelativeTime } from '../../utils/formatter'

const props = withDefaults(
  defineProps<{
    item: Item
    showCommunity?: boolean
  }>(),
  { showCommunity: false },
)

const emit = defineEmits<{
  (event: 'tap'): void
  (event: 'favorite'): void
}>()

const imageFailed = ref(false)
const imageSrc = computed(() => (imageFailed.value ? ERROR_IMAGE : props.item.image))
const seller = computed(() => props.item.seller ?? null)
const publishedText = computed(() => {
  if (props.item.createdAt) return formatRelativeTime(props.item.createdAt)
  return props.item.time || ''
})
const distanceShort = computed(() => String(props.item.distance || '').replace(/^约\s*/, ''))
const walkText = computed(() => {
  const text = String(props.item.walk || '')
  if (!text) return '距离很近'
  if (text.indexOf('步行') === 0) return `${text}可达`
  if (text === '自家物品') return text
  return `${text}可达`
})
const sellerLevel = computed(() => {
  if (props.item.seller?.level) return props.item.seller.level
  const deals = props.item.seller?.dealCount || 0
  return Math.min(9, Math.max(1, Math.floor(deals / 5) + 1))
})
const creditRating = computed(() => {
  const credit = String(props.item.seller?.credit || '')
  const matched = credit.match(/\d+(\.\d+)?/)
  return matched ? matched[0] : credit || '良好'
})
const isSameCommunity = computed(() => {
  const area = String(props.item.seller?.area || '')
  return area.indexOf('阳光花园') >= 0
})
const communityLabel = computed(() => {
  if (isSameCommunity.value) return '同小区'
  const community = String(props.item.community || '').trim()
  if (community) return community
  const area = String(props.item.seller?.area || '')
  const name = area.split('·')[0].trim()
  return name || '邻近小区'
})

watch(
  () => props.item.image,
  () => {
    imageFailed.value = false
  },
)

function onTap(): void {
  emit('tap')
}

function onFavorite(): void {
  emit('favorite')
}
</script>

