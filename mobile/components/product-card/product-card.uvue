  font-size: $ni-font-8;
  color: #7b9283;
}
.product-card__community-chip {
  margin-top: 7px;
  padding-top: 6px;
  border-top: 1px solid #f1efec;
}
.product-card__community-chip-text {
  font-size: $ni-font-9;
  color: #5b7c68;
}
</style>
