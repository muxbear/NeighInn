  border-top: 1px solid #e2d2c0;
}
.product-card__owner-head {
  flex-direction: row;
  align-items: center;
}
.product-card__owner-avatar {
  width: 40px;
  align-items: center;
}
.product-card__hat-wrap {
  position: relative;
  width: 40px;
  height: 23px;
  margin-bottom: 1px;
}
.product-card__hat {
  width: 40px;
  height: 23px;
}
.product-card__hat-level {
  position: absolute;
  top: 12px;
  left: 0;
  width: 40px;
  font-size: 8px;
  line-height: 9px;
  font-weight: 700;
  color: #f2c879;
  text-align: center;
}
.product-card__owner-copy {
  flex: 1;
  margin-left: 6px;
}
.product-card__owner-name-row {
  flex-direction: row;
  align-items: center;
}
.product-card__owner-name {
  flex: 1;
  font-size: $ni-font-10;
  font-weight: 700;
  color: #4e4844;
}
.product-card__badges {
  margin-top: 3px;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}
.product-card__badge {
  height: 16px;
  padding-left: 4px;
  padding-right: 4px;
  margin-right: 4px;
  border-radius: 5px;
  flex-direction: row;
