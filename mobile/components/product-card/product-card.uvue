  color: #9a702e;
}
.product-card__badge-text--owner {
  color: #397b54;
}
.product-card__owner-credit-row {
  margin-top: 4px;
  flex-direction: row;
  align-items: center;
}
.product-card__credit-label {
  font-size: $ni-font-8;
  font-weight: 700;
  color: #b27b2d;
}
.product-card__stars {
  margin-left: 2px;
  flex-direction: row;
  align-items: center;
}
.product-card__star {
  width: 10px;
  height: 10px;
  margin-right: 1px;
}
.product-card__credit-value {
  margin-left: 2px;
  font-size: $ni-font-8;
  font-weight: 700;
  color: #b27b2d;
}
.product-card__deals-row {
  margin-top: 3px;
}
.product-card__deals-text {
  font-size: $ni-font-8;
  color: #8f8782;
}
.product-card__owner-area {
  margin-top: 6px;
  flex-direction: row;
