  font-size: $ni-font-9;
  color: #7c716b;
}
.product-card__distance {
  margin-top: 7px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.product-card__distance--time-only {
  justify-content: flex-end;
}
.product-card__distance-left {
  flex-direction: row;
  align-items: center;
}
.product-card__distance-text {
  margin-left: 2px;
  font-size: $ni-font-10;
