}
.product-card__badge--realname {
  background-color: #fff5dc;
}
.product-card__badge--owner {
  background-color: $ni-color-gift-bg-2;
}
.product-card__badge-text {
  margin-left: 1px;
  font-size: 7px;
  font-weight: 700;
}
