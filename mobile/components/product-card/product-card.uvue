<template>
  <view class="product-card" hover-class="product-card--pressed" :hover-stay-time="100" @click="onTap">
    <view class="product-card__media">
      <image class="product-card__image" :src="imageSrc" mode="aspectFill" lazy-load @error="imageFailed = true" />

      <view class="product-card__fav" @click.stop="onFavorite">
        <ni-icon name="heart" :size="18" :state="item.favorite ? 'active' : 'white'" :filled="item.favorite" />
      </view>
      <view class="product-card__tag">
        <trade-tag :type="item.type" size="sm" />
      </view>
    </view>

    <view class="product-card__body">
      <text class="product-card__title" :lines="1">{{ item.title }}</text>

      <view class="product-card__price-row">
        <ni-price :value="item.price" :type="priceType" size="md" />
        <view class="product-card__condition">
          <text class="product-card__condition-text">{{ item.condition }}</text>
        </view>
      </view>

      <view
        v-if="distanceText || publishedText"
        class="product-card__distance"
        :class="{ 'product-card__distance--time-only': !distanceText }"
      >
        <view v-if="distanceText" class="product-card__distance-left">
          <ni-icon name="walk" :size="12" state="gold" />
          <text class="product-card__distance-text">{{ distanceText }}</text>
        </view>
        <text v-if="publishedText" class="product-card__time">{{ publishedText }}</text>
      </view>

      <view v-if="seller" class="product-card__owner">
        <view class="product-card__owner-head">
          <view class="product-card__owner-avatar">
            <view class="product-card__hat-wrap">
              <image class="product-card__hat" :src="hatSrc" mode="aspectFit" />
              <text class="product-card__hat-level">{{ hatLevel }}级</text>
            </view>
            <ni-avatar :src="seller.avatar" :name="seller.name" :size="27" variant="orange" />
          </view>

          <view class="product-card__owner-copy">
            <view class="product-card__owner-name-row">
              <text class="product-card__owner-name" :lines="1">{{ seller.name }}</text>
            </view>

            <view
              v-if="seller.realnameVerified || seller.ownerVerified"
              class="product-card__badges"
            >
              <view v-if="seller.realnameVerified" class="product-card__badge product-card__badge--realname">
                <ni-icon name="shield" :size="8" state="gold" />
                <text class="product-card__badge-text product-card__badge-text--realname">实名</text>
              </view>
              <view v-if="seller.ownerVerified" class="product-card__badge product-card__badge--owner">
                <ni-icon name="shield" :size="8" state="green" />
                <text class="product-card__badge-text product-card__badge-text--owner">业主</text>
              </view>
            </view>

            <view class="product-card__owner-credit-row">
              <text class="product-card__credit-label">信用</text>
              <view class="product-card__stars">
                <image
                  v-for="star in stars"
                  :key="star.key"
                  class="product-card__star"
                  :src="star.src"
                  mode="aspectFit"
                />
              </view>
              <text class="product-card__credit-value">{{ creditValueText }}</text>
            </view>

            <view class="product-card__deals-row">
              <text class="product-card__deals-text">{{ completedText }}</text>
            </view>
          </view>
        </view>
      </view>

      <view
        v-if="showCommunity && item.community && item.sameCommunity === false"
        class="product-card__community-chip"
      >
        <text class="product-card__community-chip-text">{{ item.community }}</text>
      </view>

      <view v-if="ownerArea" class="product-card__owner-area">
        <ni-icon name="pin" :size="10" state="green" />
        <text class="product-card__owner-area-text" :lines="1">{{ ownerArea }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed, ref, watch } from 'vue'
import type { Item } from '../../models'
import { ERROR_IMAGE } from '../../utils/image'
import { formatRelativeTime } from '../../utils/formatter'

const props = withDefaults(
  defineProps<{
    item: Item
    showCommunity?: boolean
  }>(),
  { showCommunity: false },
)

const emit = defineEmits<{
  (event: 'tap'): void
  (event: 'favorite'): void
}>()

const imageFailed = ref(false)
const imageSrc = computed(() => (imageFailed.value ? ERROR_IMAGE : props.item.image))
const seller = computed(() => props.item.seller ?? null)
const priceType = computed<'sale' | 'free' | 'swap'>(() => {
  if (props.item.type === '免费') return 'free'
  if (props.item.type === '互换' && Number(props.item.price) <= 0) return 'swap'
  return 'sale'
})
const publishedText = computed(() => {
  if (props.item.createdAt) return formatRelativeTime(props.item.createdAt)
  return props.item.time || ''
})
const distanceText = computed(() => {
  const distance = String(props.item.distance || '').trim()
  // 同小区物品按小区中心计算距离恒为 0m；展示“同小区”，避免出现“约0m · 1分钟”。
  if (!distance || /^约?\s*0(?:\.0+)?\s*m$/i.test(distance)) {
    return props.item.sameCommunity === false ? '' : '同小区'
  }
  const walk = String(props.item.walk || '')
    .trim()
    .replace(/^步行\s*/, '')
    .replace(/^约/, '')
    .replace(/分$/, '分钟')
  return walk ? `${distance} · ${walk}` : distance
})
const hatLevel = computed(() => {
  const level = Number(props.item.seller?.level)
  const safe = Number.isFinite(level) ? Math.round(level) : 1
  return Math.min(9, Math.max(1, safe))
})
const hatSrc = computed(() => `/static/hats/han-hat-${hatLevel.value}.svg`)
// 信用值统一折算为 5 分制；0.5 分为半颗实心星，星星与展示值均按 0.5 取整。
const credit5 = computed(() => {
  const raw = Number(props.item.seller?.creditScore)
  if (Number.isFinite(raw)) return Math.min(5, Math.max(0, raw / 20))
  const matched = String(props.item.seller?.credit || '').match(/(\d+(?:\.\d+)?)/)
  if (matched) {
    const value = Number(matched[1])
    return Math.min(5, value > 5 ? value / 20 : value)
  }
  return 5
})
const creditStars = computed(() => Math.round(credit5.value * 2) / 2)
const creditValueText = computed(() => creditStars.value.toFixed(1))
const stars = computed(() =>
  Array.from({ length: 5 }, (_, index) => {
    const remaining = creditStars.value - index
    let src = '/static/icons/icon-star-24--gold.svg'
    if (remaining >= 1) src = '/static/icons/icon-star-24-filled--gold.svg'
    else if (remaining >= 0.5) src = '/static/icons/icon-star-24-half--gold.svg'
    return { key: index, src }
  }),
)
const completedLabel = computed(() => {
  if (props.item.type === '免费') return '已送出'
  if (props.item.type === '互换') return '已互换'
  return '已卖出'
})
const completedText = computed(() => `${completedLabel.value} ${seller.value?.dealCount ?? 0} 件`)
const ownerArea = computed(() => String(seller.value?.area || '').trim())

watch(
  () => props.item.image,
  () => {
    imageFailed.value = false
  },
)

function onTap(): void {
  emit('tap')
}

function onFavorite(): void {
  emit('favorite')
}
</script>

<style scoped lang="scss">
