<template>
  <ni-sheet :visible="visible" height="84vh" @update:visible="onVisible">
    <view class="swap-picker">
      <view class="swap-picker__header">
        <view class="swap-picker__header-icon">
          <ni-icon name="swap" :size="20" state="blue" />
        </view>
        <view class="swap-picker__header-copy">
          <text class="swap-picker__title">发起物品互换</text>
          <text class="swap-picker__subtitle">选择你想用于交换的物品（可多选）</text>
        </view>
      </view>

      <view class="swap-picker__target">
        <text class="swap-picker__target-label">对方物品</text>
        <image class="swap-picker__target-image" :src="targetItem.image" mode="aspectFill" />
        <view class="swap-picker__target-copy">
          <text class="swap-picker__target-title" :lines="1">{{ targetItem.title }}</text>
          <text class="swap-picker__target-meta">{{ targetItem.condition }} · {{ targetItem.distance }}</text>
        </view>
      </view>

      <view class="swap-picker__list-head">
        <text class="swap-picker__list-title">我的在架物品</text>
        <text class="swap-picker__list-count">{{ offeredItems.length }} 件可选</text>
      </view>

      <view v-if="offeredItems.length === 0" class="swap-picker__empty">
        <ni-empty icon="box" title="你还没有在架物品" desc="先发布一件闲置，再来发起互换吧" />
      </view>

      <view
        v-for="item in offeredItems"
        :key="item.id"
        class="swap-picker__row"
        :class="{ 'swap-picker__row--selected': isSelected(item.id) }"
        @click="toggle(item.id)"
      >
        <image class="swap-picker__row-image" :src="item.image" mode="aspectFill" />
        <view class="swap-picker__row-copy">
          <text class="swap-picker__row-title" :lines="1">{{ item.title }}</text>
          <text class="swap-picker__row-meta">{{ item.condition }} · {{ item.type }}</text>
        </view>
        <view class="swap-picker__check" :class="{ 'swap-picker__check--selected': isSelected(item.id) }">
          <ni-icon v-if="isSelected(item.id)" name="check" :size="11" state="white" />
        </view>
      </view>

      <view class="swap-picker__footer">
        <ni-button type="swap" size="lg" block :disabled="selectedIds.length === 0" @tap="confirm">
          确认交换{{ selectedIds.length > 0 ? `（已选 ${selectedIds.length} 件）` : '' }}
        </ni-button>
        <text class="swap-picker__tip">互换双方物品均需通过 AI 质检，见面交割后完成</text>
      </view>
    </view>
  </ni-sheet>
</template>

<script setup lang="ts">
import { ref, watch } from 'vue'
import type { Item } from '../../models'

const props = withDefaults(
  defineProps<{
    visible: boolean
    targetItem: Item
    offeredItems: Item[]
  }>(),
  { offeredItems: () => [] },
)

const emit = defineEmits<{
  (event: 'update:visible', value: boolean): void
  (event: 'confirm', ids: string[]): void
}>()

const selectedIds = ref<string[]>([])

watch(
  () => props.visible,
  (visible) => {
    if (visible) selectedIds.value = []
  },
)

function isSelected(id: string): boolean {
  return selectedIds.value.indexOf(id) >= 0
}

function toggle(id: string): void {
  if (isSelected(id)) {
    selectedIds.value = selectedIds.value.filter((entry) => entry !== id)
  } else {
    selectedIds.value = [...selectedIds.value, id]
  }
}

function confirm(): void {
  if (!selectedIds.value.length) return
  emit('confirm', [...selectedIds.value])
  emit('update:visible', false)
}

function onVisible(value: boolean): void {
  emit('update:visible', value)
}
</script>

