<template>
  <view
    class="service-preview"
    :class="{ 'service-preview--offer': isOffer, 'service-preview--last': last }"
    hover-class="service-preview--pressed"
    :hover-stay-time="100"
    @click="onTap"
  >
    <view class="service-preview__top">
      <view class="service-preview__icon" :class="{ 'service-preview__icon--offer': isOffer }">
        <ni-icon :name="post.icon" :size="21" :state="isOffer ? 'green' : 'active'" />
      </view>
      <view class="service-preview__copy">
        <view class="service-preview__meta-row">
          <view class="service-preview__kind" :class="{ 'service-preview__kind--offer': isOffer }">
            <text class="service-preview__kind-text" :class="{ 'service-preview__kind-text--offer': isOffer }">
              {{ isOffer ? '邻里服务' : '邻里求助' }}
            </text>
          </view>
          <view class="service-preview__category">
            <text class="service-preview__category-text">{{ post.category }}</text>
          </view>
          <text
            v-if="isOffer"
            class="service-preview__price"
            :class="{ 'service-preview__price--free': (post.price || '').indexOf('免费') >= 0 }"
          >{{ post.price || post.reward }}</text>
        </view>
        <text class="service-preview__title" :lines="1">{{ post.title }}</text>
        <view class="service-preview__time-row">
          <ni-icon name="clock" :size="10" state="tertiary" />
          <text class="service-preview__time">{{ post.time }}</text>
        </view>
      </view>
    </view>

    <view class="service-preview__footer">
      <ni-avatar :src="post.avatar" :name="post.author" :size="25" :variant="isOffer ? 'green' : 'orange'" />
      <view v-if="isOffer" class="service-preview__provider">
        <view class="service-preview__provider-name-row">
          <text class="service-preview__author">{{ post.author }}</text>
          <view class="service-preview__verified">
            <ni-icon name="shield" :size="8" state="green" />
            <text class="service-preview__verified-text">业主认证</text>
          </view>
        </view>
        <text class="service-preview__provider-meta" :lines="1">
          {{ post.credit || '信用良好' }} · 服务 {{ post.serviceCount || 0 }} 次 · 评价 {{ post.rating || '4.9' }}
        </text>
      </view>
      <template v-else>
        <text class="service-preview__author-meta" :lines="1">{{ post.author }} · {{ post.distance }}</text>
        <text class="service-preview__responses">{{ post.responses }} 人响应</text>
      </template>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import type { ServicePost } from '../../models'

const props = defineProps<{ post: ServicePost; last?: boolean }>()
const emit = defineEmits<{ (event: 'tap'): void }>()

const isOffer = computed(() => props.post.kind === '提供')

function onTap(): void {
  emit('tap')
}
</script>

