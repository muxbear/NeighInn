<template>
  <view class="seller">
    <ni-avatar :src="seller.avatar" :name="seller.name" :size="44" variant="orange" />
    <view class="seller__copy">
      <view class="seller__name-row">
        <text class="seller__name">{{ seller.name }}</text>
        <ni-tag v-if="seller.verified" type="verified" size="xs">已认证</ni-tag>
      </view>
      <text class="seller__credit">{{ seller.credit }} · 已成交 {{ seller.dealCount }} 次</text>
      <text class="seller__area">{{ seller.area }} · 加入 {{ seller.joinedDays || 0 }} 天</text>
    </view>
    <view class="seller__actions">
      <view class="seller__follow" :class="{ 'seller__follow--active': following }" @click="onFollow">
        <text class="seller__follow-text" :class="{ 'seller__follow-text--active': following }">
          {{ following ? '已关注' : '关注' }}
        </text>
      </view>
      <view class="seller__chat" @click="onChat">
        <ni-icon name="message" :size="14" state="active" />
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import type { SellerSummary } from '../../models'

const props = withDefaults(
  defineProps<{
    seller: SellerSummary
    following?: boolean
  }>(),
  { following: false },
)

const emit = defineEmits<{
  (event: 'follow'): void
  (event: 'chat'): void
}>()

function onFollow(): void {
  emit('follow')
}
function onChat(): void {
  emit('chat')
}
</script>

