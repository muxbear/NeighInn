  margin-top: -25px;
  width: 49px;
  height: 49px;
  border-radius: 25px;
  background-color: rgba(25, 22, 20, 0.42);
  border: 1.5px solid rgba(255, 255, 255, 0.7);
  align-items: center;
  justify-content: center;
}
.life-card__type {
  position: absolute;
  left: 9px;
  bottom: 9px;
  flex-direction: row;
  align-items: center;
  height: 20px;
  padding-left: 6px;
  padding-right: 7px;
  border-radius: 7px;
  background-color: rgba(25, 22, 20, 0.45);
}
.life-card__type-text {
  margin-left: 3px;
  font-size: 8px;
  color: #ffffff;
}
.life-card__duration {
  position: absolute;
  right: 9px;
  bottom: 9px;
  padding-left: 6px;
  padding-right: 6px;
  height: 18px;
  border-radius: 6px;
  background-color: rgba(25, 22, 20, 0.5);
  color: #ffffff;
  font-size: 8px;
}
.life-card__body {
  padding: 12px 13px 11px;
}
.life-card__author {
  flex-direction: row;
  align-items: center;
}
