  width: calc(100% - 12px);
  height: 194px;
  margin-left: 6px;
  margin-right: 6px;
  margin-top: 6px;
  position: relative;
  border-radius: $ni-radius-12;
  overflow: hidden;
  background-color: #e9e5e2;
}
.life-card__cover {
  width: 100%;
  height: 100%;
}
.life-card__video-cover {
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  background-image: linear-gradient(135deg, #5c4a43 0%, #2f2825 100%);
}
.life-card__video-cover-text {
  margin-top: 7px;
  font-size: $ni-font-10;
  color: rgba(255, 255, 255, 0.82);
}
.life-card__gallery {
  width: 100%;
  height: 100%;
  flex-direction: row;
}
