}
.life-card__author-name {
  font-size: $ni-font-10;
  font-weight: 600;
  color: $ni-color-text-primary;
  margin-right: 3px;
}
.life-card__verified {
  margin-left: 2px;
  font-size: 6px;
  color: $ni-color-credit-deep;
}
.life-card__meta {
  margin-top: 2px;
  font-size: 7px;
  color: $ni-color-text-tertiary;
}
.life-card__category {
  height: 17px;
  padding-left: 6px;
  padding-right: 6px;
  border-radius: 5px;
  background-color: $ni-color-fill-2;
  align-items: center;
  justify-content: center;
}
.life-card__category-text {
  font-size: 7px;
  color: $ni-color-text-secondary;
}
.life-card__title {
  margin-top: 8px;
  font-size: $ni-font-14;
  line-height: 20px;
  font-weight: 700;
  color: $ni-color-text-primary;
}
.life-card__desc {
  margin-top: 4px;
  font-size: $ni-font-9;
  line-height: 15px;
  color: #817872;
}
.life-card__actions {
  flex-direction: row;
  align-items: center;
  min-height: 32px;
  padding-top: 8px;
