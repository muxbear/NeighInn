<template>
  <view class="life-card" hover-class="life-card--pressed" :hover-stay-time="100" @click="onOpen">
    <view class="life-card__media">
      <view v-if="post.type === 'gallery' && post.images.length > 1" class="life-card__gallery">
        <image class="life-card__gallery-image" :src="imageSrc(post.images[0])" mode="aspectFill" lazy-load @error="markFailed(post.images[0])" />
        <image class="life-card__gallery-image life-card__gallery-image--right" :src="imageSrc(post.images[1])" mode="aspectFill" lazy-load @error="markFailed(post.images[1])" />
      </view>
      <image v-else-if="post.type !== 'video'" class="life-card__cover" :src="imageSrc(post.cover || post.images[0])" mode="aspectFill" lazy-load @error="markFailed(post.cover || post.images[0])" />
      <view v-else class="life-card__video-cover">
        <ni-icon name="play" :size="30" state="white" :filled="true" />
        <text class="life-card__video-cover-text">短视频</text>
      </view>

      <view v-if="post.type === 'video'" class="life-card__play">
        <ni-icon name="play" :size="20" state="white" :filled="true" />
      </view>
      <view class="life-card__type">
        <ni-icon :name="post.type === 'video' ? 'play' : 'image'" :size="10" state="white" />
        <text class="life-card__type-text">{{ post.type === 'video' ? '视频' : post.images.length + ' 张照片' }}</text>
      </view>
      <text v-if="post.type === 'video' && post.duration" class="life-card__duration">{{ post.duration }}</text>
    </view>

    <view class="life-card__body">
      <view class="life-card__author">
        <ni-avatar :src="post.avatar" :name="post.author" :size="34" :variant="avatarVariant" />
        <view class="life-card__author-copy">
          <view class="life-card__author-row">
            <text class="life-card__author-name">{{ post.author }}</text>
            <ni-icon name="shield" :size="8" state="gold" />
            <text class="life-card__verified">认证业主</text>
          </view>
          <text class="life-card__meta">{{ post.area }} · {{ post.time }}</text>
        </view>
        <view class="life-card__category">
          <text class="life-card__category-text">{{ post.category }}</text>
        </view>
      </view>

      <text class="life-card__title" :lines="2">{{ post.title }}</text>
      <text class="life-card__desc" :lines="2">{{ post.description }}</text>

      <view class="life-card__actions">
        <view class="life-card__action">
          <ni-icon name="eye" :size="13" state="tertiary" />
          <text class="life-card__action-text">{{ formatCount(post.views) }}</text>
        </view>
        <view class="life-card__action" @click.stop="onLike">
          <ni-icon name="heart" :size="13" :state="post.liked ? 'active' : 'tertiary'" :filled="post.liked" />
          <text class="life-card__action-text" :class="{ 'life-card__action-text--active': post.liked }">
            {{ formatCount(post.likes) }}
          </text>
        </view>
        <view class="life-card__action" @click.stop="onComment">
          <ni-icon name="message" :size="13" state="tertiary" />
          <text class="life-card__action-text">{{ formatCount(post.comments) }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import type { LifePost } from '../../models'
import { formatCount } from '../../utils/formatter'
import { ERROR_IMAGE } from '../../utils/image'

const failedImages = ref<string[]>([])

function imageSrc(url: string): string {
  return failedImages.value.indexOf(url) >= 0 ? ERROR_IMAGE : url
}

function markFailed(url: string): void {
  if (failedImages.value.indexOf(url) < 0) {
    failedImages.value = [...failedImages.value, url]
  }
}

const props = defineProps<{ post: LifePost }>()
const emit = defineEmits<{
  (event: 'open'): void
  (event: 'like'): void
  (event: 'comment'): void
}>()

const avatarVariant = computed(() => {
  const value = props.post.avatarClass
  if (value === 'green' || value === 'blue') return value
  return 'orange'
})

function onOpen(): void {
  emit('open')
}
function onLike(): void {
  emit('like')
}
function onComment(): void {
  emit('comment')
}
</script>

<style scoped lang="scss">
