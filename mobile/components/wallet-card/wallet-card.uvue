<template>
  <view class="wallet" @click="onOpen">
    <view class="wallet__icon">
      <ni-icon name="wallet" :size="20" state="active" />
    </view>
    <view class="wallet__copy">
      <text class="wallet__label">我的钱包</text>
      <view class="wallet__amount-row">
        <text class="wallet__symbol">¥</text>
        <text class="wallet__amount">{{ balanceText }}</text>
        <text class="wallet__escrow">担保中 ¥{{ escrowText }}</text>
      </view>
    </view>
    <text class="wallet__action">查看</text>
    <ni-icon name="chevron" :size="14" state="tertiary" />
  </view>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import { formatAmount } from '../../utils/formatter'

const props = withDefaults(
  defineProps<{
    balance: number
    escrow?: number
  }>(),
  { escrow: 0 },
)

const balanceText = computed(() => formatAmount(props.balance))
const escrowText = computed(() => formatAmount(props.escrow))

const emit = defineEmits<{ (event: 'open'): void }>()

function onOpen(): void {
  emit('open')
}
</script>

