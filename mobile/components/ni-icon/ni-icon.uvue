<template>
  <image
    class="ni-icon"
    :src="src"
    mode="aspectFit"
    :style="{ width: size + 'px', height: size + 'px', transform: rotate ? 'rotate(' + rotate + 'deg)' : '' }"
  />
</template>

<script setup lang="ts">
import { computed } from 'vue'

const props = withDefaults(
  defineProps<{
    name: string
    size?: number
    state?: string
    filled?: boolean
    rotate?: number
  }>(),
  {
    size: 22,
    state: 'default',
    filled: false,
    rotate: 0,
  },
)

const STATES = [
  'default',
  'active',
  'white',
  'dark',
  'secondary',
  'tertiary',
  'green',
  'blue',
  'gold',
  'danger',
  'wechat',
]

const ALIAS: Record<string, string> = {
  primary: 'active',
  muted: 'default',
  success: 'green',
  info: 'blue',
  warning: 'gold',
  error: 'danger',
}

const src = computed(() => {
  const resolved = ALIAS[props.state] ?? props.state
  const state = STATES.indexOf(resolved) >= 0 ? resolved : 'default'
  if (props.filled) {
    return `/static/icons/icon-${props.name}-24-filled--${state}.svg`
  }
  return `/static/icons/icon-${props.name}-24--${state}.svg`
})
</script>

<style scoped lang="scss">
.ni-icon {
  flex-shrink: 0;
}
</style>
