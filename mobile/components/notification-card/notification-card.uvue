  flex-direction: row;
  align-items: flex-start;
  min-height: 125px;
  padding: 13px;
  border-radius: $ni-radius-17;
  background-color: $ni-color-white;
  border: $ni-border-card;
  box-shadow: $ni-shadow-card;
  margin-bottom: 10px;
  transition: transform 100ms ease-out;
}
.notification--pressed {
  transform: scale(0.99);
}
.notification--unread {
  border-color: #ffe2d2;
}
.notification__icon {
  width: 40px;
  height: 40px;
  border-radius: 13px;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
}
.notification__icon--交易 {
  background-color: #fff0e7;
}
.notification__icon--互动 {
  background-color: $ni-color-success-bg;
}
.notification__icon--社区 {
  background-color: $ni-color-swap-bg;
}
.notification__body {
  flex: 1;
}
.notification__top {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.notification__top-left {
  flex-direction: row;
  align-items: center;
}
.notification__tag {
  font-size: 7px;
  font-weight: 600;
  color: $ni-color-primary-dark;
  background-color: $ni-color-primary-bg;
  padding-left: 5px;
  padding-right: 5px;
  height: 16px;
  border-radius: 5px;
}
.notification__time {
  margin-left: 6px;
  font-size: 7px;
  color: $ni-color-text-tertiary;
}
.notification__dot {
  width: 7px;
  height: 7px;
  border-radius: 4px;
  background-color: $ni-color-primary;
}
.notification__title {
  margin-top: 5px;
  font-size: $ni-font-11;
  line-height: 16px;
  font-weight: 700;
  color: $ni-color-text-primary;
}
.notification__desc {
  margin-top: 3px;
  font-size: $ni-font-8;
  line-height: 13px;
  color: $ni-color-text-secondary;
}
.notification__action {
  flex-direction: row;
  align-items: center;
  margin-top: 6px;
}
.notification__action-text {
  font-size: $ni-font-8;
  color: $ni-color-primary-dark;
  margin-right: 2px;
}
</style>
