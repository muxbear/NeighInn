<template>
  <view
    class="notification"
    :class="{ 'notification--unread': !notification.read }"
    hover-class="notification--pressed"
    :hover-stay-time="100"
    @click="onTap"
  >
    <view class="notification__icon" :class="`notification__icon--${notification.category}`">
      <ni-icon :name="notification.icon" :size="19" :state="iconState" />
    </view>
    <view class="notification__body">
      <view class="notification__top">
        <view class="notification__top-left">
          <text class="notification__tag">{{ notification.tag }}</text>
          <text class="notification__time">{{ notification.time }}</text>
        </view>
        <view v-if="!notification.read" class="notification__dot" />
      </view>
      <text class="notification__title" :lines="1">{{ notification.title }}</text>
      <text class="notification__desc" :lines="2">{{ notification.description }}</text>
      <view class="notification__action">
        <text class="notification__action-text">查看详情</text>
        <ni-icon name="chevron" :size="10" state="active" />
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import type { AppNotification } from '../../models'

const props = defineProps<{ notification: AppNotification }>()
const emit = defineEmits<{ (event: 'tap'): void }>()

const iconState = computed(() => {
  if (props.notification.category === '交易') return 'active'
  if (props.notification.category === '互动') return 'green'
  return 'blue'
})

function onTap(): void {
  emit('tap')
}
</script>

<style scoped lang="scss">
