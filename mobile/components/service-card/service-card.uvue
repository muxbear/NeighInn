<template>
  <view
    class="service-card"
    :class="{ 'service-card--offer': isOffer, 'service-card--fluid': fluid }"
    hover-class="service-card--pressed"
    :hover-stay-time="100"
    @click="onTap"
  >
    <view class="service-card__top">
      <view class="service-card__icon" :class="{ 'service-card__icon--offer': isOffer }">
        <ni-icon :name="post.icon" :size="22" :state="isOffer ? 'green' : 'active'" />
      </view>
      <view class="service-card__title-wrap">
        <view class="service-card__badges">
          <view class="service-card__kind" :class="{ 'service-card__kind--offer': isOffer }">
            <text class="service-card__kind-text" :class="{ 'service-card__kind-text--offer': isOffer }">
              {{ isOffer ? '邻里服务' : '邻里求助' }}
            </text>
          </view>
          <view class="service-card__category">
            <text class="service-card__category-text">{{ post.category }}</text>
          </view>
        </view>
        <text class="service-card__title" :lines="2">{{ post.title }}</text>
      </view>
    </view>

    <text class="service-card__desc" :lines="2">{{ post.description }}</text>

    <view class="service-card__meta-panel">
      <view class="service-card__meta-row">
        <ni-icon name="clock" :size="14" state="tertiary" />
        <text class="service-card__meta-text" :lines="1">{{ post.time }}</text>
      </view>
      <view class="service-card__meta-row">
        <ni-icon name="pin" :size="14" state="tertiary" />
        <text class="service-card__meta-text" :lines="1">{{ post.place }}</text>
      </view>
    </view>

    <view class="service-card__bottom">
      <ni-avatar :src="post.avatar" :name="post.author" :size="35" :variant="isOffer ? 'green' : 'orange'" />
      <view class="service-card__author">
        <view class="service-card__author-name-row">
          <text class="service-card__author-name">{{ post.author }}</text>
          <view class="service-card__author-verified">
            <ni-icon name="shield" :size="8" state="gold" />
            <text class="service-card__author-verified-text">已认证</text>
          </view>
        </view>
        <text class="service-card__author-meta" :lines="1">{{ authorMeta }}</text>
      </view>
      <view class="service-card__response">
        <text class="service-card__price">{{ priceText }}</text>
        <view class="service-card__button" :class="{ 'service-card__button--offer': isOffer }" @click.stop="onRespond">
          <text class="service-card__button-text">{{ isOffer ? '咨询服务' : '我来帮忙' }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import type { ServicePost } from '../../models'

const props = withDefaults(
  defineProps<{
    post: ServicePost
    fluid?: boolean
  }>(),
  { fluid: false },
)

const emit = defineEmits<{
  (event: 'tap'): void
  (event: 'respond'): void
}>()

const isOffer = computed(() => props.post.kind === '提供')
const priceText = computed(() => props.post.price || props.post.reward)
const authorMeta = computed(() => {
  if (isOffer.value) {
    return `${props.post.credit || '信用良好'} · 服务 ${props.post.serviceCount || 0} 次 · 评价 ${props.post.rating || '4.9'}`
  }
  return `${props.post.distance} · ${props.post.responses} 位邻居已响应`
})

function onTap(): void {
  emit('tap')
}
function onRespond(): void {
  emit('respond')
}
</script>

