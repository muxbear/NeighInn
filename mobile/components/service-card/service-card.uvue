}
.service-card__bottom {
  margin-top: 12px;
  padding-top: 11px;
  flex-direction: row;
  align-items: center;
  border-top: 1px solid #f0edea;
}
.service-card__author {
  flex: 1;
  margin-left: 8px;
}
.service-card__author-name-row {
  flex-direction: row;
  align-items: center;
}
.service-card__author-name {
  font-size: $ni-font-10;
  font-weight: 600;
  color: $ni-color-text-primary;
  margin-right: 4px;
}
.service-card__author-verified {
  flex-direction: row;
  align-items: center;
  height: 16px;
  padding-left: 4px;
  padding-right: 4px;
  border-radius: 4px;
  background-color: $ni-color-credit-bg-2;
}
.service-card__author-verified-text {
  margin-left: 2px;
