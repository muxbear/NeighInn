  padding-left: 6px;
  padding-right: 6px;
  margin-left: 5px;
  border-radius: 5px;
  background-color: #f4f1ef;
  align-items: center;
  justify-content: center;
}
.service-card__category-text {
  font-size: $ni-font-8;
  color: #8d827b;
}
.service-card__title {
  margin-top: 6px;
  font-size: $ni-font-15;
  line-height: 20px;
  font-weight: 700;
  color: $ni-color-text-primary;
}
.service-card__desc {
  margin-top: 11px;
  margin-bottom: 11px;
  font-size: $ni-font-11;
  line-height: 18px;
  color: #66605c;
}
.service-card__meta-panel {
  padding: 9px 10px;
  border-radius: $ni-radius-10;
  background-color: #f8f6f4;
}
.service-card__meta-row {
  flex-direction: row;
