  margin-top: 2px;
  font-size: $ni-font-8;
  color: #6f8c7d;
}
.detail__comments-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}
.detail__comments-title-row {
  flex-direction: row;
  align-items: center;
}
.detail__comments-count {
  margin-left: 5px;
  font-size: $ni-font-11;
  color: $ni-color-text-tertiary;
}
.detail__comments-more {
  font-size: $ni-font-10;
  color: $ni-color-text-tertiary;
}
.detail__comments-empty {
  padding-top: 10px;
  padding-bottom: 10px;
}
.detail__comments-empty-text {
  font-size: $ni-font-11;
  color: $ni-color-text-tertiary;
}
.detail__comment-entry {
  margin-top: 10px;
  height: 42px;
  flex-direction: row;
  align-items: center;
  padding-left: 12px;
  border-radius: $ni-radius-12;
  background-color: #f6f3f1;
}
.detail__comment-entry-text {
  margin-left: 6px;
  font-size: $ni-font-11;
  color: $ni-color-text-placeholder;
}
.detail__bottom-space {
  height: calc(86px + env(safe-area-inset-bottom));
}
.detail__bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
