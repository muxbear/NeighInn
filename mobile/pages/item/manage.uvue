  margin-top: 5px;
}
.manage__item-price {
  font-size: $ni-font-13;
  font-weight: 700;
  color: $ni-color-primary-dark;
}
.manage__item-free {
  font-size: $ni-font-10;
  font-weight: 600;
  color: $ni-color-gift;
}
