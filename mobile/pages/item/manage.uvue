  background-color: $ni-color-white;
  border-radius: $ni-radius-16;
}
.manage__item {
  margin-bottom: 10px;
  padding: 12px;
  border-radius: $ni-radius-16;
  background-color: $ni-color-white;
  box-shadow: $ni-shadow-card;
}
.manage__item-top {
  flex-direction: row;
  align-items: flex-start;
}
.manage__item-image-wrap {
  width: 72px;
  height: 72px;
  border-radius: 12px;
  overflow: hidden;
  background-color: #f3ede7;
}
.manage__item-image {
  width: 72px;
  height: 72px;
}
