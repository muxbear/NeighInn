  margin-top: 4px;
}
.manage__item-condition {
  margin-left: 5px;
  font-size: 7px;
  color: $ni-color-text-tertiary;
}
.manage__item-price-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 5px;
}
.manage__item-price {
  font-size: $ni-font-13;
