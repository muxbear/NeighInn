}
.manage__item {
  margin-bottom: 10px;
  padding: 12px;
  border-radius: $ni-radius-16;
  background-color: $ni-color-white;
  box-shadow: $ni-shadow-card;
}
.manage__item-top {
  flex-direction: row;
  align-items: flex-start;
}
.manage__item-image {
  width: 72px;
