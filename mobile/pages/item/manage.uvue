  margin-top: 10px;
  padding-top: 9px;
  border-top: $ni-border-divider;
}
.manage__action {
  height: 28px;
  padding-left: 11px;
  padding-right: 11px;
  border-radius: 9px;
  background-color: $ni-color-fill-1;
