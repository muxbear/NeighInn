<template>
  <scroll-view class="home" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="home__header">
      <ni-status-bar />
      <image class="home__decor" src="/static/placeholders/glow-header.svg" mode="scaleToFill" />

      <view class="home__community" @click="goCommunity">
        <view class="home__community-icon">
          <ni-icon name="home" :size="20" state="active" />
        </view>
        <view class="home__community-copy">
          <view class="home__community-name-row">
            <text class="home__community-name">{{ communityName }}</text>
            <view class="home__verified-pill">
              <ni-icon name="shield" :size="9" state="green" />
              <text class="home__verified-text">{{ formatThousands(community.verifiedCount) }} 已认证</text>
            </view>
          </view>
          <text class="home__community-sub">{{ community.building }} · 仅限本小区发布与交易</text>
        </view>
        <view class="home__community-actions">
          <view class="home__header-button" @click.stop="goSearch">
            <ni-icon name="search" :size="20" state="secondary" />
          </view>
          <view class="home__header-button" @click.stop="goNotifications">
            <ni-icon name="bell" :size="20" state="secondary" />
            <view v-if="notificationStore.unread > 0" class="home__bell-badge">
              <text class="home__bell-badge-text">{{ notificationStore.unread > 9 ? '9+' : notificationStore.unread }}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="home__search">
        <ni-search-bar
          v-model="homeKeyword"
          placeholder="搜索小区好物、互助服务"
          show-filter
          @confirm="searchFromHome"
          @filter="goSearch"
        />
      </view>
    </view>

    <certification-guide-card
      v-if="showCertificationGuide"
      :realname-status="userStore.realnameStatus"
      :owner-status="userStore.ownerStatus"
      :auth-status="userStore.profile?.authStatus || 'LOGGED_IN_UNVERIFIED'"
      @open="goCertificationCenter"
      @dismiss="dismissCertificationGuide"
    />

    <view v-if="!itemStore.homeFeed && itemStore.homeLoading" class="home__skeleton">
      <ni-skeleton :rows="4" :avatar="true" />
      <ni-skeleton :rows="3" :avatar="false" />
    </view>

    <view v-else-if="!itemStore.homeFeed && itemStore.homeError" class="home__error">
      <ni-empty
        icon="alert"
        title="首页加载失败"
        :desc="itemStore.homeError"
        action-text="重新加载"
        @action="reload"
      />
    </view>

    <template v-else-if="itemStore.homeFeed">
      <view class="home__zones">
        <view class="home__zones-head">
          <view class="home__zones-copy">
            <text class="home__zones-title">今天想去哪里？</text>
          </view>
          <text class="home__zones-count">{{ community.itemCount }}件 · {{ community.serviceCount }}服务</text>
        </view>
        <view class="home__zone-grid">
          <zone-card
            v-for="(zone, index) in zoneCards"
            :key="zone.key"
            :name="zone.name"
            :label="zone.label"
            :icon="zone.icon"
            :tone="zone.tone"
            :count="zone.count"
            :is-last="index === zoneCards.length - 1"
            @tap="goZone(zone.key)"
          />
        </view>
      </view>

      <view class="home__broadcast">
        <view class="home__broadcast-head">
          <view class="home__broadcast-title-row">
            <view class="home__broadcast-icon">
              <ni-icon name="megaphone" :size="15" state="active" />
            </view>
            <view class="home__broadcast-copy">
              <text class="home__broadcast-title">小区喇叭站</text>
              <text class="home__broadcast-sub">邻里公告 · 实时更新</text>
            </view>
          </view>
          <view class="home__live">
            <view class="home__live-dot" />
            <text class="home__live-text">实时播报</text>
          </view>
        </view>

        <swiper
          class="home__swiper"
          :circular="true"
          :autoplay="true"
          :interval="4200"
          :duration="350"
          :current="broadcastIndex"
          @change="onBroadcastChange"
        >
          <swiper-item v-for="(broadcast, index) in broadcasts" :key="broadcast.id">
            <broadcast-card
              :broadcast="broadcast"
              :total="broadcasts.length"
              :current-index="broadcastIndex"
              @tap="goBroadcast(broadcast.id)"
              @action="goBroadcast(broadcast.id)"
              @dot="broadcastIndex = $event"
            />
          </swiper-item>
        </swiper>
      </view>

      <view class="home__hot">
        <ni-section-header
          kicker="邻居们都在看"
          title="小区拾物"
          action-text="查看更多"
          @action="goZone('sale')"
        />
        <view class="home__product-grid">
          <view
            v-for="(item, index) in hotItems"
            :key="item.id"
            class="home__product-cell"
            :class="{ 'home__product-cell--gap': index % 2 === 0 }"
          >
            <product-card
              :item="item"
              @tap="goItem(item.id)"
              @favorite="onFavorite(item)"
            />
          </view>
        </view>
        <view v-if="hotItems.length === 0" class="home__section-empty">
          <ni-empty icon="box" title="还没有商品" desc="去发布一件闲置，让邻居们看到吧" />
        </view>
      </view>

      <view class="home__service">
        <view class="home__service-head">
          <ni-section-header
            kicker="身边有人需要你"
            title="邻里互助"
            action-text="进入邻里互助"
            @action="goZone('service')"
          />
        </view>
        <view class="home__service-tabbar">
          <view class="home__service-tabs">
            <view
              class="home__service-tab"
              :class="{ 'home__service-tab--active': serviceKind === '求助' }"
              @click="serviceKind = '求助'"
            >
              <view class="home__service-dot home__service-dot--need" />
              <text class="home__service-tab-text" :class="{ 'home__service-tab-text--active': serviceKind === '求助' }">邻里求助</text>
            </view>
            <view
              class="home__service-tab home__service-tab--last"
              :class="{ 'home__service-tab--active': serviceKind === '提供' }"
              @click="serviceKind = '提供'"
            >
              <view class="home__service-dot home__service-dot--offer" />
              <text class="home__service-tab-text" :class="{ 'home__service-tab-text--active': serviceKind === '提供' }">邻里服务</text>
            </view>
          </view>
        </view>
        <view class="home__service-list">
          <service-preview-card
            v-for="post in currentServices"
            :key="post.id"
            :post="post"
            @tap="goZone('service')"
          />
          <view v-if="currentServices.length === 0" class="home__service-empty">
            <ni-empty icon="friend" title="暂时没有互助信息" desc="邻里之间，互相搭把手" />
          </view>
        </view>
      </view>

      <view class="home__life">
        <ni-section-header
          kicker="记录身边真实生活"
          title="小区生活"
          action-text="查看全部"
          size="lg"
          @action="goLife"
        />
        <view class="home__life-sub">
          <text class="home__life-sub-text">小区风景、邻里日常，看看邻居们正在分享什么</text>
          <text class="home__life-sort">最新发布</text>
        </view>
        <scroll-view class="home__life-tabs-scroll" scroll-x :show-scrollbar="false">
          <view class="home__life-tabs">
            <view
              v-for="category in lifeCategories"
              :key="category"
              class="home__life-tab"
              :class="{ 'home__life-tab--active': lifeCategory === category }"
              @click="lifeCategory = category"
            >
              <text class="home__life-tab-text" :class="{ 'home__life-tab-text--active': lifeCategory === category }">
                {{ category }}
              </text>
            </view>
          </view>
        </scroll-view>

        <view class="home__life-list">
          <life-post-card
            v-for="post in filteredLifePosts"
            :key="post.id"
            :post="post"
            @open="goLifeDetail(post.id)"
            @like="onLifeLike(post)"
            @comment="goLifeDetail(post.id)"
          />
        </view>
        <view v-if="filteredLifePosts.length === 0" class="home__section-empty">
          <ni-empty icon="image" title="这个分类还没有动态" desc="去小区生活看看邻居们的最新记录" />
        </view>

        <view class="home__life-more" hover-class="home__life-more--pressed" @click="goLife">
          <text class="home__life-more-text">查看更多生活动态</text>
          <ni-icon name="chevron" :size="13" state="tertiary" />
        </view>
      </view>
    </template>

    <view class="home__bottom-space" />
    <ni-tab-bar active="home" :unread="socialStore.unreadTotal" />
    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="92" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad, onPullDownRefresh, onShow } from '@dcloudio/uni-app'
import { useItemStore } from '../../stores/item.store'
import { useNotificationStore } from '../../stores/notification.store'
import { useSocialStore } from '../../stores/social.store'
import { useCommunityStore } from '../../stores/community.store'
import { useUserStore } from '../../stores/user.store'
import { useToast } from '../../composables/useToast'
import { STORAGE_KEYS, ZONE_MAP } from '../../config/constants'
import { getStorage, setStorage } from '../../utils/storage'
import { formatThousands } from '../../utils/formatter'
import { lifeService } from '../../services/life.service'

const itemStore = useItemStore()
const notificationStore = useNotificationStore()
const socialStore = useSocialStore()
const communityStore = useCommunityStore()
const userStore = useUserStore()
const { toast, showToast } = useToast()

const serviceKind = ref<'求助' | '提供'>('求助')
const lifeCategory = ref('全部')
const lifeCategories = ['全部', '小区风景', '邻里日常', '个人风采']
const broadcastIndex = ref(0)
const homeKeyword = ref('')
const certGuideDismissedAt = ref(Number(getStorage<number>(STORAGE_KEYS.certGuideDismissedAt, 0) || 0))
const SEVEN_DAYS = 7 * 24 * 60 * 60 * 1000

const showCertificationGuide = computed(() => {
  if (!userStore.isLoggedIn || userStore.isVerifiedOwner) return false
  return Date.now() - certGuideDismissedAt.value > SEVEN_DAYS
})

const community = computed(() => {
  if (itemStore.homeFeed) return itemStore.homeFeed.community
  return communityStore.current
    ? {
        id: communityStore.current.id,
        name: communityStore.current.name,
        building: communityStore.current.building ?? '3号楼',
        verifiedCount: communityStore.current.memberCount,
        itemCount: communityStore.current.itemCount,
        serviceCount: communityStore.current.helpCount,
      }
    : { id: 'c1', name: '阳光花园小区', building: '3号楼', verifiedCount: 2138, itemCount: 126, serviceCount: 24 }
})

const communityName = computed(() => community.value.name)
const zoneCards = computed(() =>
  (itemStore.homeFeed?.zones ?? []).map((zone) => {
    const config = ZONE_MAP[zone.key]
    return {
      key: zone.key,
      name: config?.name ?? zone.name,
      label: config?.label ?? '',
      icon: config?.icon ?? 'box',
      tone: config?.tone ?? 'gift',
      count: zone.count,
    }
  }),
)
const broadcasts = computed(() => itemStore.homeFeed?.broadcasts ?? [])
const keywordText = computed(() => homeKeyword.value.trim().toLowerCase())
function matchesKeyword(text: string): boolean {
  if (!keywordText.value) return true
  return text.toLowerCase().indexOf(keywordText.value) >= 0
}
const hotItems = computed(() =>
  (itemStore.homeFeed?.hotItems ?? []).filter((item) =>
    matchesKeyword(`${item.title} ${item.description ?? ''}`),
  ),
)
const currentServices = computed(() => {
  if (!itemStore.homeFeed) return []
  const list = serviceKind.value === '求助' ? itemStore.homeFeed.serviceHelp : itemStore.homeFeed.serviceOffer
  return list.filter((post) =>
    matchesKeyword(`${post.title} ${post.description} ${post.category}`),
  )
})
const filteredLifePosts = computed(() => {
  const posts = itemStore.homeFeed?.lifePosts ?? []
  const byCategory =
    lifeCategory.value === '全部'
      ? posts
      : posts.filter((post) => post.category === lifeCategory.value)
  return byCategory.filter((post) => matchesKeyword(`${post.title} ${post.description}`))
})

onLoad(() => {
  loadData()
})

onShow(() => {
  if (typeof uni !== 'undefined') uni.hideTabBar({ animation: false })
  certGuideDismissedAt.value = Number(getStorage<number>(STORAGE_KEYS.certGuideDismissedAt, 0) || 0)
  socialStore.fetchConversations().catch(() => undefined)
  notificationStore.fetchUnread().catch(() => undefined)
  userStore.refreshProfile().catch(() => undefined)
  // 已有缓存时后台静默刷新：审核通过/新发布的物品回到首页即可见，无需等待缓存过期或手动下拉。
  if (itemStore.homeFeed) itemStore.fetchHome(true).catch(() => undefined)
})

onPullDownRefresh(async () => {
  try {
    await loadData(true)
  } finally {
    uni.stopPullDownRefresh()
  }
})

async function loadData(force = false): Promise<void> {
  const tasks: Array<Promise<any>> = [
    itemStore.fetchHome(force),
    socialStore.fetchConversations(),
    notificationStore.fetchUnread(),
  ]
  if (!communityStore.bindings.length) tasks.push(communityStore.fetchMine())
  try {
    await Promise.all(tasks)
  } catch (error) {
    if (!itemStore.homeFeed) {
      showToast(error instanceof Error ? error.message : '首页加载失败', 'alert')
    }
  }
}

async function reload(): Promise<void> {
  await loadData(true)
}

function onBroadcastChange(event: any): void {
  broadcastIndex.value = event?.detail?.current ?? 0
}

function goCommunity(): void {
  uni.navigateTo({ url: '/pages/community/index' })
}

function goCertificationCenter(): void {
  uni.navigateTo({ url: '/pages/auth/center' })
}

function dismissCertificationGuide(): void {
  certGuideDismissedAt.value = Date.now()
  setStorage(STORAGE_KEYS.certGuideDismissedAt, certGuideDismissedAt.value)
}
function goSearch(): void {
  uni.navigateTo({ url: '/pages/home/search' })
}
function searchFromHome(keyword: string): void {
  const value = String(keyword || '').trim()
  if (!value) {
    goSearch()
    return
  }
  uni.navigateTo({ url: `/pages/home/search?keyword=${encodeURIComponent(value)}` })
}
function goNotifications(): void {
  uni.navigateTo({ url: '/pages/notifications/index' })
}
function goZone(zone: string): void {
  uni.navigateTo({ url: `/pages/zone/index?zone=${zone}` })
}
function goItem(id: string): void {
  uni.navigateTo({ url: `/pages/item/detail?id=${id}` })
}
function goBroadcast(id: string): void {
  uni.navigateTo({ url: `/pages/broadcast/detail?id=${id}` })
}
function goLife(): void {
  uni.navigateTo({ url: '/pages/life/index' })
}
function goLifeDetail(id: string): void {
  uni.navigateTo({ url: `/pages/life/detail?id=${id}` })
}

async function onFavorite(item: any): Promise<void> {
  try {
    await itemStore.toggleFavorite(item)
    showToast(item.favorite ? '已收藏' : '已取消收藏')
  } catch (error) {
    showToast(error instanceof Error ? error.message : '操作失败', 'alert')
  }
}

async function onLifeLike(post: any): Promise<void> {
  const previous = Boolean(post.liked)
  const next = !previous
  post.liked = next
  post.likes = Math.max(0, post.likes + (next ? 1 : -1))
  try {
    const result = await lifeService.toggleLike(post.id)
    post.liked = result.liked
    post.likes = result.likes
  } catch (error) {
    post.liked = previous
    post.likes = Math.max(0, post.likes + (previous ? 1 : -1))
    showToast('点赞失败，请重试', 'alert')
  }
}

</script>

