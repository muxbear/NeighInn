<template>
  <scroll-view class="life" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="life__header">
      <ni-status-bar />
      <view class="life__glow" />
      <view class="life__nav">
        <view class="life__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <text class="life__nav-title">小区生活</text>
        <view class="life__nav-button" @click="goSearch">
          <ni-icon name="search" :size="18" state="secondary" />
        </view>
      </view>

      <view class="life__intro">
        <view class="life__intro-icon">
          <ni-icon name="image" :size="24" state="white" />
        </view>
        <view class="life__intro-copy">
          <text class="life__intro-kicker">记录身边真实生活</text>
          <text class="life__intro-title">小区里的每一天</text>
          <text class="life__intro-desc">小区风景、邻里日常、个人风采、萌宠生活</text>
        </view>
      </view>
    </view>

    <view class="life__sticky" :style="{ top: statusBarHeight + 'px' }">
      <scroll-view class="life__tabs-scroll" scroll-x :show-scrollbar="false">
        <view class="life__tabs">
          <view
            v-for="category in categories"
            :key="category"
            class="life__tab"
            :class="{ 'life__tab--active': activeCategory === category }"
            @click="selectCategory(category)"
          >
            <text class="life__tab-text" :class="{ 'life__tab-text--active': activeCategory === category }">{{ category }}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="life__feed">
      <view class="life__feed-head">
        <view class="life__feed-copy">
          <text class="life__feed-title">邻居们的日常</text>
          <text class="life__feed-sub">真实的小区生活，正在被邻居们记录</text>
        </view>
        <text class="life__feed-sort">最新发布</text>
      </view>

      <view v-if="loading && lifeStore.posts.length === 0" class="life__loading">
        <ni-skeleton :rows="3" :avatar="false" />
      </view>

      <view v-else-if="lifeStore.posts.length === 0" class="life__empty">
        <ni-empty icon="image" title="这个分类还没有动态" desc="来发布第一条生活记录吧" action-text="去发布" @action="goPublish" />
      </view>

      <view v-else class="life__list">
        <life-post-card
          v-for="post in lifeStore.posts"
          :key="post.id"
          :post="post"
          @open="goDetail(post.id)"
          @like="onLike(post)"
          @comment="goDetail(post.id)"
        />
      </view>

      <view class="life__end">
        <view class="life__end-line" />
        <text class="life__end-text">生活中的美好都在这里了</text>
        <view class="life__end-line" />
      </view>
    </view>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="40" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad, onPullDownRefresh, onReachBottom } from '@dcloudio/uni-app'
import type { LifePost } from '../../models'
import { useLifeStore } from '../../stores/life.store'
import { useToast } from '../../composables/useToast'
import { useSystemMetrics } from '../../composables/useSystemMetrics'
import { LIFE_CATEGORIES } from '../../config/constants'

const lifeStore = useLifeStore()
const { toast, showToast } = useToast()
const { statusBarHeight } = useSystemMetrics()

const categories = LIFE_CATEGORIES
const activeCategory = ref('全部')
const loading = computed(() => lifeStore.loading)

onLoad(() => {
  loadPosts()
})

onPullDownRefresh(async () => {
  try {
    await lifeStore.fetchPosts(activeCategory.value, true)
  } finally {
    uni.stopPullDownRefresh()
  }
})

onReachBottom(() => {
  if (lifeStore.hasMore && !lifeStore.loading) {
    lifeStore.fetchPosts(activeCategory.value, false).catch(() => undefined)
  }
})

async function loadPosts(): Promise<void> {
  try {
    await lifeStore.fetchPosts('全部', true)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '加载失败', 'alert')
  }
}

async function selectCategory(category: string): Promise<void> {
  if (activeCategory.value === category) return
  activeCategory.value = category
  try {
    await lifeStore.fetchPosts(category, true)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '加载失败', 'alert')
  }
}

async function onLike(post: LifePost): Promise<void> {
  try {
    await lifeStore.toggleLike(post)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '点赞失败', 'alert')
  }
}

function goBack(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else uni.switchTab({ url: '/pages/home/index' })
}
function goSearch(): void {
  uni.navigateTo({ url: '/pages/home/search' })
}
function goDetail(id: string): void {
  uni.navigateTo({ url: `/pages/life/detail?id=${id}` })
}
function goPublish(): void {
  uni.navigateTo({ url: '/pages/publish/index?mode=life' })
}
</script>

