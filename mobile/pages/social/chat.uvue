  margin-left: 4px;
  font-size: 7px;
  color: $ni-color-text-tertiary;
}
.chat__status--failed {
  color: $ni-color-danger-deep;
}
.chat__scroll-space {
  height: 16px;
}
.chat__input-bar {
  padding: 8px 12px;
  padding-bottom: calc(8px + env(safe-area-inset-bottom));
  flex-direction: row;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.98);
  border-top: 1px solid #eee9e4;
}
.chat__input-wrap {
  flex: 1;
  height: 40px;
  padding-left: 13px;
  padding-right: 13px;
  border-radius: $ni-radius-13;
  background-color: #f3f0ed;
  justify-content: center;
}
.chat__input {
  width: 100%;
  height: 100%;
  font-size: $ni-font-12;
  color: $ni-color-text-primary;
}
.chat__placeholder {
  color: $ni-color-text-placeholder;
  font-size: $ni-font-12;
}
.chat__send {
  width: 58px;
  height: 38px;
  margin-left: 8px;
  border-radius: $ni-radius-12;
  background-color: #e9e3dd;
  align-items: center;
  justify-content: center;
}
.chat__send--active {
  background-image: $ni-gradient-brand;
}
.chat__send-text {
  font-size: $ni-font-11;
  font-weight: 700;
  color: #999999;
}
.chat__send-text--active {
  color: #ffffff;
}
</style>
