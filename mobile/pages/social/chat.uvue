  flex: 1;
  padding-left: 13px;
  padding-right: 13px;
}
.chat__notice {
  flex-direction: row;
  align-items: flex-start;
  padding: 9px;
  margin-top: 10px;
  border-radius: $ni-radius-10;
  background-color: #fff8e8;
}
