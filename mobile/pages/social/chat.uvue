  flex: 1;
  margin-left: 5px;
  font-size: 7px;
  line-height: 13px;
  color: #9a7c45;
}
.chat__empty {
  padding-top: 20px;
}
.chat__system {
  align-items: center;
  margin-top: 12px;
  margin-bottom: 6px;
}
.chat__system-text {
  font-size: 7px;
  color: $ni-color-text-tertiary;
  background-color: rgba(0, 0, 0, 0.05);
  padding-left: 8px;
  padding-right: 8px;
  padding-top: 3px;
  padding-bottom: 3px;
  border-radius: 8px;
}
