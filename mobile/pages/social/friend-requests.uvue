  margin-top: 4px;
  font-size: $ni-font-10;
  line-height: 16px;
  color: $ni-color-text-secondary;
}
.requests__actions {
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 9px;
}
.requests__reject {
  height: 30px;
  padding-left: 13px;
  padding-right: 13px;
  border-radius: 10px;
  border: 1px solid #e8e1db;
  align-items: center;
  justify-content: center;
  margin-right: 7px;
}
