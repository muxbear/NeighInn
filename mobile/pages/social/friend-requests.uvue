<template>
  <scroll-view class="requests" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="requests__header">
      <ni-status-bar />
      <view class="requests__nav">
        <view class="requests__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <text class="requests__nav-title">好友申请</text>
        <view class="requests__nav-placeholder" />
      </view>
    </view>

    <view class="requests__content">
      <view v-if="socialStore.requests.length === 0" class="requests__empty">
        <ni-empty icon="friend" title="没有新的好友申请" desc="同小区的邻居申请加你为好友时会出现在这里" />
      </view>

      <view v-else class="requests__list">
        <view v-for="request in socialStore.requests" :key="request.id" class="requests__card">
          <ni-avatar :src="request.avatar" :name="request.name" :size="48" variant="green" />
          <view class="requests__copy">
            <view class="requests__name-row">
              <text class="requests__name">{{ request.name }}</text>
              <text class="requests__time">{{ request.time }}</text>
            </view>
            <text class="requests__message" :lines="2">{{ request.message }}</text>
            <view v-if="request.status === 'PENDING'" class="requests__actions">
              <view class="requests__reject" @click="reject(request.id)">
                <text class="requests__reject-text">拒绝</text>
              </view>
              <view class="requests__accept" @click="accept(request.id)">
                <text class="requests__accept-text">同意</text>
              </view>
            </view>
            <text v-else class="requests__status" :class="{ 'requests__status--accepted': request.status === 'ACCEPTED' }">
              {{ request.status === 'ACCEPTED' ? '已同意' : '已拒绝' }}
            </text>
          </view>
        </view>
      </view>

      <view class="requests__tip">
        <ni-icon name="shield" :size="14" state="gold" />
        <text class="requests__tip-text">只添加认识的同小区邻居，谨防陌生人以交易名义索要个人信息。</text>
      </view>
    </view>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="40" />
  </scroll-view>
</template>

<script setup lang="ts">
import { onLoad } from '@dcloudio/uni-app'
import { useSocialStore } from '../../stores/social.store'
import { useToast } from '../../composables/useToast'

const socialStore = useSocialStore()
const { toast, showToast } = useToast()

onLoad(() => {
  socialStore.fetchRequests().catch(() => undefined)
})

async function accept(id: string): Promise<void> {
  try {
    await socialStore.acceptRequest(id)
    showToast('已添加为邻居好友')
  } catch (error) {
    showToast(error instanceof Error ? error.message : '操作失败', 'alert')
  }
}

async function reject(id: string): Promise<void> {
  try {
    await socialStore.rejectRequest(id)
    showToast('已拒绝好友申请')
  } catch (error) {
    showToast(error instanceof Error ? error.message : '操作失败', 'alert')
  }
}

function goBack(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else uni.switchTab({ url: '/pages/messages/index' })
}
</script>

<style scoped lang="scss">
