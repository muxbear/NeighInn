<template>
  <scroll-view class="friends" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="friends__header">
      <ni-status-bar />
      <view class="friends__nav">
        <view class="friends__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <text class="friends__nav-title">我的邻居</text>
        <view class="friends__nav-button" @click="goRequests">
          <ni-icon name="friend" :size="19" state="secondary" />
          <view v-if="socialStore.pendingRequestCount > 0" class="friends__request-badge">
            <ni-badge :count="socialStore.pendingRequestCount" :max="9" />
          </view>
        </view>
      </view>
    </view>

    <view class="friends__search-wrap">
      <view class="friends__search">
        <ni-icon name="search" :size="17" state="tertiary" />
        <input
          class="friends__search-input"
          :value="keyword"
          placeholder="搜索邻居昵称或小区"
          placeholder-class="friends__placeholder"
          @input="onSearch"
        />
      </view>
    </view>

    <view class="friends__requests" @click="goRequests">
      <view class="friends__requests-icon">
        <ni-icon name="friend" :size="19" state="blue" />
      </view>
      <view class="friends__requests-copy">
        <text class="friends__requests-title">好友申请</text>
        <text class="friends__requests-desc">{{ socialStore.pendingRequestCount }} 条待处理</text>
      </view>
      <ni-icon name="chevron" :size="15" state="tertiary" />
    </view>

    <view v-if="groups.length === 0" class="friends__empty">
      <ni-empty icon="friend" title="还没有邻居好友" desc="在物品详情或生活频道认识同小区的邻居吧" action-text="去首页" @action="goHome" />
    </view>

    <view v-else class="friends__list">
      <view v-for="group in groups" :key="group.letter" class="friends__group">
        <text class="friends__letter">{{ group.letter }}</text>
        <view class="friends__group-card">
          <view v-for="friend in group.friends" :key="friend.id" class="friends__row" @click="chatWith(friend.id)">
            <ni-avatar :src="friend.avatar" :name="friend.name" :size="44" variant="green" />
            <view class="friends__row-copy">
              <view class="friends__row-name">
                <text class="friends__name">{{ friend.name }}</text>
                <ni-icon v-if="friend.verified" name="shield" :size="9" state="gold" />
              </view>
              <text class="friends__community">{{ friend.community }}</text>
            </view>
            <view class="friends__row-right">
              <view v-if="friend.online" class="friends__online" />
              <ni-icon name="message" :size="17" state="tertiary" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="40" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import type { Friend } from '../../models'
import { useSocialStore } from '../../stores/social.store'
import { useToast } from '../../composables/useToast'

const socialStore = useSocialStore()
const { toast, showToast } = useToast()

const keyword = ref('')

const groups = computed(() => {
  const filtered = socialStore.friends.filter((friend) => {
    const value = keyword.value.trim()
    if (!value) return true
    return friend.name.indexOf(value) >= 0 || friend.community.indexOf(value) >= 0
  })
  const map: Record<string, Friend[]> = {}
  filtered.forEach((friend) => {
    const letter = friend.letter || '#'
    if (!map[letter]) map[letter] = []
    map[letter].push(friend)
  })
  return Object.keys(map)
    .sort()
    .map((letter) => ({ letter, friends: map[letter] }))
})

onLoad(() => {
  socialStore.fetchFriends().catch(() => undefined)
  socialStore.fetchRequests().catch(() => undefined)
})

function onSearch(event: any): void {
  keyword.value = String(event?.detail?.value ?? '')
}

async function chatWith(friendId: string): Promise<void> {
  try {
    const conversation = await socialStore.openConversation(friendId)
    uni.navigateTo({ url: `/pages/social/chat?id=${conversation.id}` })
  } catch (error) {
    showToast(error instanceof Error ? error.message : '打开会话失败', 'alert')
  }
}

function goBack(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else uni.switchTab({ url: '/pages/messages/index' })
}
function goRequests(): void {
  uni.navigateTo({ url: '/pages/social/friend-requests' })
}
function goHome(): void {
  uni.switchTab({ url: '/pages/home/index' })
}
</script>

