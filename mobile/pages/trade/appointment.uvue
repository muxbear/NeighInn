<template>
  <scroll-view class="appointment" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="appointment__header">
      <ni-status-bar />
      <view class="appointment__nav">
        <view class="appointment__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <text class="appointment__nav-title">预约见面验货</text>
        <view class="appointment__nav-placeholder" />
      </view>
    </view>

    <view class="appointment__content">
      <view v-if="order" class="appointment__order">
        <image class="appointment__order-image" :src="order.item.image" mode="aspectFill" />
        <view class="appointment__order-copy">
          <text class="appointment__order-title" :lines="1">{{ order.item.title }}</text>
          <text class="appointment__order-meta">{{ order.tradeType }} · {{ order.statusText }}</text>
        </view>
        <ni-icon name="shield" :size="18" state="green" />
      </view>

      <view class="appointment__section">
        <text class="appointment__section-title">选择见面时间</text>
        <view class="appointment__chips">
          <view
            v-for="time in timeOptions"
            :key="time"
            class="appointment__chip"
            :class="{ 'appointment__chip--active': selectedTime === time }"
            @click="selectedTime = time"
          >
            <ni-icon name="clock" :size="12" :state="selectedTime === time ? 'active' : 'tertiary'" />
            <text class="appointment__chip-text" :class="{ 'appointment__chip-text--active': selectedTime === time }">{{ time }}</text>
          </view>
        </view>
        <view class="appointment__custom" @click="chooseCustomTime">
          <ni-icon name="plus" :size="13" state="tertiary" />
          <text class="appointment__custom-text">{{ customTime || '自定义时间' }}</text>
        </view>
      </view>

      <view class="appointment__section">
        <text class="appointment__section-title">选择见面地点</text>
        <view class="appointment__places">
          <view
            v-for="place in placeOptions"
            :key="place.name"
            class="appointment__place"
            :class="{ 'appointment__place--active': selectedPlace === place.name }"
            @click="selectedPlace = place.name"
          >
            <view class="appointment__place-icon">
              <ni-icon :name="place.icon" :size="17" :state="selectedPlace === place.name ? 'active' : 'tertiary'" />
            </view>
            <view class="appointment__place-copy">
              <text class="appointment__place-name">{{ place.name }}</text>
              <text class="appointment__place-desc">{{ place.desc }}</text>
            </view>
            <view v-if="place.recommended" class="appointment__recommend">
              <text class="appointment__recommend-text">推荐</text>
            </view>
          </view>
        </view>
      </view>

      <view class="appointment__section">
        <text class="appointment__section-title">备注（选填）</text>
        <ni-textarea
          v-model="note"
          placeholder="例如：我会带一个小推车，麻烦告知具体楼栋入口"
          :maxlength="120"
          :height="70"
        />
      </view>

      <view class="appointment__tip">
        <ni-icon name="shield" :size="15" state="gold" />
        <text class="appointment__tip-text">双方可改期或取消；48 小时未响应将自动取消预约。请在小区公共区域见面。</text>
      </view>

      <ni-button type="primary" size="lg" block :loading="submitting" @tap="submit">
        确认预约
      </ni-button>
    </view>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="40" />
  </scroll-view>
</template>

<script setup lang="ts">
import { ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import type { Order } from '../../models'
import { useOrderStore } from '../../stores/order.store'
import { useToast } from '../../composables/useToast'

const orderStore = useOrderStore()
const { toast, showToast } = useToast()

const orderId = ref('')
const order = ref<Order | null>(null)
const selectedTime = ref('明天 14:00')
const customTime = ref('')
const selectedPlace = ref('物业中心')
const note = ref('')
const submitting = ref(false)

const timeOptions = ['今天 14:00', '明天 10:00', '明天 14:00', '后天 16:00']
const placeOptions = [
  { name: '物业中心', desc: '有监控与工作人员，最安全', icon: 'home', recommended: true },
  { name: '快递柜旁', desc: '方便快速交接', icon: 'box', recommended: false },
  { name: '小区花园', desc: '光线好，适合查看大件物品', icon: 'pin', recommended: false },
]

onLoad(async (options: any) => {
  orderId.value = String(options?.orderId ?? '')
  if (!orderId.value) return
  try {
    order.value = await orderStore.fetchDetail(orderId.value)
    if (order.value.appointment) {
      selectedTime.value = order.value.appointment.time
      selectedPlace.value = order.value.appointment.place
    }
  } catch (error) {
    showToast(error instanceof Error ? error.message : '加载失败', 'alert')
  }
})

function chooseCustomTime(): void {
  const options = ['本周六 10:00', '本周六 15:00', '本周日 10:00', '本周日 16:00']
  uni.showActionSheet({
    itemList: options,
    success: (res: any) => {
      customTime.value = options[Number(res.tapIndex)] ?? ''
      selectedTime.value = customTime.value
    },
  })
}

async function submit(): Promise<void> {
  if (!orderId.value || submitting.value) return
  submitting.value = true
  try {
    await orderStore.setAppointment(orderId.value, {
      time: selectedTime.value,
      place: selectedPlace.value,
      note: note.value,
    })
    showToast('预约已确认，已通知对方')
    setTimeout(() => goBack(), 500)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '预约失败', 'alert')
  } finally {
    submitting.value = false
  }
}

function goBack(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else if (orderId.value) uni.redirectTo({ url: `/pages/orders/detail?id=${orderId.value}` })
  else uni.redirectTo({ url: '/pages/orders/index' })
}
</script>

