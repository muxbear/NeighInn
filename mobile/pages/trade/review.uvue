<template>
  <scroll-view class="review" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="review__header">
      <ni-status-bar />
      <view class="review__nav">
        <view class="review__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <text class="review__nav-title">交易评价</text>
        <view class="review__nav-placeholder" />
      </view>
    </view>

    <view class="review__content">
      <view v-if="order" class="review__order">
        <image class="review__order-image" :src="order.item.image" mode="aspectFill" />
        <view class="review__order-copy">
          <text class="review__order-title" :lines="1">{{ order.item.title }}</text>
          <text class="review__order-meta">{{ order.tradeType }} · {{ order.statusText }}</text>
        </view>
      </view>

      <view class="review__card review__card--rating">
        <text class="review__card-title">这次交易体验如何？</text>
        <view class="review__stars">
          <text
            v-for="star in 5"
            :key="star"
            class="review__star"
            :class="{ 'review__star--active': star <= rating }"
            @click="rating = star"
          >★</text>
        </view>
        <text class="review__rating-label">{{ ratingLabel }}</text>
        <text class="review__rating-desc">你的评价会帮助其他邻居做出选择</text>
      </view>

      <view class="review__card">
        <text class="review__card-title">印象标签</text>
        <view class="review__tags">
          <view
            v-for="tag in tags"
            :key="tag"
            class="review__tag"
            :class="{ 'review__tag--active': selectedTags.indexOf(tag) >= 0 }"
            @click="toggleTag(tag)"
          >
            <text class="review__tag-text" :class="{ 'review__tag-text--active': selectedTags.indexOf(tag) >= 0 }">{{ tag }}</text>
          </view>
        </view>
      </view>

      <view class="review__card">
        <view class="review__card-head">
          <text class="review__card-title">写下你的评价</text>
          <text class="review__count">{{ content.length }}/500</text>
        </view>
        <ni-textarea
          v-model="content"
          placeholder="分享物品状态、沟通体验或见面感受，帮助邻居更了解这次交易"
          :maxlength="500"
          :height="110"
        />
        <view class="review__anonymous">
          <view class="review__anonymous-copy">
            <text class="review__anonymous-title">匿名评价</text>
            <text class="review__anonymous-desc">开启后其他邻居看不到你的昵称与头像</text>
          </view>
          <ni-switch v-model="anonymous" />
        </view>
      </view>

      <view class="review__tip">
        <ni-icon name="spark" :size="15" state="gold" />
        <text class="review__tip-text">提交评价可获得信用分奖励；恶意评价将影响信用记录。</text>
      </view>

      <ni-button type="primary" size="lg" block :loading="submitting" @tap="submit">
        提交评价
      </ni-button>
    </view>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="40" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import type { Order } from '../../models'
import { useOrderStore } from '../../stores/order.store'
import { useToast } from '../../composables/useToast'
import { REVIEW_TAGS } from '../../config/constants'

const orderStore = useOrderStore()
const { toast, showToast } = useToast()

const orderId = ref('')
const order = ref<Order | null>(null)
const rating = ref(5)
const selectedTags = ref<string[]>([])
const content = ref('')
const anonymous = ref(false)
const submitting = ref(false)
const tags = REVIEW_TAGS

const ratingLabel = computed(() => {
  if (rating.value >= 5) return '非常满意'
  if (rating.value === 4) return '满意'
  if (rating.value === 3) return '一般'
  if (rating.value === 2) return '不满意'
  return '非常不满意'
})

onLoad(async (options: any) => {
  orderId.value = String(options?.orderId ?? '')
  if (!orderId.value) return
  try {
    order.value = await orderStore.fetchDetail(orderId.value)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '加载失败', 'alert')
  }
})

function toggleTag(tag: string): void {
  if (selectedTags.value.indexOf(tag) >= 0) {
    selectedTags.value = selectedTags.value.filter((item) => item !== tag)
  } else {
    selectedTags.value = [...selectedTags.value, tag]
  }
}

async function submit(): Promise<void> {
  if (!orderId.value || submitting.value) return
  submitting.value = true
  try {
    await orderStore.review(orderId.value, {
      rating: rating.value,
      tags: selectedTags.value,
      content: content.value.trim(),
      anonymous: anonymous.value,
    })
    showToast('评价已提交，感谢你的分享')
    setTimeout(() => {
      uni.redirectTo({ url: `/pages/orders/detail?id=${orderId.value}` })
    }, 600)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '提交失败', 'alert')
  } finally {
    submitting.value = false
  }
}

function goBack(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else if (orderId.value) uni.redirectTo({ url: `/pages/orders/detail?id=${orderId.value}` })
  else uni.redirectTo({ url: '/pages/orders/index' })
}
</script>

