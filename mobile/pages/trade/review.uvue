  flex-direction: row;
  margin-top: 12px;
}
.review__star {
  font-size: 30px;
  color: #e7dfd8;
  margin-left: 5px;
  margin-right: 5px;
}
.review__star--active {
  color: #ffb02e;
}
.review__rating-label {
  margin-top: 4px;
  font-size: $ni-font-13;
  font-weight: 700;
  color: $ni-color-primary-dark;
}
.review__rating-desc {
  margin-top: 3px;
  font-size: $ni-font-9;
  color: $ni-color-text-tertiary;
}
.review__tags {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 10px;
}
.review__tag {
  height: 32px;
  padding-left: 12px;
  padding-right: 12px;
  border-radius: 10px;
  background-color: $ni-color-fill-2;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
  margin-bottom: 8px;
}
.review__tag--active {
  background-color: $ni-color-primary-bg;
  border: 1px solid #ffb58b;
}
.review__tag-text {
  font-size: $ni-font-10;
  color: $ni-color-text-secondary;
}
.review__tag-text--active {
  color: $ni-color-primary-dark;
  font-weight: 700;
}
.review__anonymous {
  flex-direction: row;
