  color: $ni-color-text-primary;
}
.review__anonymous-desc {
  margin-top: 2px;
  font-size: 7px;
  color: $ni-color-text-tertiary;
}
.review__tip {
  flex-direction: row;
  align-items: flex-start;
  padding: 10px;
  border-radius: $ni-radius-11;
  background-color: #fff8e8;
  margin-top: 10px;
  margin-bottom: 14px;
}
.review__tip-text {
  flex: 1;
  margin-left: 5px;
  font-size: 7px;
