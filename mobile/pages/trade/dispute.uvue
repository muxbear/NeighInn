  flex: 1;
  background-color: $ni-color-page;
  padding-bottom: 30px;
}
.dispute__header {
  background-color: $ni-color-white;
  border-bottom: 1px solid #f0ece8;
}
.dispute__nav {
  height: 48px;
  flex-direction: row;
  align-items: center;
  padding-left: 10px;
  padding-right: 10px;
}
.dispute__nav-button {
  width: 42px;
  height: 42px;
  align-items: center;
  justify-content: center;
}
