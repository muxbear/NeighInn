  padding: 11px;
  flex-direction: row;
  align-items: center;
  border-radius: $ni-radius-14;
  background-color: $ni-color-white;
  box-shadow: $ni-shadow-card;
}
.dispute__order-image {
  width: 52px;
  height: 52px;
  border-radius: 10px;
  background-color: #f3ede7;
}
.dispute__order-copy {
  flex: 1;
  margin-left: 9px;
}
.dispute__order-title {
  font-size: $ni-font-12;
  font-weight: 600;
  color: $ni-color-text-primary;
}
.dispute__order-meta {
  margin-top: 3px;
  font-size: 7px;
  color: $ni-color-text-tertiary;
}
.dispute__card {
  margin-top: 10px;
  padding: 14px;
  border-radius: $ni-radius-16;
  background-color: $ni-color-white;
  box-shadow: $ni-shadow-card;
}
.dispute__card-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 9px;
}
.dispute__card-title {
  font-size: $ni-font-14;
  font-weight: 700;
  color: $ni-color-text-primary;
}
.dispute__card-desc {
  margin-top: 3px;
  margin-bottom: 9px;
  font-size: $ni-font-9;
  color: $ni-color-text-tertiary;
}
.dispute__count {
  font-size: $ni-font-8;
  color: $ni-color-text-tertiary;
}
.dispute__reasons {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 10px;
}
.dispute__reason {
  height: 32px;
  padding-left: 11px;
  padding-right: 11px;
  border-radius: 10px;
  background-color: $ni-color-fill-2;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
  margin-bottom: 8px;
}
.dispute__reason--active {
  background-color: $ni-color-danger-bg;
  border: 1px solid #f2b79f;
}
.dispute__reason-text {
  font-size: $ni-font-9;
  color: $ni-color-text-secondary;
}
.dispute__reason-text--active {
  color: $ni-color-danger-deep;
  font-weight: 700;
}
.dispute__tip {
  flex-direction: row;
  align-items: flex-start;
  padding: 10px;
  border-radius: $ni-radius-11;
  background-color: #fff8e8;
  margin-top: 10px;
  margin-bottom: 14px;
}
.dispute__tip-text {
  flex: 1;
  margin-left: 5px;
  font-size: 7px;
  line-height: 13px;
  color: #9a7c45;
}
</style>
