  background-color: $ni-color-primary;
}
.cashier__guarantee {
  flex-direction: row;
  align-items: center;
  margin-top: 9px;
}
.cashier__guarantee--last {
  margin-bottom: 2px;
}
.cashier__guarantee-icon {
  width: 20px;
