<template>
  <scroll-view class="community" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="community__header">
      <ni-status-bar />
      <view class="community__nav">
        <view class="community__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <view class="community__nav-center">
          <text class="community__nav-title">小区管理</text>
          <text class="community__nav-sub">最多认证 {{ appStore.config.maxCommunities }} 个小区</text>
        </view>
        <view class="community__nav-placeholder" />
      </view>
    </view>

    <view class="community__content">
      <view v-if="current" class="community__current">
        <view class="community__current-head">
          <view class="community__current-icon">
            <ni-icon name="home" :size="17" state="white" />
          </view>
          <view class="community__current-copy">
            <text class="community__current-title">{{ current.name }}</text>
            <text class="community__current-desc">{{ formatCommunityRegion(current) || '行政区划待补充' }}</text>
            <text class="community__current-address">{{ current.address || '云杉路 88 号' }} · {{ current.building || '3号楼' }}</text>
          </view>
          <view class="community__current-badge">
            <ni-icon name="shield" :size="10" state="green" />
            <text class="community__current-badge-text">{{ current.role }}</text>
          </view>
        </view>

        <view class="community__stats">
          <view class="community__stat">
            <text class="community__stat-value">{{ current.memberCount }}</text>
            <text class="community__stat-label">认证邻里</text>
          </view>
          <view class="community__stat">
            <text class="community__stat-value">{{ current.itemCount }}</text>
            <text class="community__stat-label">在售物品</text>
          </view>
          <view class="community__stat">
            <text class="community__stat-value">{{ current.helpCount }}</text>
            <text class="community__stat-label">互助服务</text>
          </view>
        </view>

        <view class="community__current-footer">
          <view class="community__visit">
            <ni-icon name="clock" :size="13" state="white" />
            <text class="community__visit-text">最近到访：今天 09:20</text>
          </view>
          <view class="community__verify" @click="goOwnerProof">
            <text class="community__verify-text">{{ current.status === '已认证' ? '查看认证' : '继续认证' }}</text>
            <ni-icon name="chevron" :size="11" state="green" />
          </view>
        </view>
      </view>

      <view class="community__location">
        <view class="community__location-icon">
          <ni-icon name="pin" :size="19" state="active" />
        </view>
        <view class="community__location-copy">
          <text class="community__location-title">当前位置</text>
          <text class="community__location-desc">{{ locationText }}</text>
        </view>
        <view class="community__relocate" @click="relocate">
          <ni-loading v-if="locating" :size="14" />
          <text v-else class="community__relocate-text">重新定位</text>
        </view>
      </view>

      <view class="community__add">
        <view class="community__add-head">
          <view class="community__add-copy">
            <text class="community__add-title">添加附近小区</text>
            <text class="community__add-desc">认证后可以查看并参与该小区的闲置与互助</text>
          </view>
          <text class="community__add-count">{{ communityStore.bindings.length }}/{{ appStore.config.maxCommunities }}</text>
        </view>

        <view class="community__search">
          <ni-icon name="search" :size="17" state="tertiary" />
          <input
            class="community__search-input"
            :value="keyword"
            placeholder="搜索小区名称或地址"
            placeholder-class="community__search-placeholder"
            confirm-type="search"
            @input="onSearchInput"
            @confirm="doSearch"
          />
          <text v-if="keyword" class="community__search-action" @click="doSearch">搜索</text>
        </view>

        <view v-if="searching" class="community__searching">
          <ni-loading :size="20" text="正在搜索小区" />
        </view>

        <view v-else-if="communityStore.nearby.length === 0" class="community__empty">
          <ni-empty icon="pin" title="没有找到附近小区" desc="换个关键词，或申请收录你的小区" action-text="申请收录" @action="applyCollect" />
        </view>

        <view v-else class="community__nearby-list">
          <view v-for="item in communityStore.nearby" :key="item.id" class="community__nearby-cell">
            <community-card
              :community="item"
              @tap="onCommunityTap(item)"
              @apply="openApply(item)"
            />
          </view>
        </view>
      </view>

      <view class="community__rules">
        <ni-icon name="shield" :size="16" state="gold" />
        <view class="community__rules-copy">
          <text class="community__rules-title">认证规则</text>
          <text class="community__rules-desc">一个账号最多认证 {{ appStore.config.maxCommunities }} 个小区；认证信息仅用于业主身份核验，审核时效不超过 24 小时。</text>
        </view>
      </view>
    </view>

    <ni-sheet v-model:visible="applyVisible" title="申请认证小区" height="64vh">
      <view v-if="selectedCommunity" class="apply">
        <view class="apply__target">
          <view class="apply__target-icon">
            <ni-icon name="home" :size="20" state="active" />
          </view>
          <view class="apply__target-copy">
            <text class="apply__target-name">{{ selectedCommunity.name }}</text>
            <text class="apply__target-region">{{ formatCommunityRegion(selectedCommunity) || '行政区划待补充' }}</text>
            <text class="apply__target-address">{{ selectedCommunity.address || '附近小区' }} · {{ selectedCommunity.distance || '约 1km' }}</text>
          </view>
        </view>

        <text class="apply__label">选择你的身份</text>
        <view class="apply__identities">
          <view
            v-for="identity in identities"
            :key="identity.key"
            class="apply__identity"
            :class="{ 'apply__identity--active': selectedIdentity === identity.key }"
            @click="selectedIdentity = identity.key"
          >
            <ni-icon
              :name="identity.key === 'owner' ? 'home' : identity.key === 'tenant' ? 'order' : 'friend'"
              :size="20"
              :state="selectedIdentity === identity.key ? 'active' : 'tertiary'"
            />
            <text class="apply__identity-title">{{ identity.label }}</text>
            <text class="apply__identity-desc">{{ identity.desc }}</text>
            <view v-if="selectedIdentity === identity.key" class="apply__identity-check">
              <ni-icon name="check" :size="10" state="white" />
            </view>
          </view>
        </view>

        <text class="apply__label">证明材料</text>
        <ni-photo-uploader v-model="proofImages" :max="5" :min="1" :columns="3" :tile-height="88" add-text="添加证明" show-count />

        <view class="apply__privacy">
          <ni-icon name="lock" :size="14" state="gold" />
          <text class="apply__privacy-text">证明材料仅用于业主身份核验，加密存储，审核完成后按隐私政策处理。</text>
        </view>

        <ni-button type="primary" size="lg" block :loading="submitting || uploading" @tap="submitApply">
          提交认证申请
        </ni-button>
      </view>
    </ni-sheet>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="40" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import type { CommunityBinding } from '../../models'
import { useAppStore } from '../../stores/app.store'
import { useCommunityStore } from '../../stores/community.store'
import { useUserStore } from '../../stores/user.store'
import { useToast } from '../../composables/useToast'
import { useLocation } from '../../composables/useLocation'
import { useUpload } from '../../composables/useUpload'
import { authService } from '../../services/auth.service'
import { compressImage } from '../../utils/image'
import { formatCommunityRegion } from '../../utils/formatter'
import { IDENTITY_OPTIONS } from '../../config/constants'

const appStore = useAppStore()
const communityStore = useCommunityStore()
const userStore = useUserStore()
const { toast, showToast } = useToast()
const { locating, getLocation } = useLocation()
const { uploading, uploadMany } = useUpload()

function isImagePath(path: string): boolean {
  return /\.(jpe?g|png|webp)(\?|$)/i.test(path)
}

const keyword = ref('')
const searching = ref(false)
const applyVisible = ref(false)
const selectedCommunity = ref<CommunityBinding | null>(null)
const selectedIdentity = ref<'owner' | 'tenant' | 'family'>('owner')
const proofImages = ref<string[]>([])
const submitting = ref(false)
const locationText = ref('阳光花园小区附近 · 已授权定位')
const identities = IDENTITY_OPTIONS

const current = computed(() => communityStore.current)

onLoad(() => {
  loadData()
})

async function loadData(): Promise<void> {
  await Promise.all([
    communityStore.fetchMine().catch(() => undefined),
    communityStore.fetchNearby().catch(() => undefined),
  ])
}

function onSearchInput(event: any): void {
  keyword.value = String(event?.detail?.value ?? '')
}

async function doSearch(): Promise<void> {
  const value = keyword.value.trim()
  if (!value) {
    await communityStore.fetchNearby()
    return
  }
  searching.value = true
  try {
    await communityStore.search(value)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '搜索失败', 'alert')
  } finally {
    searching.value = false
  }
}

async function relocate(): Promise<void> {
  const coords = await getLocation()
  if (coords) {
    locationText.value = `已定位到 ${coords.latitude.toFixed(4)}, ${coords.longitude.toFixed(4)} 附近`
    showToast('定位已更新，正在刷新附近小区')
    await communityStore.fetchNearby().catch(() => undefined)
  } else {
    locationText.value = '定位权限未开启，按绑定小区位置展示'
    showToast('未获取到定位，已按绑定小区位置展示', 'alert')
  }
}

function onCommunityTap(community: CommunityBinding): void {
  if (community.status === '已认证') {
    showToast('该小区已认证')
    return
  }
  openApply(community)
}

function openApply(community: CommunityBinding): void {
  if (communityStore.bindings.length >= appStore.config.maxCommunities) {
    showToast(`最多认证 ${appStore.config.maxCommunities} 个小区`, 'alert')
    return
  }
  selectedCommunity.value = community
  selectedIdentity.value = 'owner'
  proofImages.value = []
  applyVisible.value = true
}

async function submitApply(): Promise<void> {
  if (!selectedCommunity.value || submitting.value) return
  if (!proofImages.value.length) {
    showToast('请至少上传 1 份证明材料', 'alert')
    return
  }
  submitting.value = true
  try {
    showToast('正在上传证明材料')
    const compressed: string[] = []
    for (const path of proofImages.value) {
      compressed.push(isImagePath(path) ? await compressImage(path, 82) : path)
    }
    const keys = await uploadMany(compressed, 'OWNER_PROOF')
    await authService.submitOwnerProof({
      communityId: selectedCommunity.value.id,
      identity: selectedIdentity.value,
      images: keys,
    })
    await Promise.all([
      communityStore.fetchMine().catch(() => undefined),
      userStore.refreshProfile().catch(() => undefined),
    ])
    applyVisible.value = false
    showToast('住户认证申请已提交，审核不超过 24 小时')
  } catch (error) {
    showToast(error instanceof Error ? error.message : '提交失败', 'alert')
  } finally {
    submitting.value = false
  }
}

function applyCollect(): void {
  uni.showModal({
    title: '申请收录小区',
    content: '请提供小区名称、地址与物业联系方式，我们会在 3 个工作日内核实并收录。',
    confirmText: '联系客服',
    success: (res) => {
      if (res.confirm) showToast('已记录你的收录申请')
    },
  })
}

function goOwnerProof(): void {
  uni.navigateTo({ url: '/pages/auth/owner-proof' })
}

function goBack(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else uni.switchTab({ url: '/pages/profile/index' })
}
</script>

