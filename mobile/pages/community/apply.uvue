  flex-direction: row;
  align-items: center;
  padding: 14px;
  border-radius: $ni-radius-16;
  background-image: $ni-gradient-brand;
}
.apply__intro-icon {
  width: 40px;
  height: 40px;
  border-radius: 14px;
  background-color: rgba(255, 255, 255, 0.22);
  align-items: center;
  justify-content: center;
}
.apply__intro-copy {
  flex: 1;
  margin-left: 10px;
}
.apply__intro-title {
  font-size: $ni-font-13;
  font-weight: 700;
  color: #ffffff;
}
.apply__intro-desc {
  margin-top: 3px;
  font-size: $ni-font-8;
  line-height: 14px;
  color: rgba(255, 255, 255, 0.92);
}
.apply__card {
  margin-top: 12px;
  margin-bottom: 16px;
  padding: 15px;
  border-radius: $ni-radius-18;
  background-color: $ni-color-white;
  box-shadow: $ni-shadow-card;
}
.apply__label {
  margin-top: 14px;
  margin-bottom: 8px;
  font-size: $ni-font-11;
  font-weight: 700;
  color: $ni-color-text-primary;
}
.apply__required {
  color: $ni-color-danger-deep;
}
.apply__hint {
  margin-top: 7px;
  font-size: 7px;
  line-height: 13px;
  color: $ni-color-text-tertiary;
}
.apply__note {
  margin-top: 14px;
  flex-direction: row;
  align-items: flex-start;
  padding-left: 4px;
  padding-right: 4px;
}
.apply__note-text {
  flex: 1;
  margin-left: 4px;
  font-size: 7px;
  line-height: 13px;
  color: $ni-color-text-tertiary;
}
.picker {
  padding: 12px 14px 24px;
}
.picker__crumbs {
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 6px;
}
.picker__crumb {
  flex-direction: row;
  align-items: center;
  margin-right: 4px;
  margin-bottom: 4px;
  padding-left: 8px;
  padding-right: 8px;
  height: 24px;
  border-radius: 8px;
  background-color: $ni-color-primary-bg;
}
.picker__crumb-text {
  font-size: $ni-font-8;
  color: $ni-color-primary-dark;
}
.picker__hint {
  margin-bottom: 8px;
  font-size: $ni-font-8;
  color: $ni-color-text-tertiary;
}
.picker__loading {
  padding-top: 30px;
  align-items: center;
}
.picker__skip {
  flex-direction: row;
  align-items: center;
  padding: 12px;
  margin-bottom: 8px;
  border-radius: $ni-radius-12;
  background-color: $ni-color-gift-bg;
}
.picker__skip-copy {
  flex: 1;
}
.picker__skip-title {
  font-size: $ni-font-11;
  font-weight: 600;
  color: $ni-color-gift-deep;
}
.picker__skip-desc {
  margin-top: 2px;
  font-size: 7px;
  color: $ni-color-gift-deep;
}
.picker__option {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 46px;
  padding-left: 12px;
  padding-right: 12px;
  border-bottom: 1px solid $ni-color-divider;
}
.picker__option-name {
  font-size: $ni-font-11;
  color: $ni-color-text-primary;
}
</style>
