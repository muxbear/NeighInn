  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.messages__title {
  font-size: $ni-font-27;
  font-weight: 700;
  color: $ni-color-text-primary;
  letter-spacing: -0.6px;
}
.messages__head-button {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  background-color: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(92, 73, 62, 0.06);
  align-items: center;
  justify-content: center;
}
.messages__segment {
  width: 190px;
  height: 36px;
  margin: 12px 16px;
  padding: 3px;
  flex-direction: row;
  border-radius: $ni-radius-11;
  background-color: #ede9e5;
}
.messages__segment-button {
  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
}
.messages__segment-button--active {
  background-color: #ffffff;
  box-shadow: 0 1px 4px rgba(60, 45, 35, 0.08);
}
.messages__segment-text {
  font-size: $ni-font-12;
  color: $ni-color-text-secondary;
}
.messages__segment-text--active {
  color: $ni-color-text-primary;
  font-weight: 700;
}
.messages__segment-count {
  margin-left: 3px;
  font-size: $ni-font-8;
  color: $ni-color-primary;
  font-weight: 700;
}
.messages__quick {
  margin: 0 14px 12px;
  padding: 15px 8px;
  flex-direction: row;
  border-radius: $ni-radius-16;
  background-color: $ni-color-white;
  box-shadow: $ni-shadow-card;
}
.messages__quick-item {
  flex: 1;
  align-items: center;
  overflow: visible;
}
.messages__quick-icon {
  width: 43px;
  height: 43px;
  border-radius: 14px;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: visible;
}
.messages__quick-icon--trade {
  background-color: #fff0e7;
}
.messages__quick-icon--social {
  background-color: $ni-color-success-bg;
}
.messages__quick-icon--friend {
