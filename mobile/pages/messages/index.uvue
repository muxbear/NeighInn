<template>
  <scroll-view
    class="messages"
    direction="vertical"
    :show-scrollbar="false"
    style="flex: 1; height: 1px;"
    :lower-threshold="80"
    @scrolltolower="onScrollToLower"
  >
    <view class="messages__header">
      <ni-status-bar />
      <view class="messages__head-row">
        <text class="messages__title">消息</text>
        <view class="messages__head-button" @click="goFriends">
          <ni-icon name="friend" :size="19" state="secondary" />
        </view>
      </view>
    </view>

    <view class="messages__segment">
      <view
        class="messages__segment-button"
        :class="{ 'messages__segment-button--active': tab === 'messages' }"
        @click="switchTab('messages')"
      >
        <text class="messages__segment-text" :class="{ 'messages__segment-text--active': tab === 'messages' }">消息</text>
        <text v-if="socialStore.unreadTotal > 0" class="messages__segment-count">{{ socialStore.unreadTotal }}</text>
      </view>
      <view
        class="messages__segment-button"
        :class="{ 'messages__segment-button--active': tab === 'neighbors' }"
        @click="switchTab('neighbors')"
      >
        <text class="messages__segment-text" :class="{ 'messages__segment-text--active': tab === 'neighbors' }">邻居</text>
        <text v-if="neighborCountText" class="messages__segment-count">{{ neighborCountText }}</text>
      </view>
    </view>

    <template v-if="tab === 'messages'">
      <view class="messages__quick">
        <view class="messages__quick-item" @click="goNotifications()">
          <view class="messages__quick-icon messages__quick-icon--trade">
            <ni-icon name="wallet" :size="19" state="active" />
          </view>
          <text class="messages__quick-title">交易通知</text>
          <text class="messages__quick-desc">订单与验货提醒</text>
        </view>
        <view class="messages__quick-item" @click="goNotifications()">
          <view class="messages__quick-icon messages__quick-icon--social">
            <ni-icon name="message" :size="19" state="green" />
          </view>
          <text class="messages__quick-title">留言互动</text>
          <text class="messages__quick-desc">留言、点赞与评论</text>
        </view>
        <view v-if="socialStore.pendingRequestCount > 0" class="messages__quick-item" @click="goFriendRequests">
          <view class="messages__quick-icon messages__quick-icon--friend">
            <ni-icon name="friend" :size="19" state="blue" />
            <view class="messages__quick-badge">
              <ni-badge :count="socialStore.pendingRequestCount" :max="9" />
            </view>
          </view>
          <text class="messages__quick-title">历史好友申请</text>
          <text class="messages__quick-desc">{{ socialStore.pendingRequestCount }} 条待处理</text>
        </view>
        <view v-else class="messages__quick-item" @click="goFriends">
          <view class="messages__quick-icon messages__quick-icon--friend">
            <ni-icon name="friend" :size="19" state="blue" />
          </view>
          <text class="messages__quick-title">查找邻居</text>
          <text class="messages__quick-desc">同小区认证邻居</text>
        </view>
      </view>

      <view class="messages__list-head">
        <text class="messages__list-title">最近会话</text>
        <text class="messages__list-action" @click="readAll">全部已读</text>
      </view>

      <view v-if="loading && messages.length === 0" class="messages__loading">
        <ni-skeleton :rows="4" :avatar="true" />
      </view>

      <view v-else-if="messages.length === 0" class="messages__empty">
        <ni-empty icon="message" title="还没有会话" desc="在物品详情页私信邻居，开始第一次交流" action-text="去逛逛" @action="goHome" />
      </view>

      <view v-else class="messages__list">
        <conversation-item
          v-for="conversation in messages"
          :key="conversation.id"
          :conversation="conversation"
          @tap="openChat(conversation.id)"
        />
      </view>
    </template>

    <template v-else>
      <view v-if="eligibility && !eligibility.eligible" class="messages__eligibility">
        <view class="messages__eligibility-head">
          <ni-icon name="shield" :size="18" state="gold" />
          <text class="messages__eligibility-title">完成认证，和邻居聊起来</text>
        </view>
        <text class="messages__eligibility-desc">{{ eligibility.reasonText || '完成实名认证与住户认证后，即可查看同小区邻居并聊天' }}</text>
        <view class="messages__eligibility-tags">
          <text class="messages__eligibility-tag" :class="{ 'messages__eligibility-tag--done': eligibility.realnameVerified }">
            {{ eligibility.realnameVerified ? '实名认证 ✓' : '实名认证' }}
          </text>
          <text class="messages__eligibility-tag" :class="{ 'messages__eligibility-tag--done': eligibility.ownerVerified }">
            {{ eligibility.ownerVerified ? '住户认证 ✓' : '住户认证' }}
          </text>
        </view>
        <view class="messages__eligibility-action" @click="goAuth">
          <text class="messages__eligibility-action-text">去认证中心</text>
        </view>
      </view>

      <template v-else>
        <view class="messages__neighbor-search">
          <ni-icon name="search" :size="17" state="tertiary" />
          <input
            class="messages__neighbor-input"
            :value="keyword"
            placeholder="搜索邻居昵称或楼栋"
            placeholder-class="messages__neighbor-placeholder"
            confirm-type="search"
            @input="onSearchInput"
            @confirm="applySearch"
          />
          <text v-if="keyword" class="messages__neighbor-clear" @click="clearSearch">清除</text>
        </view>

        <view class="messages__neighbor-actions">
          <view class="messages__neighbor-action" @click="goFriends">
            <ni-icon name="search" :size="17" state="tertiary" />
            <text class="messages__neighbor-action-text">查找邻居</text>
          </view>
          <view class="messages__neighbor-action" @click="goBlacklist">
            <ni-icon name="shield" :size="17" state="gold" />
            <text class="messages__neighbor-action-text">黑名单</text>
          </view>
        </view>

        <view v-if="friends.length === 0 && !socialStore.neighborLoading" class="messages__empty">
          <ni-empty
            icon="friend"
            title="还没有邻居好友"
            :desc="keyword ? '没有找到相关邻居' : '同小区暂无其他已认证邻居'"
            action-text="刷新"
            @action="refreshNeighbors"
          />
        </view>

        <view v-else class="messages__friends">
          <view
            v-for="friend in friends"
            :key="friend.userId || friend.id"
            class="messages__friend"
            @click="chatWithFriend(friend.userId || friend.id)"
            @longpress="openFriendActions(friend)"
          >
            <ni-avatar :src="friend.avatar" :name="friend.name" :size="48" variant="green" />
            <view class="messages__friend-copy">
              <view class="messages__friend-row">
                <text class="messages__friend-name">{{ friend.name }}</text>
                <ni-icon v-if="friend.verified" name="shield" :size="9" state="gold" />
              </view>
              <text class="messages__friend-meta">{{ friend.building || friend.community || '同小区邻居' }}</text>
            </view>
            <view class="messages__friend-status">
              <ni-icon name="message" :size="18" state="tertiary" />
            </view>
          </view>
        </view>

        <view v-if="socialStore.neighborLoading" class="messages__neighbor-loading">
          <text class="messages__neighbor-loading-text">加载中…</text>
        </view>
        <view v-else-if="!socialStore.neighborHasMore && friends.length > 0" class="messages__neighbor-end">
          <text class="messages__neighbor-end-text">没有更多邻居了</text>
        </view>
      </template>
    </template>

    <view class="messages__bottom-space" />
    <ni-tab-bar active="messages" :unread="socialStore.unreadTotal" />
    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="92" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad, onPullDownRefresh, onShow } from '@dcloudio/uni-app'
import type { Conversation, Friend } from '../../models'
import { useSocialStore } from '../../stores/social.store'
import { useNotificationStore } from '../../stores/notification.store'
import { useToast } from '../../composables/useToast'

const socialStore = useSocialStore()
const notificationStore = useNotificationStore()
const { toast, showToast } = useToast()

const tab = ref<'messages' | 'neighbors'>('messages')
const keyword = ref('')
let searchTimer: any = null
const loading = computed(() => socialStore.loading)
const messages = computed<Conversation[]>(() => socialStore.conversations)
const friends = computed<Friend[]>(() => socialStore.friends)
const eligibility = computed(() => socialStore.eligibility)
const neighborCountText = computed(() => {
  const total = socialStore.neighborTotal || friends.value.length
  if (!total) return ''
  return total > 99 ? '99+' : String(total)
})

onLoad(() => {
  loadData()
})

onShow(() => {
  if (typeof uni !== 'undefined') uni.hideTabBar({ animation: false })
  loadData()
})

onPullDownRefresh(async () => {
  try {
    await loadData(true)
  } finally {
    uni.stopPullDownRefresh()
  }
})

async function loadData(resetNeighbors = false): Promise<void> {
  await Promise.all([
    socialStore.fetchConversations().catch(() => undefined),
    socialStore.fetchEligibility().catch(() => undefined),
    socialStore.fetchFriends().catch(() => undefined),
    socialStore.fetchRequests().catch(() => undefined),
    notificationStore.fetchUnread().catch(() => undefined),
  ])
  if (resetNeighbors) await socialStore.fetchNeighbors(true).catch(() => undefined)
}

function switchTab(next: 'messages' | 'neighbors'): void {
  tab.value = next
  if (next === 'neighbors') {
    socialStore.fetchNeighbors(true).catch(() => undefined)
  }
}

async function readAll(): Promise<void> {
  try {
    await socialStore.readAll()
    notificationStore.readAll().catch(() => undefined)
    showToast('已全部标记为已读')
  } catch (error) {
    showToast(error instanceof Error ? error.message : '操作失败', 'alert')
  }
}

function openChat(conversationId: string): void {
  uni.navigateTo({ url: `/pages/social/chat?id=${conversationId}` })
}

async function chatWithFriend(friendId: string): Promise<void> {
  try {
    const conversation = await socialStore.openConversation(friendId)
    openChat(conversation.id)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '打开会话失败', 'alert')
  }
}

function onSearchInput(event: any): void {
  keyword.value = String(event?.detail?.value ?? '')
  if (searchTimer) clearTimeout(searchTimer)
  searchTimer = setTimeout(() => {
    socialStore.setNeighborFilter(keyword.value).catch(() => undefined)
  }, 300)
}

function applySearch(): void {
  if (searchTimer) clearTimeout(searchTimer)
  socialStore.setNeighborFilter(keyword.value).catch(() => undefined)
}

function clearSearch(): void {
  keyword.value = ''
  socialStore.setNeighborFilter('').catch(() => undefined)
}

function refreshNeighbors(): void {
  socialStore.fetchNeighbors(true).catch(() => undefined)
}

function onScrollToLower(): void {
  if (tab.value === 'neighbors') socialStore.loadMoreNeighbors().catch(() => undefined)
}

function openFriendActions(friend: Friend): void {
  uni.showActionSheet({
    itemList: ['设置备注', '加入黑名单', '举报该邻居'],
    success: (res: any) => {
      const index = Number(res.tapIndex)
      if (index === 0) {
        editRemark(friend)
      } else if (index === 1) {
        confirmBlock(friend)
      } else if (index === 2) {
        uni.navigateTo({ url: `/pages/report/index?type=user&targetId=${friend.userId || friend.id}` })
      }
    },
  })
}

function editRemark(friend: Friend): void {
  uni.showModal({
    title: '设置备注',
    editable: true,
    placeholderText: friend.name,
    content: friend.remark || '',
    success: (res: any) => {
      if (!res.confirm) return
      socialStore.setRemark(friend.userId || friend.id, String(res.content ?? ''))
        .then(() => showToast('备注已更新'))
        .catch((error) => showToast(error instanceof Error ? error.message : '操作失败', 'alert'))
    },
  } as any)
}

function confirmBlock(friend: Friend): void {
  uni.showModal({
    title: '加入黑名单',
    content: `拉黑后，你和「${friend.name}」将互相不可见，且不能互发消息。`,
    confirmText: '拉黑',
    confirmColor: '#E05B4B',
    success: (res: any) => {
      if (!res.confirm) return
      socialStore.blockPeer(friend.userId || friend.id)
        .then(() => showToast('已加入黑名单'))
        .catch((error) => showToast(error instanceof Error ? error.message : '操作失败', 'alert'))
    },
  })
}

function goNotifications(): void {
  uni.navigateTo({ url: '/pages/notifications/index' })
}
function goFriendRequests(): void {
  uni.navigateTo({ url: '/pages/social/friend-requests' })
}
function goFriends(): void {
  uni.navigateTo({ url: '/pages/social/friends' })
}
function goBlacklist(): void {
  uni.navigateTo({ url: '/pages/social/blacklist' })
}
function goAuth(): void {
  uni.navigateTo({ url: '/pages/auth/center' })
}
function goHome(): void {
  uni.switchTab({ url: '/pages/home/index' })
}
</script>

