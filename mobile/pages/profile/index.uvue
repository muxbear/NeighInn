      <view class="profile__actions">
        <view class="profile__action" @click="goNotifications">
          <ni-icon name="bell" :size="19" state="secondary" />
          <view v-if="notificationStore.unread > 0" class="profile__action-badge">
            <ni-badge :count="notificationStore.unread" :max="9" />
