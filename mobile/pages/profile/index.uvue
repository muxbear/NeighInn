        </view>
        <view class="profile__menu-row" @click="goFavorites">
          <view class="profile__menu-icon profile__menu-icon--blue"><ni-icon name="heart" :size="17" state="blue" /></view>
          <view class="profile__menu-copy">
            <text class="profile__menu-title">收藏与足迹</text>
            <text class="profile__menu-desc">收藏商品、服务与生活动态</text>
          </view>
          <ni-icon name="chevron" :size="17" state="tertiary" />
        </view>
        <view class="profile__menu-row" @click="goCommunity">
          <view class="profile__menu-icon profile__menu-icon--green"><ni-icon name="home" :size="17" state="green" /></view>
          <view class="profile__menu-copy">
