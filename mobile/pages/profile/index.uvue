      </view>

      <view class="profile__user" @click="goEdit">
        <view class="profile__avatar-wrap">
          <ni-avatar :src="userStore.avatarSrc" :name="userStore.profile?.nickname" :size="64" variant="orange" />
          <view class="profile__avatar-camera">
            <ni-icon name="camera" :size="11" state="white" />
          </view>
        </view>
        <view class="profile__user-copy">
          <view class="profile__name-row">
            <text class="profile__name">{{ displayName }}</text>
            <view v-if="userStore.isRealnameVerified" class="profile__verified profile__verified--realname">
