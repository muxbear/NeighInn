              <text class="profile__verified-text profile__verified-text--realname">已实名</text>
            </view>
            <view v-if="userStore.isVerifiedOwner" class="profile__verified profile__verified--owner">
              <ni-icon name="home" :size="10" state="green" />
              <text class="profile__verified-text">认证业主</text>
            </view>
          </view>
          <text class="profile__user-meta">{{ communityName }} · 加入 {{ userStore.profile?.joinedDays || 0 }} 天</text>
          <view class="profile__credit-row" @click.stop="goCredit">
            <text class="profile__credit">{{ creditLevel }} · {{ creditScore }} 分</text>
            <ni-icon name="chevron" :size="9" state="tertiary" />
          </view>
        </view>
        <ni-icon name="chevron" :size="17" state="tertiary" />
      </view>
    </view>

    <view class="profile__body">
      <view class="profile__content-card">
        <view class="profile__content-head">
          <text class="profile__content-heading">我的内容</text>
          <text class="profile__content-manage" @click="goManage">内容管理 ›</text>
        </view>
        <view class="profile__content-grid">
          <view class="profile__content-item" @click="goManage">
            <view class="profile__content-icon profile__content-icon--sale">
              <ni-icon name="box" :size="18" state="active" />
            </view>
            <text class="profile__content-title">闲置物品</text>
            <text class="profile__content-count">{{ stats.publishCount }} 条</text>
          </view>
          <view class="profile__content-item" @click="goLife">
            <view class="profile__content-icon profile__content-icon--gift">
              <ni-icon name="image" :size="18" state="green" />
            </view>
            <text class="profile__content-title">生活动态</text>
            <text class="profile__content-count">{{ stats.lifeCount }} 条</text>
          </view>
          <view class="profile__content-item" @click="goZoneService">
            <view class="profile__content-icon profile__content-icon--gold">
              <ni-icon name="friend" :size="18" state="gold" />
            </view>
            <text class="profile__content-title">互助服务</text>
            <text class="profile__content-count">{{ stats.serviceCount }} 条</text>
          </view>
          <view class="profile__content-item" @click="goFavorites">
            <view class="profile__content-icon profile__content-icon--swap">
              <ni-icon name="heart" :size="18" state="blue" />
            </view>
            <text class="profile__content-title">收藏足迹</text>
            <text class="profile__content-count">{{ stats.favoriteCount + stats.historyCount }} 条</text>
          </view>
        </view>
      </view>

      <view class="profile__orders">
        <view class="profile__orders-head">
          <text class="profile__orders-title">我的订单</text>
          <text class="profile__orders-all" @click="goOrders('monetary')">全部订单</text>
        </view>
        <view class="profile__orders-grid">
          <view class="profile__order-item" @click="goOrders('free')">
            <view class="profile__order-icon profile__order-icon--gift">
              <ni-icon name="gift" :size="20" state="green" />
              <text v-if="orderCount('free') > 0" class="profile__order-badge">{{ orderCount('free') }}</text>
            </view>
            <text class="profile__order-title">免费订单</text>
            <text class="profile__order-desc">赠与与领取</text>
          </view>
          <view class="profile__order-item" @click="goOrders('swap')">
            <view class="profile__order-icon profile__order-icon--swap">
              <ni-icon name="swap" :size="20" state="blue" />
              <text v-if="orderCount('swap') > 0" class="profile__order-badge">{{ orderCount('swap') }}</text>
            </view>
            <text class="profile__order-title">互换订单</text>
            <text class="profile__order-desc">以物换物</text>
          </view>
          <view class="profile__order-item" @click="goOrders('monetary')">
            <view class="profile__order-icon profile__order-icon--sale">
              <ni-icon name="wallet" :size="20" state="active" />
              <text v-if="orderCount('monetary') > 0" class="profile__order-badge">{{ orderCount('monetary') }}</text>
            </view>
            <text class="profile__order-title">货币订单</text>
            <text class="profile__order-desc">担保交易</text>
          </view>
        </view>
      </view>

      <view class="profile__wallet">
        <wallet-card :balance="wallet.balance" :escrow="wallet.escrow" @open="goWallet" />
