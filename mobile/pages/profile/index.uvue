            <text class="profile__menu-desc">{{ communityName }} · 认证小区管理</text>
          </view>
          <ni-icon name="chevron" :size="17" state="tertiary" />
        </view>
        <view class="profile__menu-row" @click="goHelp">
          <view class="profile__menu-icon profile__menu-icon--blue"><ni-icon name="message" :size="17" state="blue" /></view>
          <view class="profile__menu-copy">
            <text class="profile__menu-title">帮助与客服</text>
            <text class="profile__menu-desc">常见问题 · 在线客服 · 意见反馈</text>
          </view>
          <ni-icon name="chevron" :size="17" state="tertiary" />
        </view>
        <view class="profile__menu-row profile__menu-row--last" @click="goSettings">
          <view class="profile__menu-icon"><ni-icon name="settings" :size="17" state="active" /></view>
