            <text class="profile__menu-title">设置与隐私</text>
            <text class="profile__menu-desc">通知、账号安全与长辈模式</text>
          </view>
          <ni-icon name="chevron" :size="17" state="tertiary" />
        </view>
      </view>

      <text class="profile__slogan">真实邻居 · 安心流转</text>
    </view>

    <view class="profile__bottom-space" />
    <ni-tab-bar active="profile" :unread="socialStore.unreadTotal" />
    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="92" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import type { CreditInfo, MineStats, WalletSummary } from '../../models'
import { useUserStore } from '../../stores/user.store'
import { useItemStore } from '../../stores/item.store'
import { useOrderStore } from '../../stores/order.store'
import { useSocialStore } from '../../stores/social.store'
import { useNotificationStore } from '../../stores/notification.store'
import { useCommunityStore } from '../../stores/community.store'
import { useToast } from '../../composables/useToast'
import { itemService } from '../../services/item.service'
import { payService } from '../../services/pay.service'

const userStore = useUserStore()
const itemStore = useItemStore()
const orderStore = useOrderStore()
const socialStore = useSocialStore()
const notificationStore = useNotificationStore()
const communityStore = useCommunityStore()
const { toast, showToast } = useToast()

const stats = ref<MineStats>({
  publishCount: 0,
  favoriteCount: 0,
  historyCount: 0,
  lifeCount: 0,
  serviceCount: 0,
  creditScore: 92,
})
const credit = ref<CreditInfo | null>(null)
const wallet = ref<WalletSummary>({ balance: 0, escrow: 0, withdrawable: 0 })

const displayName = computed(() => userStore.profile?.nickname || '温暖的邻居')
const communityName = computed(() => communityStore.current?.name || userStore.profile?.communityName || '阳光花园小区')
const creditScore = computed(() => credit.value?.score ?? userStore.profile?.creditScore ?? stats.value.creditScore)
const creditLevel = computed(() => {
  if (credit.value?.level) return credit.value.level
  const score = creditScore.value
  return score >= 90 ? '极好' : score >= 70 ? '良好' : score >= 50 ? '一般' : '待提升'
})
const certificationMenuDesc = computed(() => {
  if (userStore.isRealnameVerified && userStore.isVerifiedOwner) return '实名与住户认证均已完成'
  if (userStore.isVerifiedOwner) return '住户认证已完成 · 实名待完成'
  if (userStore.ownerStatus === 'PENDING' || userStore.ownerStatus === 'SUPPLEMENT') return '住户认证审核中'
  if (userStore.realnameStatus === 'PENDING' || userStore.realnameStatus === 'SUPPLEMENT') return '实名认证审核中'
  if (userStore.realnameStatus === 'REJECTED' || userStore.ownerStatus === 'REJECTED') return '认证未通过，查看原因'
  return '实名认证与住户认证'
})

onShow(() => {
  if (typeof uni !== 'undefined') uni.hideTabBar({ animation: false })
  loadData()
})

async function loadData(): Promise<void> {
  await Promise.all([
    userStore.refreshProfile().catch(() => undefined),
    loadStats(),
    loadOrders(),
    socialStore.fetchFriends().catch(() => undefined),
    socialStore.fetchConversations().catch(() => undefined),
    notificationStore.fetchUnread().catch(() => undefined),
    communityStore.fetchMine().catch(() => undefined),
  ])
}

async function loadStats(): Promise<void> {
  try {
    stats.value = await itemService.getMineStats()
  } catch {
    stats.value = {
      publishCount: 4,
      favoriteCount: 1,
      historyCount: 0,
      lifeCount: 8,
      serviceCount: 5,
      creditScore: userStore.profile?.creditScore || 92,
    }
  }
  try {
    credit.value = await itemService.getCreditInfo()
  } catch {
    credit.value = null
  }
  try {
    wallet.value = await payService.getWallet()
  } catch {
    wallet.value = { balance: 0, escrow: 0, withdrawable: 0 }
  }
}

async function loadOrders(): Promise<void> {
  await Promise.all([
    orderStore.fetchOrders('free').catch(() => undefined),
    orderStore.fetchOrders('swap').catch(() => undefined),
    orderStore.fetchOrders('monetary').catch(() => undefined),
  ])
}

function orderCount(type: 'free' | 'swap' | 'monetary'): number {
  return orderStore.ordersByType[type]?.length ?? 0
}

function goEdit(): void {
  uni.navigateTo({ url: '/pages/profile/edit' })
}
function goSettings(): void {
  uni.navigateTo({ url: '/pages/settings/index' })
}
function goNotifications(): void {
  uni.navigateTo({ url: '/pages/notifications/index' })
}
function goManage(): void {
  uni.navigateTo({ url: '/pages/item/manage' })
}
function goFavorites(): void {
  uni.navigateTo({ url: '/pages/mine/favorites' })
}
function goLife(): void {
  uni.navigateTo({ url: '/pages/life/mine' })
}
function goZoneService(): void {
  uni.navigateTo({ url: '/pages/zone/index?zone=service' })
}
function goCredit(): void {
  uni.navigateTo({ url: '/pages/mine/credit' })
}
function goOrders(type: string): void {
  uni.navigateTo({ url: `/pages/orders/index?type=${type}` })
}
function goWallet(): void {
  uni.navigateTo({ url: '/pages/pay/wallet' })
}
function goFriends(): void {
  uni.navigateTo({ url: '/pages/social/friends' })
}
function goCommunity(): void {
  uni.navigateTo({ url: '/pages/community/index' })
}
function goAuth(): void {
  uni.navigateTo({ url: '/pages/auth/center' })
}
function goHelp(): void {
  uni.navigateTo({ url: '/pages/settings/help' })
}
</script>

