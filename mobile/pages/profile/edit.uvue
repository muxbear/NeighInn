<template>
  <scroll-view class="pedit" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="pedit__header">
      <ni-status-bar />
      <view class="pedit__nav">
        <view class="pedit__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <text class="pedit__nav-title">个人信息</text>
        <view class="pedit__save" @click="save">
          <text class="pedit__save-text">保存</text>
        </view>
      </view>
    </view>

    <view class="pedit__content">
      <view class="pedit__avatar-card">
        <view class="pedit__avatar-row">
          <view class="pedit__avatar-wrap">
            <ni-avatar :src="avatarPreview" :name="form.nickname" :size="64" variant="orange" />
            <view class="pedit__avatar-camera">
              <ni-icon name="camera" :size="11" state="white" />
            </view>
          </view>
          <view class="pedit__avatar-copy">
            <text class="pedit__avatar-name">{{ form.nickname || '温暖的邻居' }}</text>
            <view class="pedit__avatar-verified">
              <ni-icon name="shield" :size="9" state="gold" />
              <text class="pedit__avatar-verified-text">认证业主 · {{ communityName }}</text>
            </view>
            <text class="pedit__avatar-desc">头像会展示在邻里互动与交易中</text>
          </view>
        </view>

        <view class="pedit__avatar-actions">
          <view class="pedit__avatar-action" @click="uploadAvatar">
            <view class="pedit__avatar-action-icon">
              <ni-icon name="camera" :size="19" state="active" />
            </view>
            <text class="pedit__avatar-action-text">上传照片</text>
            <text class="pedit__avatar-action-hint">≤5MB</text>
          </view>
          <view class="pedit__avatar-action" @click="openAvatarLibrary">
            <view class="pedit__avatar-action-icon">
              <ni-icon name="image" :size="19" state="active" />
            </view>
            <text class="pedit__avatar-action-text">内置头像</text>
            <text class="pedit__avatar-action-hint">4 类可选</text>
          </view>
        </view>
      </view>

      <text class="pedit__group-title">基本信息</text>
      <view class="pedit__form">
        <view class="pedit__field">
          <view class="pedit__field-head">
            <text class="pedit__field-label">昵称</text>
            <text class="pedit__field-required">必填</text>
            <text class="pedit__field-count">{{ form.nickname.length }}/16</text>
          </view>
          <input
            class="pedit__input"
            :value="form.nickname"
            maxlength="16"
            placeholder="请输入昵称"
            placeholder-class="pedit__placeholder"
            @input="onFieldInput('nickname', $event)"
          />
        </view>
        <view class="pedit__field">
          <view class="pedit__field-head">
            <text class="pedit__field-label">手机号</text>
          </view>
          <input
            class="pedit__input"
            type="number"
            :value="form.phone"
            maxlength="11"
            placeholder="请输入手机号"
            placeholder-class="pedit__placeholder"
            @input="onFieldInput('phone', $event)"
          />
        </view>
        <view class="pedit__field">
          <view class="pedit__field-head">
            <text class="pedit__field-label">邮箱</text>
          </view>
          <input
            class="pedit__input"
            :value="form.email"
            maxlength="60"
            placeholder="用于接收订单与认证通知（选填）"
            placeholder-class="pedit__placeholder"
            @input="onFieldInput('email', $event)"
          />
        </view>
        <view class="pedit__field pedit__field--last">
          <view class="pedit__field-head">
            <text class="pedit__field-label">家庭地址</text>
            <text class="pedit__field-required">必填</text>
          </view>
          <input
            class="pedit__input"
            :value="form.address"
            maxlength="80"
            placeholder="例如：阳光花园小区 3 号楼 1202"
            placeholder-class="pedit__placeholder"
            @input="onFieldInput('address', $event)"
          />
          <text class="pedit__field-note">仅用于邻里交易与配送，订单完成后按隐私设置展示</text>
        </view>
      </view>

      <text class="pedit__group-title">认证与小区</text>
      <view class="pedit__form pedit__form--compact">
        <view class="pedit__auth-row" @click="goOwnerProof">
          <view class="pedit__auth-icon">
            <ni-icon name="home" :size="18" state="active" />
          </view>
          <view class="pedit__auth-copy">
            <text class="pedit__auth-title">{{ communityName }}</text>
            <text class="pedit__auth-desc">业主认证 · 已认证</text>
          </view>
          <view class="pedit__auth-badge">
            <ni-icon name="shield" :size="10" state="green" />
            <text class="pedit__auth-badge-text">已认证</text>
          </view>
          <ni-icon name="chevron" :size="15" state="tertiary" />
        </view>
      </view>

      <text class="pedit__group-title">个人描述</text>
      <view class="pedit__form">
        <ni-textarea
          v-model="form.bio"
          placeholder="介绍一下自己，让邻居更了解你（最多 80 字）"
          :maxlength="80"
          :height="78"
        />
        <view class="pedit__bio-preview">
          <ni-avatar :src="avatarPreview" :name="form.nickname" :size="38" variant="orange" />
          <view class="pedit__bio-copy">
            <text class="pedit__bio-name">{{ form.nickname || '温暖的邻居' }}</text>
            <text class="pedit__bio-text" :lines="2">{{ form.bio || '这里会展示你的个人描述' }}</text>
          </view>
        </view>
      </view>

      <text class="pedit__group-title">隐私设置</text>
      <view class="pedit__form pedit__form--privacy">
        <view class="pedit__privacy-row">
          <view class="pedit__privacy-copy">
            <text class="pedit__privacy-title">展示个人描述</text>
            <text class="pedit__privacy-desc">关闭后其他邻居看不到你的个人描述</text>
          </view>
          <ni-switch v-model="form.showBio" />
        </view>
        <view class="pedit__privacy-row pedit__privacy-row--last">
          <view class="pedit__privacy-copy">
            <text class="pedit__privacy-title">订单后共享地址</text>
            <text class="pedit__privacy-desc">仅在订单确认后向交易对方展示</text>
          </view>
          <ni-switch v-model="form.shareAddressAfterOrder" />
        </view>
      </view>

      <view class="pedit__security">
        <ni-icon name="lock" :size="16" state="gold" />
        <view class="pedit__security-copy">
          <text class="pedit__security-title">你的信息受到保护</text>
          <text class="pedit__security-desc">手机号与地址加密存储，展示时自动脱敏；身份证号与姓名不会保存在本地。</text>
        </view>
      </view>

      <ni-button type="primary" size="lg" block :loading="saving" @tap="save">保存个人信息</ni-button>
      <view class="pedit__bottom-space" />
    </view>

    <avatar-library
      v-model:visible="avatarLibraryVisible"
      :groups="avatarGroups"
      :selected="form.avatarPreset"
      @confirm="onAvatarPresetConfirm"
    />

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="40" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, reactive, ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import type { AvatarPresetGroup } from '../../models'
import { useUserStore } from '../../stores/user.store'
import { useCommunityStore } from '../../stores/community.store'
import { useToast } from '../../composables/useToast'
import { profileService } from '../../services/profile.service'
import { chooseImages } from '../../utils/image'
import { validateProfile } from '../../utils/validator'

const userStore = useUserStore()
const communityStore = useCommunityStore()
const { toast, showToast } = useToast()

const saving = ref(false)
const avatarLibraryVisible = ref(false)
const avatarGroups = ref<AvatarPresetGroup[]>([])

const form = reactive({
  nickname: '',
  phone: '',
  email: '',
  address: '',
  bio: '',
  showBio: true,
  shareAddressAfterOrder: true,
  avatarPreset: '',
  avatarDataUrl: '',
})

const avatarPreview = computed(() => {
  if (form.avatarDataUrl) return form.avatarDataUrl
  if (form.avatarPreset) return `/static/avatars/${form.avatarPreset}.svg`
  return userStore.avatarSrc
})

const communityName = computed(() => communityStore.current?.name || userStore.profile?.communityName || '阳光花园小区')

onLoad(async () => {
  hydrateForm()
  communityStore.fetchMine().catch(() => undefined)
  try {
    avatarGroups.value = await profileService.getAvatarPresets()
  } catch {
    avatarGroups.value = []
  }
})

function hydrateForm(): void {
  const profile = userStore.profile
  if (!profile) return
  form.nickname = profile.nickname
  form.phone = profile.phone
  form.email = profile.email
  form.address = profile.address
  form.bio = profile.bio
  form.showBio = profile.showBio
  form.shareAddressAfterOrder = profile.shareAddressAfterOrder
  form.avatarPreset = profile.avatarPreset
  form.avatarDataUrl = profile.avatarDataUrl
}

function onFieldInput(key: 'nickname' | 'phone' | 'email' | 'address', event: any): void {
  form[key] = String(event?.detail?.value ?? '')
}

async function uploadAvatar(): Promise<void> {
  try {
    const paths = await chooseImages({ count: 1 })
    if (!paths.length) return
    form.avatarDataUrl = paths[0]
    form.avatarPreset = ''
    showToast('头像已选择，保存后生效')
  } catch {
    // 用户取消
  }
}

function openAvatarLibrary(): void {
  if (!avatarGroups.value.length) {
    showToast('头像库加载中，请稍后再试', 'alert')
    return
  }
  avatarLibraryVisible.value = true
}

function onAvatarPresetConfirm(key: string): void {
  form.avatarPreset = key
  form.avatarDataUrl = ''
  showToast('头像已选择，保存后生效')
}

async function save(): Promise<void> {
  if (saving.value) return
  const validation = validateProfile({
    nickname: form.nickname,
    phone: form.phone,
    email: form.email,
    address: form.address,
  })
  if (!validation.valid) {
    showToast(Object.values(validation.errors)[0], 'alert')
    return
  }
  saving.value = true
  try {
    await userStore.updateProfile({
      nickname: form.nickname,
      phone: form.phone,
      email: form.email,
      address: form.address,
      bio: form.bio,
      showBio: form.showBio,
      shareAddressAfterOrder: form.shareAddressAfterOrder,
      avatarPreset: form.avatarPreset,
      avatarDataUrl: form.avatarDataUrl,
    })
    showToast('个人信息已保存')
    setTimeout(() => goBack(), 500)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '保存失败', 'alert')
  } finally {
    saving.value = false
  }
}

function goBack(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else uni.switchTab({ url: '/pages/profile/index' })
}

function goOwnerProof(): void {
  uni.navigateTo({ url: '/pages/auth/owner-proof' })
}
</script>

