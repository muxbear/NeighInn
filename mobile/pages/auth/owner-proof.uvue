<template>
  <scroll-view class="proof" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="proof__header">
      <ni-status-bar />
      <view class="proof__nav">
        <view class="proof__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <text class="proof__nav-title">住户认证</text>
        <view class="proof__nav-placeholder" />
      </view>
    </view>

    <view class="proof__content">
      <view class="proof__security">
        <view class="proof__security-icon">
          <ni-icon name="shield" :size="19" state="gold" />
        </view>
        <view class="proof__security-copy">
          <text class="proof__security-title">仅用于业主身份核验</text>
          <text class="proof__security-desc">证明材料加密存储，审核完成后按隐私政策处理，不会公开展示。</text>
        </view>
      </view>

      <view class="proof__realname">
        <ni-icon name="shield" :size="14" :state="realnameStatus === 'VERIFIED' ? 'green' : 'tertiary'" />
        <text class="proof__realname-text">{{ realnameHint }}</text>
        <text v-if="realnameStatus !== 'VERIFIED'" class="proof__realname-link" @click="goRealname">去实名</text>
      </view>

      <view v-if="statusLoading" class="proof__state">
        <ni-loading :size="20" text="正在读取认证状态" />
      </view>

      <view v-else-if="isOwnerFrozen" class="proof__state">
        <view class="proof__state-icon">
          <ni-icon name="lock" :size="24" state="gold" />
        </view>
        <text class="proof__state-title">住户认证已冻结</text>
        <text class="proof__state-desc">因违规处理，你的业主资格已被冻结，在售物品已自动下架。如有疑问请联系客服。</text>
        <ni-button type="primary" size="lg" block @tap="goCenter">返回认证中心</ni-button>
      </view>

      <view v-else-if="ownerCurrentStatus === 'VERIFIED'" class="proof__state proof__state--success">
        <view class="proof__state-icon proof__state-icon--success">
          <ni-icon name="check" :size="24" state="white" />
        </view>
        <text class="proof__state-title">住户认证已完成</text>
        <text class="proof__state-desc">你已绑定小区，个人中心会展示“认证业主”标识。</text>
        <ni-button type="primary" size="lg" block @tap="goCenter">返回认证中心</ni-button>
      </view>

      <view v-else-if="isOwnerPending" class="proof__state">
        <view class="proof__state-icon">
          <ni-icon name="clock" :size="24" state="gold" />
        </view>
        <text class="proof__state-title">{{ ownerCurrentStatus === 'SUPPLEMENT' ? '需要补充材料' : '住户认证审核中' }}</text>
        <text class="proof__state-desc">预计 24 小时内完成审核，结果会通过通知中心告知。</text>
        <ni-button type="primary" size="lg" block @tap="goCenter">返回认证中心</ni-button>
      </view>

      <template v-else>
        <view v-if="(ownerCurrentStatus === 'REJECTED' || ownerCurrentStatus === 'REVOKED' || ownerCurrentStatus === 'SUPPLEMENT') && rejectReason" class="proof__rejected">
          <ni-icon name="alert" :size="16" state="danger" />
          <view class="proof__rejected-copy">
            <text class="proof__rejected-title">{{ ownerBannerTitle }}</text>
            <text class="proof__rejected-desc">{{ rejectReason }}</text>
          </view>
        </view>

        <view class="proof__card">
          <text class="proof__card-title">认证小区</text>
          <view class="proof__community" @click="chooseCommunity">
            <view class="proof__community-icon">
              <ni-icon name="home" :size="18" state="active" />
            </view>
            <view class="proof__community-copy">
              <text class="proof__community-name">{{ selectedCommunity?.name || '请选择小区' }}</text>
              <text class="proof__community-region">{{ selectedRegionText || '按省份/直辖市、地市、区/县、街道选择' }}</text>
              <text class="proof__community-address">{{ selectedCommunity?.address || '选择你居住的小区' }}</text>
            </view>
            <ni-icon name="chevron" :size="15" state="tertiary" />
          </view>
        </view>

        <view class="proof__card">
          <text class="proof__card-title">你的身份</text>
          <text class="proof__card-desc">不同身份需要提交的证明材料不同</text>
          <view class="proof__identities">
            <view
              v-for="identity in identities"
              :key="identity.key"
              class="proof__identity"
              :class="{ 'proof__identity--active': selectedIdentity === identity.key }"
              @click="selectedIdentity = identity.key"
            >
              <ni-icon
                :name="identity.key === 'owner' ? 'home' : identity.key === 'tenant' ? 'order' : 'friend'"
                :size="21"
                :state="selectedIdentity === identity.key ? 'active' : 'tertiary'"
              />
              <text class="proof__identity-title">{{ identity.label }}</text>
              <text class="proof__identity-desc">{{ identity.desc }}</text>
              <view v-if="selectedIdentity === identity.key" class="proof__identity-check">
                <ni-icon name="check" :size="10" state="white" />
              </view>
            </view>
          </view>
        </view>

        <view class="proof__card">
          <view class="proof__card-head">
            <text class="proof__card-title">证明材料</text>
            <text class="proof__card-count">{{ images.length }}/5</text>
          </view>
          <text class="proof__card-desc">可上传房产证、购房合同、租赁合同或近 3 个月缴费记录</text>
          <ni-photo-uploader v-model="images" :max="5" :min="1" :columns="3" :tile-height="100" add-text="添加证明" show-count />
        </view>

        <view class="proof__tips">
          <text class="proof__tips-title">审核说明</text>
          <text class="proof__tips-item">· 审核时效不超过 24 小时，结果会通过通知中心告知</text>
          <text class="proof__tips-item">· 实名与住户认证相互独立，未实名也可提交本次申请</text>
          <text class="proof__tips-item">· 累计 3 次未通过将转人工复核，请确保材料真实清晰</text>
        </view>

        <ni-button type="primary" size="lg" block :loading="submitting || uploading" :disabled="!canSubmit" @tap="submit">
          {{ canSubmit ? '提交住户认证' : '请选择小区并上传证明材料' }}
        </ni-button>
      </template>
    </view>

    <ni-sheet v-model:visible="pickerVisible" title="选择认证小区" height="80vh">
      <view class="picker">
        <view class="picker__head">
          <text class="picker__title">{{ pickerLevelTitle }}</text>
          <text class="picker__hint">{{ pickerLevelHint }}</text>
        </view>

        <view class="picker__search">
          <ni-icon name="search" :size="15" state="tertiary" />
          <input
            class="picker__search-input"
            :value="pickerKeyword"
            placeholder="搜索小区名称或地址"
            placeholder-class="picker__search-placeholder"
            confirm-type="search"
            @input="updatePickerKeyword"
            @confirm="runPickerSearch"
          />
          <text v-if="pickerKeyword || pickerSearchMode" class="picker__search-clear" @click="clearPickerSearch">取消</text>
          <text class="picker__search-action" @click="runPickerSearch">搜索</text>
        </view>

        <view v-if="pickerCrumbs.length" class="picker__crumbs">
          <view
            v-for="crumb in pickerCrumbs"
            :key="crumb.level"
            class="picker__crumb"
            @click="jumpRegionCrumb(crumb.index)"
          >
            <text class="picker__crumb-text">{{ crumb.label }}</text>
            <ni-icon name="chevron" :size="9" state="tertiary" />
          </view>
        </view>

        <view v-if="pickerLoading || pickerSearching" class="picker__loading">
          <ni-loading :size="20" :text="pickerSearching ? '正在搜索小区' : '正在加载区划'" />
        </view>

        <template v-else-if="pickerSearchMode || pickerLevel === 'community'">
          <view v-if="!pickerSearchMode && pickerLevel === 'community'" class="picker__filter">
            <view class="picker__filter-copy">
              <text class="picker__filter-label">所在街道</text>
              <text class="picker__filter-value">{{ pickerSelectedStreetName || '全部街道（可选）' }}</text>
            </view>
            <text class="picker__filter-action" @click="showStreetOptions">
              {{ pickerSelectedStreetName ? '更换' : '按街道筛选' }}
            </text>
          </view>

          <view v-if="regionCommunities.length" class="picker__communities">
            <view
              v-for="community in regionCommunities"
              :key="community.id"
              class="picker__community"
              @click="chooseRegionCommunity(community)"
            >
              <view class="picker__community-icon">
                <ni-icon name="home" :size="18" state="active" />
              </view>
              <view class="picker__community-copy">
                <text class="picker__community-name">{{ community.name }}</text>
                <text class="picker__community-region">{{ formatCommunityRegion(community) || '行政区划待补充' }}</text>
                <text class="picker__community-address">{{ community.address || '小区地址待补充' }}</text>
              </view>
              <ni-icon name="chevron" :size="14" state="tertiary" />
            </view>
          </view>
          <ni-empty
            v-else
            icon="pin"
            :title="pickerEmptyTitle"
            :desc="pickerEmptyDesc"
          />
        </template>

        <template v-else-if="pickerLevel === 'street'">
          <view class="picker__all-streets" @click="showAllDistrictCommunities">
            <view class="picker__all-streets-icon">
              <ni-icon name="home" :size="18" state="active" />
            </view>
            <view class="picker__all-streets-copy">
              <text class="picker__all-streets-title">全部街道</text>
              <text class="picker__all-streets-desc">不限定街道，查看该区县所有小区</text>
            </view>
            <ni-icon name="chevron" :size="14" state="tertiary" />
          </view>

          <view v-if="regionOptions.length" class="picker__options">
            <view
              v-for="node in regionOptions"
              :key="node.id"
              class="picker__option"
              @click="chooseRegionNode(node)"
            >
              <text class="picker__option-name">{{ node.name }}</text>
              <ni-icon name="chevron" :size="14" state="tertiary" />
            </view>
          </view>
          <ni-empty
            v-else
            icon="pin"
            :title="pickerEmptyTitle"
            :desc="pickerEmptyDesc"
          />
        </template>

        <view v-else-if="regionOptions.length" class="picker__options">
          <view
            v-for="node in regionOptions"
            :key="node.id"
            class="picker__option"
            @click="chooseRegionNode(node)"
          >
            <text class="picker__option-name">{{ node.name }}</text>
            <ni-icon name="chevron" :size="14" state="tertiary" />
          </view>
        </view>

        <ni-empty
          v-else
          icon="pin"
          :title="pickerEmptyTitle"
          :desc="pickerEmptyDesc"
        />
      </view>
    </ni-sheet>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="40" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import type { CertificationState, CommunityBinding } from '../../models'
import { useCommunityStore } from '../../stores/community.store'
import { useUserStore } from '../../stores/user.store'
import { useToast } from '../../composables/useToast'
import { useUpload } from '../../composables/useUpload'
import { useCommunityRegionPicker } from '../../composables/useCommunityRegionPicker'
import { authService } from '../../services/auth.service'
import { compressImage } from '../../utils/image'
import { formatCommunityRegion } from '../../utils/formatter'
import { IDENTITY_OPTIONS } from '../../config/constants'

const communityStore = useCommunityStore()
const userStore = useUserStore()
const { toast, showToast } = useToast()
const { uploading, uploadMany } = useUpload()

const selectedCommunity = ref<CommunityBinding | null>(null)
const selectedIdentity = ref<'owner' | 'tenant' | 'family'>('owner')
const images = ref<string[]>([])
const submitting = ref(false)
const statusLoading = ref(true)
const ownerCurrentStatus = ref<CertificationState>('UNVERIFIED')
const realnameStatus = ref<CertificationState>('UNVERIFIED')
const rejectReason = ref('')
const identities = IDENTITY_OPTIONS

const {
  visible: pickerVisible,
  loading: pickerLoading,
  searching: pickerSearching,
  level: pickerLevel,
  options: regionOptions,
  communities: regionCommunities,
  keyword: pickerKeyword,
  searchMode: pickerSearchMode,
  selectedStreetName: pickerSelectedStreetName,
  crumbs: pickerCrumbs,
  levelTitle: pickerLevelTitle,
  levelHint: pickerLevelHint,
  emptyTitle: pickerEmptyTitle,
  emptyDesc: pickerEmptyDesc,
  open: openRegionPicker,
  updateKeyword: updatePickerKeyword,
  runSearch: runPickerSearch,
  clearSearch: clearPickerSearch,
  chooseRegion: chooseRegionNode,
  chooseCommunity: chooseRegionCommunity,
  showStreetOptions,
  showAllDistrictCommunities,
  jumpTo: jumpRegionCrumb,
} = useCommunityRegionPicker((community) => {
  selectedCommunity.value = community
})

const selectedRegionText = computed(() => formatCommunityRegion(selectedCommunity.value))

const isOwnerPending = computed(() => ownerCurrentStatus.value === 'PENDING')
const isOwnerFrozen = computed(() => ownerCurrentStatus.value === 'FROZEN')
const ownerBannerTitle = computed(
  () => (ownerCurrentStatus.value === 'SUPPLEMENT' ? '需要补充材料' : '上次申请未通过'),
)
const realnameHint = computed(() => {
  if (realnameStatus.value === 'VERIFIED') return '已实名认证'
  if (realnameStatus.value === 'PENDING' || realnameStatus.value === 'SUPPLEMENT') {
    return '实名认证审核中，不影响本次住户认证'
  }
  return '实名认证未完成，可稍后补充，不影响本次住户认证审核'
})
const canSubmit = computed(() => Boolean(selectedCommunity.value && images.value.length))

function isImagePath(path: string): boolean {
  return /\.(jpe?g|png|webp)(\?|$)/i.test(path)
}

onLoad(async () => {
  try {
    const status = await authService.getStatus()
    ownerCurrentStatus.value = status.owner?.status ?? 'UNVERIFIED'
    realnameStatus.value = status.realname?.status ?? 'UNVERIFIED'
    rejectReason.value = status.owner?.rejectReason ?? ''
  } catch {
    // 状态读取失败时仍允许用户选择小区并重新提交
  } finally {
    statusLoading.value = false
  }
  await communityStore.fetchMine().catch(() => undefined)
  if (!communityStore.current && communityStore.bindings.length === 0) {
    await communityStore.fetchNearby().catch(() => undefined)
  }
  const source = [...communityStore.bindings, ...communityStore.nearby]
  const intentId = userStore.profile?.intentCommunityId || ''
  const intent = intentId ? source.find((item) => item.id === intentId) : undefined
  selectedCommunity.value =
    intent ?? communityStore.current ?? communityStore.bindings[0] ?? communityStore.nearby[0] ?? null
})

function chooseCommunity(): void {
  openRegionPicker()
}

async function submit(): Promise<void> {
  if (!canSubmit.value || submitting.value) return
  submitting.value = true
  try {
    showToast('正在上传证明材料')
    const compressed: string[] = []
    for (const path of images.value) {
      compressed.push(isImagePath(path) ? await compressImage(path, 82) : path)
    }
    const keys = await uploadMany(compressed, 'OWNER_PROOF')
    await authService.submitOwnerProof({
      communityId: selectedCommunity.value!.id,
      identity: selectedIdentity.value,
      images: keys,
    })
    await userStore.refreshProfile().catch(() => undefined)
    showToast('住户认证已提交')
    setTimeout(() => {
      uni.redirectTo({ url: '/pages/auth/result?type=owner' })
    }, 500)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '提交失败', 'alert')
  } finally {
    submitting.value = false
  }
}

function goCenter(): void {
  uni.redirectTo({ url: '/pages/auth/center' })
}

function goRealname(): void {
  uni.navigateTo({ url: '/pages/auth/realname' })
}

function goBack(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else uni.switchTab({ url: '/pages/profile/index' })
}
</script>

