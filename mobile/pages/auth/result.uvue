<template>
  <scroll-view class="auth-result" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="auth-result__header">
      <ni-status-bar />
      <view class="auth-result__nav">
        <view class="auth-result__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <text class="auth-result__nav-title">认证结果</text>
        <view class="auth-result__nav-placeholder" />
      </view>
    </view>

    <view class="auth-result__content">
      <view class="auth-result__icon auth-result__icon--pending">
        <ni-icon name="clock" :size="40" state="gold" />
      </view>
      <text class="auth-result__title">{{ title }}</text>
      <text class="auth-result__desc">{{ desc }}</text>

      <view class="auth-result__card">
        <view class="auth-result__row">
          <text class="auth-result__row-label">认证类型</text>
          <text class="auth-result__row-value">{{ isOwner ? '住户认证' : '实名认证' }}</text>
        </view>
        <view class="auth-result__row">
          <text class="auth-result__row-label">提交时间</text>
          <text class="auth-result__row-value">{{ submitTime }}</text>
        </view>
        <view class="auth-result__row">
          <text class="auth-result__row-label">当前状态</text>
          <text class="auth-result__row-value auth-result__row-value--primary">审核中（≤24小时）</text>
        </view>
        <view class="auth-result__row auth-result__row--last">
          <text class="auth-result__row-label">说明</text>
          <text class="auth-result__row-value">仅用于小区身份核验</text>
        </view>
      </view>

      <view class="auth-result__timeline">
        <view class="auth-result__timeline-item">
          <view class="auth-result__timeline-dot auth-result__timeline-dot--done" />
          <view class="auth-result__timeline-copy">
            <text class="auth-result__timeline-title">资料已提交</text>
            <text class="auth-result__timeline-desc">材料已加密上传</text>
          </view>
        </view>
        <view class="auth-result__timeline-line" />
        <view class="auth-result__timeline-item">
          <view class="auth-result__timeline-dot auth-result__timeline-dot--active" />
          <view class="auth-result__timeline-copy">
            <text class="auth-result__timeline-title">{{ isOwner ? '人工审核中' : '实名审核中' }}</text>
            <text class="auth-result__timeline-desc">预计 24 小时内完成</text>
          </view>
        </view>
        <view class="auth-result__timeline-line" />
        <view class="auth-result__timeline-item">
          <view class="auth-result__timeline-dot" />
          <view class="auth-result__timeline-copy">
            <text class="auth-result__timeline-title">认证完成</text>
            <text class="auth-result__timeline-desc">结果会通过通知中心告知</text>
          </view>
        </view>
      </view>

      <view class="auth-result__actions">
        <ni-button v-if="isOwner" type="primary" size="lg" block @tap="goCenter">返回认证中心</ni-button>
        <ni-button v-else type="primary" size="lg" block @tap="goOwnerProof">继续住户认证</ni-button>
        <view class="auth-result__secondary" @click="isOwner ? goHome() : goCenter()">
          <text class="auth-result__secondary-text">{{ isOwner ? '返回首页' : '返回认证中心' }}</text>
        </view>
        <view class="auth-result__secondary" @click="goNotifications">
          <text class="auth-result__secondary-text">查看通知</text>
        </view>
      </view>

      <view class="auth-result__tip">
        <ni-icon name="shield" :size="14" state="gold" />
        <text class="auth-result__tip-text">如有疑问，可在设置 - 帮助与反馈中联系在线客服。</text>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import { formatDateTime } from '../../utils/formatter'

const type = ref<'realname' | 'owner'>('owner')
const submitTime = ref(formatDateTime(Date.now()))

const isOwner = computed(() => type.value === 'owner')
const title = computed(() => (isOwner.value ? '住户认证已提交' : '实名认证已提交'))
const desc = computed(() =>
  isOwner.value
    ? '我们已收到你的证明材料，审核通过后即可在该小区发布闲置与参与交易。'
    : '我们已收到你的实名材料，审核通过后会展示“已实名”标识；你也可以现在继续提交住户认证。',
)

onLoad((options: any) => {
  if (options?.type === 'realname') type.value = 'realname'
})

function goBack(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else uni.switchTab({ url: '/pages/profile/index' })
}
function goOwnerProof(): void {
  uni.redirectTo({ url: '/pages/auth/owner-proof' })
}
function goCenter(): void {
  uni.redirectTo({ url: '/pages/auth/center' })
}
function goHome(): void {
  uni.switchTab({ url: '/pages/home/index' })
}
function goNotifications(): void {
  uni.navigateTo({ url: '/pages/notifications/index' })
}
</script>

