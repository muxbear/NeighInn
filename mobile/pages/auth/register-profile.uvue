<template>
  <scroll-view class="regp" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="regp__header">
      <ni-status-bar />
      <view class="regp__nav">
        <view class="regp__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <text class="regp__nav-title">完善资料</text>
        <view class="regp__nav-placeholder" />
      </view>
    </view>

    <view class="regp__content">
      <view class="regp__progress">
        <view class="regp__progress-head">
          <text class="regp__progress-label">完善邻里名片</text>
          <text class="regp__progress-step">2 / 2</text>
        </view>
        <ni-progress :percent="100" :height="6" />
      </view>

      <view class="regp__card">
        <text class="regp__title">让邻居更快认识你</text>
        <text class="regp__desc">资料会展示在邻里互动与交易中，之后可在“我的”里随时修改</text>

        <view class="regp__avatar-row">
          <ni-avatar :src="avatarPreview" :name="nickname" :size="64" variant="orange" ring />
          <view class="regp__avatar-copy">
            <text class="regp__avatar-title">邻里头像</text>
            <text class="regp__avatar-desc">选择内置头像，随时可更换</text>
          </view>
          <ni-button type="secondary" size="sm" @tap="openAvatarLibrary">更换</ni-button>
        </view>

        <text class="regp__label">昵称</text>
        <ni-input
          v-model="nickname"
          placeholder="给自己起个邻居称呼"
          :maxlength="16"
          prefix-icon="friend"
          :height="50"
        />
        <text class="regp__hint">1–16 字，将展示给邻里；请勿填写手机号等隐私信息</text>

        <text class="regp__label">入住小区（必填）</text>
        <ni-cell
          icon="home"
          icon-state="green"
          :title="selectedCommunity?.name || '选择你所在的小区'"
          :desc="selectedCommunityDesc"
          right-text="选择"
          @tap="chooseCommunity"
        />
        <view class="regp__apply-entry" @click="goApplyCommunity">
          <text class="regp__apply-entry-text">没找到我家小区，申请添加</text>
          <ni-icon name="chevron" :size="11" state="active" />
        </view>
      </view>

      <ni-button type="primary" size="xl" block :loading="submitting" @tap="completeProfile">
        完成注册
      </ni-button>

      <view class="regp__privacy">
        <ni-icon name="lock" :size="13" state="tertiary" />
        <text class="regp__privacy-text">手机号不会公开；实名信息仅用于身份核验，展示时自动脱敏。</text>
      </view>
    </view>

    <avatar-library
      v-model:visible="avatarLibraryVisible"
      :groups="avatarGroups"
      :selected="avatarPreset"
      @confirm="onAvatarConfirm"
    />

    <ni-sheet v-model:visible="pickerVisible" title="选择入住小区" height="80vh">
      <view class="picker">
        <view class="picker__head">
          <text class="picker__title">{{ pickerLevelTitle }}</text>
          <text class="picker__hint">{{ pickerLevelHint }}</text>
        </view>

        <view class="picker__search">
          <ni-icon name="search" :size="15" state="tertiary" />
          <input
            class="picker__search-input"
            :value="pickerKeyword"
            placeholder="搜索小区名称或地址"
            placeholder-class="picker__search-placeholder"
            confirm-type="search"
            @input="updatePickerKeyword"
            @confirm="runPickerSearch"
          />
          <text v-if="pickerKeyword || pickerSearchMode" class="picker__search-clear" @click="clearPickerSearch">取消</text>
          <text class="picker__search-action" @click="runPickerSearch">搜索</text>
        </view>

        <view v-if="pickerCrumbs.length" class="picker__crumbs">
          <view
            v-for="crumb in pickerCrumbs"
            :key="crumb.level"
            class="picker__crumb"
            @click="jumpRegionCrumb(crumb.index)"
          >
            <text class="picker__crumb-text">{{ crumb.label }}</text>
            <ni-icon name="chevron" :size="9" state="tertiary" />
          </view>
        </view>

        <view v-if="pickerLoading || pickerSearching" class="picker__loading">
          <ni-loading :size="20" :text="pickerSearching ? '正在搜索小区' : '正在加载区划'" />
        </view>

        <template v-else-if="pickerSearchMode || pickerLevel === 'community'">
          <view v-if="!pickerSearchMode && pickerLevel === 'community'" class="picker__filter">
            <view class="picker__filter-copy">
              <text class="picker__filter-label">所在街道</text>
              <text class="picker__filter-value">{{ pickerSelectedStreetName || '全部街道（可选）' }}</text>
            </view>
            <text class="picker__filter-action" @click="showStreetOptions">
              {{ pickerSelectedStreetName ? '更换' : '按街道筛选' }}
            </text>
          </view>

          <view v-if="regionCommunities.length" class="picker__communities">
            <view
              v-for="community in regionCommunities"
              :key="community.id"
              class="picker__community"
              @click="chooseRegionCommunity(community)"
            >
              <view class="picker__community-icon">
                <ni-icon name="home" :size="18" state="active" />
              </view>
              <view class="picker__community-copy">
                <text class="picker__community-name">{{ community.name }}</text>
                <text class="picker__community-region">{{ formatCommunityRegion(community) || '行政区划待补充' }}</text>
                <text class="picker__community-address">{{ community.address || '小区地址待补充' }}</text>
              </view>
              <ni-icon name="chevron" :size="14" state="tertiary" />
            </view>
          </view>
          <ni-empty
            v-else
            icon="pin"
            :title="pickerEmptyTitle"
            :desc="pickerEmptyDesc"
          />
        </template>

        <template v-else-if="pickerLevel === 'street'">
          <view class="picker__all-streets" @click="showAllDistrictCommunities">
            <view class="picker__all-streets-icon">
              <ni-icon name="home" :size="18" state="active" />
            </view>
            <view class="picker__all-streets-copy">
              <text class="picker__all-streets-title">全部街道</text>
              <text class="picker__all-streets-desc">不限定街道，查看该区县所有小区</text>
            </view>
            <ni-icon name="chevron" :size="14" state="tertiary" />
          </view>

          <view v-if="regionOptions.length" class="picker__options">
            <view
              v-for="node in regionOptions"
              :key="node.id"
              class="picker__option"
              @click="chooseRegionNode(node)"
            >
              <text class="picker__option-name">{{ node.name }}</text>
              <ni-icon name="chevron" :size="14" state="tertiary" />
            </view>
          </view>
          <ni-empty
            v-else
            icon="pin"
            :title="pickerEmptyTitle"
            :desc="pickerEmptyDesc"
          />
        </template>

        <view v-else-if="regionOptions.length" class="picker__options">
          <view
            v-for="node in regionOptions"
            :key="node.id"
            class="picker__option"
            @click="chooseRegionNode(node)"
          >
            <text class="picker__option-name">{{ node.name }}</text>
            <ni-icon name="chevron" :size="14" state="tertiary" />
          </view>
        </view>

        <ni-empty
          v-else
          icon="pin"
          :title="pickerEmptyTitle"
          :desc="pickerEmptyDesc"
        />
      </view>
    </ni-sheet>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="40" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import type { AvatarPresetGroup, CommunityBinding } from '../../models'
import { useUserStore } from '../../stores/user.store'
import { useCommunityStore } from '../../stores/community.store'
import { useToast } from '../../composables/useToast'
import { useCommunityRegionPicker } from '../../composables/useCommunityRegionPicker'
import { profileService } from '../../services/profile.service'
import { formatCommunityRegion } from '../../utils/formatter'

const user = useUserStore()
const communityStore = useCommunityStore()
const { toast, showToast } = useToast()

const FALLBACK_AVATAR_GROUPS: AvatarPresetGroup[] = [
  {
    key: 'person',
    label: '卡通人物',
    items: ['avatar-person-1', 'avatar-person-2', 'avatar-person-3'],
  },
  {
    key: 'animal',
    label: '卡通动物',
    items: ['avatar-animal-1', 'avatar-animal-2', 'avatar-animal-3'],
  },
  {
    key: 'landmark',
    label: '名胜古迹',
    items: ['avatar-landmark-1', 'avatar-landmark-2', 'avatar-landmark-3'],
  },
  {
    key: 'nature',
    label: '自然风景',
    items: ['avatar-nature-1', 'avatar-nature-2', 'avatar-nature-3'],
  },
]

const nickname = ref('')
const avatarPreset = ref('avatar-person-1')
const avatarGroups = ref<AvatarPresetGroup[]>([])
const avatarLibraryVisible = ref(false)
const selectedCommunity = ref<CommunityBinding | null>(null)
const submitting = ref(false)

const avatarPreview = computed(() =>
  avatarPreset.value ? `/static/avatars/${avatarPreset.value}.svg` : user.avatarSrc,
)
const selectedCommunityDesc = computed(() => {
  const community = selectedCommunity.value
  if (!community) return '按省份/直辖市、地市、区/县选择，完成住户认证后成为认证业主'
  const region = formatCommunityRegion(community)
  const address = community.address || '完成住户认证后成为认证业主'
  return region ? `${region} · ${address}` : address
})

const {
  visible: pickerVisible,
  loading: pickerLoading,
  searching: pickerSearching,
  level: pickerLevel,
  options: regionOptions,
  communities: regionCommunities,
  keyword: pickerKeyword,
  searchMode: pickerSearchMode,
  selectedStreetName: pickerSelectedStreetName,
  crumbs: pickerCrumbs,
  levelTitle: pickerLevelTitle,
  levelHint: pickerLevelHint,
  emptyTitle: pickerEmptyTitle,
  emptyDesc: pickerEmptyDesc,
  open: openRegionPicker,
  updateKeyword: updatePickerKeyword,
  runSearch: runPickerSearch,
  clearSearch: clearPickerSearch,
  chooseRegion: chooseRegionNode,
  chooseCommunity: chooseRegionCommunity,
  showStreetOptions,
  showAllDistrictCommunities,
  jumpTo: jumpRegionCrumb,
} = useCommunityRegionPicker((community) => {
  selectedCommunity.value = community
})

onLoad(async () => {
  if (!user.isLoggedIn) {
    uni.redirectTo({ url: '/pages/auth/login' })
    return
  }
  await user.refreshProfile()
  if (!user.profile) return
  // 注册流程只停留在资料完善：已完成（或已保存过资料）的账号直接进首页，
  // 认证是可选环节，放到「我的/首页提示卡」里再做。
  if (user.onboardingStatus === 'COMPLETED' || user.onboardingStatus === 'PROFILE_COMPLETED') {
    uni.switchTab({ url: '/pages/home/index' })
    return
  }
  nickname.value = user.profile?.nickname || ''
  avatarPreset.value = user.profile?.avatarPreset || 'avatar-person-1'

  try {
    avatarGroups.value = await profileService.getAvatarPresets()
  } catch {
    avatarGroups.value = []
  }
  if (!avatarGroups.value.length) {
    avatarGroups.value = FALLBACK_AVATAR_GROUPS
  }

  await communityStore.fetchNearby().catch(() => undefined)
  const intentId = user.profile?.intentCommunityId || ''
  if (intentId) {
    const found = [...communityStore.bindings, ...communityStore.nearby].find((item) => item.id === intentId)
    if (found) selectedCommunity.value = found
  }
})

function openAvatarLibrary(): void {
  if (!avatarGroups.value.length) {
    showToast('头像库加载中，请稍后再试', 'alert')
    return
  }
  avatarLibraryVisible.value = true
}

function onAvatarConfirm(key: string): void {
  avatarPreset.value = key
  showToast('头像已选择')
}

function chooseCommunity(): void {
  openRegionPicker()
}

function goApplyCommunity(): void {
  uni.navigateTo({ url: '/pages/community/apply' })
}

function intentCommunityPayload(): number | string | undefined {
  const id = selectedCommunity.value?.id
  if (!id) return undefined
  return /^\d+$/.test(id) ? Number(id) : id
}

async function completeProfile(): Promise<void> {
  if (submitting.value) return
  const name = nickname.value.trim()
  if (!name) {
    showToast('请填写昵称', 'alert')
    return
  }
  if (name.length > 16) {
    showToast('昵称最多 16 字', 'alert')
    return
  }
  if (!selectedCommunity.value) {
    showToast('请选择入住小区', 'alert')
    return
  }
  submitting.value = true
  try {
    await user.completeRegistration({
      nickname: name,
      avatarKey: avatarPreset.value,
      intentCommunityId: intentCommunityPayload(),
    })
    // 注册即完成 onboarding，直接进主页面；认证不再是注册的必经环节。
    await finishOnboarding()
    showToast('注册成功，欢迎加入邻里小栈')
    setTimeout(() => {
      uni.switchTab({ url: '/pages/home/index' })
    }, 400)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '保存失败', 'alert')
  } finally {
    submitting.value = false
  }
}

async function finishOnboarding(): Promise<void> {
  if (user.onboardingStatus === 'COMPLETED') return
  try {
    await user.completeRegistration({ finish: true })
  } catch {
    // 网络异常不阻塞进入首页/实名认证
  }
}

function goBack(): void {
  uni.showModal({
    title: '请先完成注册',
    content: '入住小区为必填项，请选择入住小区并完成注册后继续。',
    showCancel: false,
    confirmText: '继续完善',
  })
}
</script>

