  background-color: $ni-color-credit-bg;
}
.cert-center__card-icon--owner {
  background-color: $ni-color-success-bg;
}
.cert-center__card-copy {
  flex: 1;
  margin-left: 10px;
}
.cert-center__card-title {
  font-size: $ni-font-14;
  font-weight: 700;
  color: $ni-color-text-primary;
}
.cert-center__card-desc {
  margin-top: 3px;
  font-size: $ni-font-9;
  color: $ni-color-text-tertiary;
}
.cert-center__status {
  height: 22px;
  padding-left: 7px;
  padding-right: 7px;
  border-radius: 11px;
  background-color: $ni-color-fill-1;
  align-items: center;
  justify-content: center;
}
.cert-center__status--success {
  background-color: $ni-color-success-bg;
}
.cert-center__status--pending {
  background-color: $ni-color-credit-bg;
}
.cert-center__status--danger {
  background-color: $ni-color-danger-bg;
}
.cert-center__status-text {
  font-size: $ni-font-9;
  color: $ni-color-text-tertiary;
}
.cert-center__status-text--success {
  color: $ni-color-success-deep;
}
.cert-center__status-text--pending {
  color: $ni-color-credit-deep;
}
