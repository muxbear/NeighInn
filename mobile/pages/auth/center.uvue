  color: $ni-color-text-secondary;
  text-align: center;
  padding-left: 14px;
  padding-right: 14px;
}
.cert-center__progress {
  width: 100%;
  margin-top: 16px;
  padding: 12px 14px;
  border-radius: $ni-radius-14;
  background-color: rgba(255, 255, 255, 0.78);
}
.cert-center__progress-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}
.cert-center__progress-label {
  font-size: $ni-font-10;
  font-weight: 600;
  color: $ni-color-text-primary;
}
.cert-center__progress-value {
  font-size: $ni-font-10;
  font-weight: 700;
  color: $ni-color-gift;
}
