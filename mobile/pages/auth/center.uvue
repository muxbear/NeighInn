  padding: 12px;
  align-items: center;
}
.cert-center__card {
  margin-bottom: 10px;
  padding: 15px;
  border-radius: $ni-radius-16;
  background-color: $ni-color-white;
  box-shadow: $ni-shadow-card;
}
.cert-center__card-head {
  flex-direction: row;
  align-items: center;
}
.cert-center__card-icon {
  width: 40px;
  height: 40px;
  border-radius: 14px;
  align-items: center;
  justify-content: center;
}
