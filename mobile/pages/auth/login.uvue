<template>
  <scroll-view class="login" scroll-y :show-scrollbar="false">
    <ni-status-bar />
    <image class="login__glow login__glow--top" src="/static/placeholders/glow-warm.svg" mode="scaleToFill" />
    <image class="login__glow login__glow--left" src="/static/placeholders/glow-sage.svg" mode="scaleToFill" />

    <view class="login__content">
      <view class="login__brand">
        <view class="login__logo">
          <ni-icon name="home" :size="34" state="white" />
          <view class="login__logo-dot" />
        </view>
        <text class="login__slogan">真实邻居 · 安心流转</text>
        <text class="login__title">欢迎来到邻里小栈</text>
        <text class="login__subtitle">登录后发现本小区好物与互助服务</text>
      </view>

      <view class="login__tabs">
        <view
          class="login__tab"
          :class="{ 'login__tab--active': mode === 'oneclick' }"
          @click="mode = 'oneclick'"
        >
          <text class="login__tab-text" :class="{ 'login__tab-text--active': mode === 'oneclick' }">本机一键登录</text>
        </view>
        <view
          class="login__tab"
          :class="{ 'login__tab--active': mode === 'sms' }"
          @click="mode = 'sms'"
        >
          <text class="login__tab-text" :class="{ 'login__tab-text--active': mode === 'sms' }">验证码登录</text>
        </view>
      </view>

      <view v-if="mode === 'oneclick'" class="login__panel login__panel--oneclick">
        <view class="login__phone-row">
          <view class="login__phone-icon">
            <ni-icon name="phone" :size="22" state="active" />
          </view>
          <view class="login__phone-copy">
            <text class="login__phone-label">中国移动认证</text>
            <text class="login__phone-value">{{ maskedDevicePhone }}</text>
          </view>
          <view class="login__safe-tag">
            <ni-icon name="shield" :size="9" state="green" />
            <text class="login__safe-tag-text">安全认证</text>
          </view>
        </view>

        <ni-button type="primary" size="xl" block :loading="submitting" icon="shield" @tap="loginOneClick">
          本机号码一键登录
        </ni-button>

        <view class="login__safe-note">
          <ni-icon name="lock" :size="12" state="tertiary" />
          <text class="login__safe-note-text">运营商安全认证，仅用于登录与邻里身份核验</text>
        </view>
      </view>

      <view v-else class="login__panel login__panel--sms">
        <view class="login__field">
          <ni-input
            v-model="phone"
            placeholder="请输入手机号"
            type="number"
            :maxlength="11"
            prefix-icon="phone"
            :height="50"
          />
        </view>
        <view class="login__code-row">
          <view class="login__code-input">
            <ni-input
              v-model="smsCode"
              placeholder="请输入 6 位验证码"
              type="number"
              :maxlength="6"
              prefix-icon="lock"
              :height="50"
            />
          </view>
          <view
            class="login__code-button"
            :class="{ 'login__code-button--disabled': countdown > 0 }"
            @click="sendCode"
          >
            <text class="login__code-button-text">{{ countdown > 0 ? `${countdown}s` : '获取验证码' }}</text>
          </view>
        </view>
        <view v-if="demoCode" class="login__demo-code">
          <text class="login__demo-code-text">开发环境验证码：{{ demoCode }}</text>
        </view>
        <ni-button type="primary" size="xl" block :loading="submitting" @tap="loginSms">
          登录 / 注册
        </ni-button>
        <view class="login__safe-note">
          <ni-icon name="lock" :size="12" state="tertiary" />
          <text class="login__safe-note-text">未注册的手机号将自动创建账号，仅限本小区及邻近小区业主</text>
        </view>
      </view>

      <view class="login__divider">
        <view class="login__divider-line" />
        <text class="login__divider-text">第三方登录</text>
        <view class="login__divider-line" />
      </view>

      <view class="login__third-party">
        <view class="login__wechat" hover-class="login__wechat--pressed" @click="loginWechat">
          <ni-icon name="wechat" :size="26" state="white" />
        </view>
        <text class="login__wechat-label">微信登录</text>
      </view>

      <view class="login__agreement">
        <view class="login__checkbox" :class="{ 'login__checkbox--checked': agreed }" @click="agreed = !agreed">
          <ni-icon v-if="agreed" name="check" :size="11" state="white" />
        </view>
        <view class="login__agreement-copy">
          <text class="login__agreement-text">我已阅读并同意</text>
          <text class="login__agreement-link" @click="openAgreement('user')">《用户协议》</text>
          <text class="login__agreement-text">和</text>
          <text class="login__agreement-link" @click="openAgreement('privacy')">《隐私政策》</text>
        </view>
      </view>

      <view class="login__footer">
        <ni-icon name="shield" :size="14" state="gold" />
        <text class="login__footer-text">实名业主社区 · 隐私守护 · 邻里互助</text>
      </view>
    </view>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="40" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, onUnmounted, ref, watch } from 'vue'
import { useUserStore } from '../../stores/user.store'
import { authService } from '../../services/auth.service'
import { useToast } from '../../composables/useToast'
import { maskPhone } from '../../utils/desensitize'
import { isPhone, isSmsCode } from '../../utils/validator'
import { APP_INFO } from '../../config/env'

const user = useUserStore()
const { toast, showToast } = useToast()

const mode = ref<'oneclick' | 'sms'>('oneclick')
const agreed = ref(false)
const phone = ref('')
const smsCode = ref('')
const countdown = ref(0)
const submitting = ref(false)
const demoCode = ref('')
let timer: any = null

// 开发环境验证码常驻提示：换手机号后旧验证码失效，先清空。
watch(phone, () => {
  demoCode.value = ''
})

const maskedDevicePhone = computed(() => maskPhone(user.profile?.phone || '13812345628'))

function ensureAgreement(): boolean {
  if (!agreed.value) {
    showToast('请先阅读并同意用户协议与隐私政策', 'alert')
    return false
  }
  return true
}

function afterLogin(): void {
  showToast('登录成功，欢迎回到邻里小栈')
  setTimeout(() => {
    uni.switchTab({ url: '/pages/home/index' })
  }, 500)
}

async function loginOneClick(): Promise<void> {
  if (!ensureAgreement() || submitting.value) return
  submitting.value = true
  try {
    await user.loginWithOneClick('mock-carrier-token')
    afterLogin()
  } catch (error) {
    showToast(error instanceof Error ? error.message : '一键登录失败', 'alert')
  } finally {
    submitting.value = false
  }
}

function startCountdown(): void {
  countdown.value = 60
  if (timer) clearInterval(timer)
  timer = setInterval(() => {
    countdown.value -= 1
    if (countdown.value <= 0) {
      countdown.value = 0
      if (timer) {
        clearInterval(timer)
        timer = null
      }
    }
  }, 1000)
}

async function sendCode(): Promise<void> {
  if (countdown.value > 0) return
  if (!isPhone(phone.value)) {
    showToast('请输入正确的手机号', 'alert')
    return
  }
  try {
    const result = await authService.sendSmsCode(phone.value)
    demoCode.value = result.mockCode ?? ''
    startCountdown()
    showToast(result.mockCode ? `验证码已发送（演示码 ${result.mockCode}）` : '验证码已发送')
  } catch (error) {
    showToast(error instanceof Error ? error.message : '发送失败', 'alert')
  }
}

async function loginSms(): Promise<void> {
  if (!ensureAgreement() || submitting.value) return
  if (!isPhone(phone.value)) {
    showToast('请输入正确的手机号', 'alert')
    return
  }
  if (!isSmsCode(smsCode.value)) {
    showToast('请输入 6 位验证码', 'alert')
    return
  }
  submitting.value = true
  try {
    await user.loginWithSms(phone.value, smsCode.value)
    afterLogin()
  } catch (error) {
    showToast(error instanceof Error ? error.message : '登录失败', 'alert')
  } finally {
    submitting.value = false
  }
}

async function loginWechat(): Promise<void> {
  if (!ensureAgreement() || submitting.value) return
  submitting.value = true
  try {
    await user.loginWithWechat('mock-wechat-code')
    afterLogin()
  } catch (error) {
    showToast(error instanceof Error ? error.message : '微信登录失败', 'alert')
  } finally {
    submitting.value = false
  }
}

function openAgreement(type: 'user' | 'privacy'): void {
  const title = type === 'user' ? '用户协议' : '隐私政策'
  const url = type === 'user' ? APP_INFO.agreementUrl : APP_INFO.privacyUrl
  uni.showModal({
    title,
    content: `${title}正式内容请访问：${url}`,
    showCancel: false,
    confirmText: '我知道了',
  })
}

onUnmounted(() => {
  if (timer) clearInterval(timer)
})
</script>

