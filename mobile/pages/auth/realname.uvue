<template>
  <scroll-view class="realname" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="realname__header">
      <ni-status-bar />
      <view class="realname__nav">
        <view class="realname__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <text class="realname__nav-title">实名认证</text>
        <view class="realname__nav-placeholder" />
      </view>
    </view>

    <view class="realname__content">
      <view class="realname__security">
        <view class="realname__security-icon">
          <ni-icon name="shield" :size="19" state="green" />
        </view>
        <view class="realname__security-copy">
          <text class="realname__security-title">信息全程加密保护</text>
          <text class="realname__security-desc">身份证信息仅用于实名核验，不在本地保存，展示时自动脱敏。</text>
        </view>
      </view>

      <view class="realname__progress">
        <view class="realname__progress-head">
          <text class="realname__progress-title">认证进度</text>
          <text class="realname__progress-value">{{ progressPercent }}%</text>
        </view>
        <ni-progress :percent="progressPercent" :height="6" color="#6BB88A" />
        <text class="realname__progress-text">{{ progressText }}</text>
      </view>

      <view class="realname__card">
        <text class="realname__card-title">上传身份证</text>
        <text class="realname__card-desc">请确保四角完整、文字清晰、无反光</text>
        <view class="realname__uploads">
          <view class="realname__upload" @click="uploadFront">
            <image v-if="frontImage" class="realname__upload-image" :src="frontImage" mode="aspectFill" />
            <template v-else>
              <ni-icon name="camera" :size="26" state="active" />
              <text class="realname__upload-title">人像面</text>
              <text class="realname__upload-desc">点击上传</text>
            </template>
            <view v-if="frontImage" class="realname__upload-check">
              <ni-icon name="check" :size="11" state="white" />
            </view>
          </view>
          <view class="realname__upload" @click="uploadBack">
            <image v-if="backImage" class="realname__upload-image" :src="backImage" mode="aspectFill" />
            <template v-else>
              <ni-icon name="image" :size="26" state="active" />
              <text class="realname__upload-title">国徽面</text>
              <text class="realname__upload-desc">点击上传</text>
            </template>
            <view v-if="backImage" class="realname__upload-check">
              <ni-icon name="check" :size="11" state="white" />
            </view>
          </view>
        </view>
      </view>

      <view class="realname__card">
        <text class="realname__card-title">人脸识别</text>
        <text class="realname__card-desc">由第三方安全 SDK 完成活体检测，平台不保存人脸照片</text>
        <view v-if="faceToken" class="realname__face-done">
          <view class="realname__face-done-icon">
            <ni-icon name="check" :size="22" state="white" />
          </view>
          <text class="realname__face-done-text">人脸识别已完成</text>
        </view>
        <ni-button v-else type="primary" size="xl" block icon="camera" @tap="verifyFace">
          开始人脸识别
        </ni-button>
      </view>

      <view class="realname__tips">
        <text class="realname__tips-title">认证说明</text>
        <text class="realname__tips-item">· 实名认证通过后才能发布物品与发起交易</text>
        <text class="realname__tips-item">· 身份证号与姓名加密存储，页面仅展示脱敏信息</text>
        <text class="realname__tips-item">· 如多次认证失败，请联系在线客服人工核验</text>
      </view>

      <ni-button
        type="primary"
        size="lg"
        block
        :loading="submitting"
        :disabled="!canSubmit"
        @tap="submit"
      >
        {{ canSubmit ? '提交实名认证' : '请完成证件与人脸识别' }}
      </ni-button>
    </view>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="40" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { useToast } from '../../composables/useToast'
import { authService } from '../../services/auth.service'
import { chooseImages } from '../../utils/image'

const { toast, showToast } = useToast()

const frontImage = ref('')
const backImage = ref('')
const faceToken = ref('')
const submitting = ref(false)

const progressPercent = computed(() => {
  let value = 0
  if (frontImage.value) value += 30
  if (backImage.value) value += 30
  if (faceToken.value) value += 25
  return Math.min(100, value)
})

const progressText = computed(() => {
  if (!frontImage.value) return '请先上传身份证人像面'
  if (!backImage.value) return '请上传身份证国徽面'
  if (!faceToken.value) return '请完成人脸识别'
  return '资料已齐全，可以提交认证'
})

const canSubmit = computed(() => Boolean(frontImage.value && backImage.value && faceToken.value))

async function uploadFront(): Promise<void> {
  try {
    const paths = await chooseImages({ count: 1 })
    if (paths.length) {
      frontImage.value = paths[0]
      showToast('身份证人像面已上传')
    }
  } catch {
    // 用户取消
  }
}

async function uploadBack(): Promise<void> {
  try {
    const paths = await chooseImages({ count: 1 })
    if (paths.length) {
      backImage.value = paths[0]
      showToast('身份证国徽面已上传')
    }
  } catch {
    // 用户取消
  }
}

function verifyFace(): void {
  uni.showModal({
    title: '人脸识别',
    content: '即将调用第三方活体检测 SDK。演示环境将模拟识别成功。',
    confirmText: '开始识别',
    success: (res) => {
      if (!res.confirm) return
      faceToken.value = `face-token-${Date.now()}`
      showToast('人脸识别已完成')
    },
  })
}

async function submit(): Promise<void> {
  if (!canSubmit.value || submitting.value) return
  submitting.value = true
  try {
    await authService.submitRealname({
      frontImage: frontImage.value,
      backImage: backImage.value,
      faceToken: faceToken.value,
    })
    showToast('实名认证已提交')
    setTimeout(() => {
      uni.redirectTo({ url: '/pages/auth/result?type=realname' })
    }, 500)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '提交失败', 'alert')
  } finally {
    submitting.value = false
  }
}

function goBack(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else uni.switchTab({ url: '/pages/profile/index' })
}
</script>

