<template>
  <scroll-view class="publish" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="publish__header">
      <ni-status-bar />
      <view class="publish__head-row">
        <view class="publish__head-copy">
          <text class="publish__kicker">{{ editingId ? '修改后需要重新质检' : '让闲置继续发光' }}</text>
          <text class="publish__title">{{ editingId ? '编辑闲置' : '发布闲置' }}</text>
        </view>
        <text class="publish__cancel" @click="onCancel">取消</text>
      </view>
    </view>

    <view v-if="!editingId" class="publish__mode">
      <view class="publish__mode-tabs">
        <view
          class="publish__mode-tab"
          :class="{ 'publish__mode-tab--active': mode === 'item' }"
          @click="mode = 'item'"
        >
          <text class="publish__mode-tab-text" :class="{ 'publish__mode-tab-text--active': mode === 'item' }">发布物品</text>
        </view>
        <view
          class="publish__mode-tab"
          :class="{ 'publish__mode-tab--active': mode === 'life' }"
          @click="mode = 'life'"
        >
          <text class="publish__mode-tab-text" :class="{ 'publish__mode-tab-text--active': mode === 'life' }">发布生活</text>
        </view>
      </view>
    </view>

    <template v-if="mode === 'item'">
      <view class="publish__steps">
        <view v-for="(label, index) in stepLabels" :key="label" class="publish__step">
          <view class="publish__step-top">
            <view
              class="publish__step-circle"
              :class="{ 'publish__step-circle--active': step >= index + 1, 'publish__step-circle--done': step > index + 1 }"
            >
              <ni-icon v-if="step > index + 1" name="check" :size="12" state="white" />
              <text v-else class="publish__step-number" :class="{ 'publish__step-number--active': step >= index + 1 }">{{ index + 1 }}</text>
            </view>
            <view v-if="index < stepLabels.length - 1" class="publish__step-line" :class="{ 'publish__step-line--active': step > index + 1 }" />
          </view>
          <text class="publish__step-label" :class="{ 'publish__step-label--active': step >= index + 1 }">{{ label }}</text>
        </view>
      </view>

      <view v-if="step === 1" class="publish__content">
        <view class="publish__card">
          <view class="publish__card-head">
            <text class="publish__card-title">添加实拍照片</text>
            <text class="publish__card-hint">至少 {{ appStore.config.minItemImages }} 张</text>
            <text class="publish__card-count">{{ draft.images.length }}/{{ appStore.config.maxItemImages }}</text>
          </view>
          <ni-photo-uploader
            v-model="draft.images"
            :max="appStore.config.maxItemImages"
            :min="appStore.config.minItemImages"
            :columns="2"
            :tile-height="105"
            tip-tile
          />
          <view class="publish__ai-tip">
            <ni-icon name="spark" :size="16" state="green" />
            <text class="publish__ai-tip-text">建议自然光下拍摄，正面、侧面、瑕疵处都要拍到，AI 质检更容易通过。</text>
          </view>
        </view>

        <view class="publish__card">
          <view class="publish__card-head">
            <text class="publish__card-title">物品标题</text>
            <text class="publish__card-hint">必填</text>
            <text class="publish__card-count">{{ draft.title.length }}/30</text>
          </view>
          <ni-input v-model="draft.title" placeholder="例如：原木儿童成长椅，九成新" :maxlength="30" :height="43" />
          <view class="publish__ai-write" @click="generateDescription">
            <ni-icon name="spark" :size="15" state="active" />
            <text class="publish__ai-write-text">上传照片后，AI 帮你写标题和描述</text>
          </view>
        </view>

        <view class="publish__card">
          <view class="publish__card-head">
            <text class="publish__card-title">交易方式</text>
            <text class="publish__card-hint">请选择一种</text>
          </view>
          <view class="publish__trade-list">
            <view
              v-for="trade in tradeOptions"
              :key="trade.value"
              class="publish__trade"
              :class="{ 'publish__trade--active': draft.tradeType === trade.value }"
              @click="selectTrade(trade.value)"
            >
              <view class="publish__trade-icon" :class="`publish__trade-icon--${trade.tone}`">
                <ni-icon :name="trade.icon" :size="17" :state="trade.iconState" />
              </view>
              <view class="publish__trade-copy">
                <text class="publish__trade-title">{{ trade.label }}</text>
                <text class="publish__trade-desc">{{ trade.desc }}</text>
              </view>
              <view class="publish__radio" :class="{ 'publish__radio--active': draft.tradeType === trade.value }">
                <view v-if="draft.tradeType === trade.value" class="publish__radio-dot" />
              </view>
            </view>
          </view>

          <view v-if="draft.tradeType === '出售'" class="publish__price">
            <text class="publish__price-symbol">¥</text>
            <input
              class="publish__price-input"
              type="digit"
              :value="draft.price"
              placeholder="0.00"
              placeholder-class="publish__price-placeholder"
              @input="onPriceInput"
            />
            <text class="publish__price-ref">邻居参考价 ¥120–¥320</text>
          </view>

          <ni-textarea
            v-if="draft.tradeType === '互换'"
            v-model="draft.barterExpect"
            placeholder="写下你希望交换的物品，例如：想换一张儿童学习椅或绘本套装"
            :maxlength="120"
            :height="70"
          />

          <view class="publish__quality">
            <view class="publish__card-head">
              <text class="publish__card-title">质量说明</text>
              <text class="publish__card-hint">必填，至少 20 字</text>
              <text class="publish__card-count">{{ draft.qualityDesc.length }}/300</text>
            </view>
            <ni-textarea
              v-model="draft.qualityDesc"
              placeholder="描述使用时长、磨损情况、配件是否齐全，让邻居更放心"
              :maxlength="300"
              :height="78"
            />
          </view>
        </view>

        <view class="publish__card publish__card--rows">
          <view class="publish__row" @click="chooseCategory">
            <text class="publish__row-label">物品分类</text>
            <text class="publish__row-value">{{ draft.category || '请选择' }}</text>
            <ni-icon name="chevron" :size="16" state="tertiary" />
          </view>
          <view class="publish__row publish__row--last" @click="chooseCondition">
            <text class="publish__row-label">物品成色</text>
            <text class="publish__row-value">{{ draft.condition || '请选择' }}</text>
            <ni-icon name="chevron" :size="16" state="tertiary" />
          </view>
        </view>

        <view class="publish__card">
          <text class="publish__card-title">更多凭证（可选）</text>
          <view class="publish__optional-row">
            <view class="publish__optional" @click="pickVideo">
              <ni-icon name="play" :size="17" state="active" />
              <text class="publish__optional-text">{{ draft.videoUrl ? '已添加视频' : '添加视频凭证' }}</text>
            </view>
            <view class="publish__optional" @click="pickInvoices">
              <ni-icon name="image" :size="17" state="active" />
              <text class="publish__optional-text">{{ draft.invoices?.length ? `已添加 ${draft.invoices.length} 张凭证` : '添加购买凭证' }}</text>
            </view>
          </view>
          <view class="publish__optional-row">
            <view class="publish__optional" @click="chooseExpectTime">
              <ni-icon name="clock" :size="17" state="active" />
              <text class="publish__optional-text">{{ draft.expectTime || '期望交易时段' }}</text>
            </view>
          </view>
          <text class="publish__optional-hint">视频 ≤ 60 秒 / 100MB；凭证仅用于品质核验，不会公开展示。</text>
        </view>
      </view>

      <view v-else class="publish__confirm">
        <view class="publish__confirm-icon">
          <ni-icon name="check" :size="34" state="white" />
        </view>
        <text class="publish__confirm-title">确认发布前，再检查一下</text>
        <text class="publish__confirm-desc">信息将提交 AI 质检与人工复核，通过后才会在小区上架。</text>

        <view class="publish__confirm-card">
          <view class="publish__confirm-item">
            <view class="publish__confirm-check"><ni-icon name="check" :size="12" state="green" /></view>
            <text class="publish__confirm-item-title">实拍照片</text>
            <text class="publish__confirm-item-value">{{ draft.images.length }} 张</text>
          </view>
          <view class="publish__confirm-item">
            <view class="publish__confirm-check"><ni-icon name="check" :size="12" state="green" /></view>
            <text class="publish__confirm-item-title">物品标题</text>
            <text class="publish__confirm-item-value">{{ draft.title }}</text>
          </view>
          <view class="publish__confirm-item">
            <view class="publish__confirm-check"><ni-icon name="check" :size="12" state="green" /></view>
            <text class="publish__confirm-item-title">交易方式</text>
            <text class="publish__confirm-item-value">{{ draft.tradeType }}{{ draft.tradeType === '出售' ? ` · ¥${draft.price}` : '' }}</text>
          </view>
          <view class="publish__confirm-item">
            <view class="publish__confirm-check"><ni-icon name="check" :size="12" state="green" /></view>
            <text class="publish__confirm-item-title">分类与成色</text>
            <text class="publish__confirm-item-value">{{ draft.category }} · {{ draft.condition }}</text>
          </view>
          <view class="publish__confirm-item publish__confirm-item--last">
            <view class="publish__confirm-check"><ni-icon name="check" :size="12" state="green" /></view>
            <text class="publish__confirm-item-title">质量说明</text>
            <text class="publish__confirm-item-value">{{ draft.qualityDesc.length }} 字</text>
          </view>
        </view>

      </view>

      <view class="publish__bottom-space" />
      <view class="publish__footer">
        <ni-button
          v-if="step === 1"
          type="primary"
          size="lg"
          block
          @tap="goNext"
        >
          下一步，确认发布
        </ni-button>
        <view v-else class="publish__footer-actions">
          <view class="publish__back" @click="step = 1">
            <text class="publish__back-text">返回修改</text>
          </view>
          <view class="publish__footer-primary">
            <ni-button
              type="primary"
              size="lg"
              block
              :loading="submitting"
              @tap="submitItem"
            >
              确认提交，进入 AI 质检
            </ni-button>
          </view>
        </view>
        <view class="publish__agreement">
          <text class="publish__agreement-text">发布即表示同意</text>
          <text class="publish__agreement-link" @click="openPublishRule">《发布规范》</text>
          <text class="publish__agreement-text">与《隐私政策》</text>
        </view>
      </view>
    </template>

    <template v-else>
      <view class="publish__content">
        <view class="publish__card">
          <text class="publish__card-title">内容形式</text>
          <view class="publish__life-types">
            <view
              class="publish__life-type"
              :class="{ 'publish__life-type--active': lifeMediaType === 'video' }"
              @click="lifeMediaType = 'video'"
            >
              <ni-icon name="play" :size="22" :state="lifeMediaType === 'video' ? 'active' : 'tertiary'" />
              <text class="publish__life-type-title">短视频</text>
              <text class="publish__life-type-desc">不超过 3 分钟</text>
              <view v-if="lifeMediaType === 'video'" class="publish__life-check"><ni-icon name="check" :size="10" state="white" /></view>
            </view>
            <view
              class="publish__life-type"
              :class="{ 'publish__life-type--active': lifeMediaType === 'gallery' }"
              @click="lifeMediaType = 'gallery'"
            >
              <ni-icon name="image" :size="22" :state="lifeMediaType === 'gallery' ? 'active' : 'tertiary'" />
              <text class="publish__life-type-title">照片集</text>
              <text class="publish__life-type-desc">最多 12 张</text>
              <view v-if="lifeMediaType === 'gallery'" class="publish__life-check"><ni-icon name="check" :size="10" state="white" /></view>
            </view>
          </view>

          <view v-if="lifeMediaType === 'video'" class="publish__life-upload" @click="pickLifeVideo">
            <ni-icon name="camera" :size="30" state="active" />
            <text class="publish__life-upload-title">{{ lifeVideo ? '已选择视频' : '拍摄或选择视频' }}</text>
            <text class="publish__life-upload-desc">支持 mp4 / mov，最长 3 分钟</text>
          </view>
          <ni-photo-uploader
            v-else
            v-model="lifeImages"
            :max="appStore.config.maxLifeImages"
            :min="1"
            :columns="3"
            :tile-height="100"
            add-text="添加照片"
          />
        </view>

        <view class="publish__card">
          <view class="publish__card-head">
            <text class="publish__card-title">标题</text>
            <text class="publish__card-hint">必填</text>
            <text class="publish__card-count">{{ lifeTitle.length }}/40</text>
          </view>
          <ni-input v-model="lifeTitle" placeholder="给这条生活动态起个标题" :maxlength="40" :height="43" />
        </view>

        <view class="publish__card">
          <view class="publish__card-head">
            <text class="publish__card-title">描述</text>
            <text class="publish__card-count">{{ lifeDescription.length }}/300</text>
          </view>
          <ni-textarea
            v-model="lifeDescription"
            placeholder="记录此刻的心情、地点或小故事…"
            :maxlength="300"
            :height="88"
          />
        </view>

        <view class="publish__card">
          <text class="publish__card-title">分类</text>
          <view class="publish__life-categories">
            <view
              v-for="category in lifeCategories"
              :key="category"
              class="publish__life-category"
              :class="{ 'publish__life-category--active': lifeCategory === category }"
              @click="lifeCategory = category"
            >
              <text class="publish__life-category-text" :class="{ 'publish__life-category-text--active': lifeCategory === category }">{{ category }}</text>
            </view>
          </view>
        </view>

        <view class="publish__life-notice">
          <ni-icon name="shield" :size="16" state="green" />
          <view class="publish__life-notice-copy">
            <text class="publish__life-notice-title">仅本小区认证业主可见</text>
            <text class="publish__life-notice-desc">发布内容将经过内容安全审核，请勿上传他人隐私或敏感信息。</text>
          </view>
        </view>
      </view>

      <view class="publish__bottom-space" />
      <view class="publish__footer">
        <ni-button type="primary" size="lg" block :loading="lifeSubmitting" @tap="submitLife">
          发布到小区生活
        </ni-button>
        <view class="publish__agreement">
          <text class="publish__agreement-text">发布即表示同意</text>
          <text class="publish__agreement-link" @click="openPublishRule">《发布规范》</text>
          <text class="publish__agreement-text">与《隐私政策》</text>
        </view>
      </view>
    </template>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="110" />
  </scroll-view>
</template>

<script setup lang="ts">
import { onMounted, onUnmounted, reactive, ref, watch } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import type { ItemDraft, LifeMediaType, TradeType } from '../../models'
import { useAppStore } from '../../stores/app.store'
import { useToast } from '../../composables/useToast'
import { useUpload } from '../../composables/useUpload'
import { itemService } from '../../services/item.service'
import { lifeService } from '../../services/life.service'
import { ITEM_CATEGORIES, ITEM_CONDITIONS, LIFE_CATEGORIES, STORAGE_KEYS } from '../../config/constants'
import { getStorage, removeStorage, setStorage } from '../../utils/storage'
import { validateItemDraft } from '../../utils/validator'
import { APP_INFO } from '../../config/env'

const appStore = useAppStore()
const { toast, showToast } = useToast()
const { prepareVideo, uploadOne, uploadMany } = useUpload()

const mode = ref<'item' | 'life'>('item')
const step = ref(1)
const stepLabels = ['物品信息', '确认发布', '审核上架']
const submitting = ref(false)
const editingId = ref('')
// 编辑时服务端返回的是可直接展示的签名 URL，提交前需按 URL 还原为对象键，避免把临时 URL 写进媒体表。
const imageKeyByUrl = ref<Record<string, string>>({})

const EMPTY_DRAFT: ItemDraft = {
  images: [],
  title: '',
  tradeType: '出售',
  price: '',
  barterExpect: '',
  condition: '',
  category: '',
  qualityDesc: '',
  videoUrl: '',
  invoices: [],
  expectTime: '',
}

const draft = reactive<ItemDraft>({ ...EMPTY_DRAFT })

const tradeOptions = [
  { value: '出售' as TradeType, label: '出售', desc: '担保支付，验货满意再放款', icon: 'wallet', iconState: 'active', tone: 'sale' },
  { value: '免费' as TradeType, label: '免费', desc: '赠予邻居，让闲置继续发光', icon: 'gift', iconState: 'green', tone: 'gift' },
  { value: '互换' as TradeType, label: '互换', desc: '以物换物，各取所需', icon: 'swap', iconState: 'blue', tone: 'swap' },
]

const lifeMediaType = ref<LifeMediaType>('gallery')
const lifeImages = ref<string[]>([])
const lifeVideo = ref('')
const lifeTitle = ref('')
const lifeDescription = ref('')
const lifeCategory = ref('邻里日常')
const lifeSubmitting = ref(false)
const lifeCategories = LIFE_CATEGORIES.filter((item) => item !== '全部')

let saveTimer: any = null

onLoad(async (options: any) => {
  if (options?.mode === 'life') mode.value = 'life'
  const editId = String(options?.editId ?? '')
  if (editId) {
    editingId.value = editId
    mode.value = 'item'
    await loadItemForEdit(editId)
  }
})

async function loadItemForEdit(id: string): Promise<void> {
  try {
    const item = await itemService.getDetail(id)
    const urls = item.images && item.images.length ? item.images : item.image ? [item.image] : []
    const keys = item.imageKeys && item.imageKeys.length ? item.imageKeys : urls
    const keyByUrl: Record<string, string> = {}
    urls.forEach((url, index) => {
      const key = keys[index]
      if (key) keyByUrl[url] = key
    })
    imageKeyByUrl.value = keyByUrl
    draft.images = urls
    draft.title = item.title
    draft.tradeType = item.type
    draft.price = Number(item.price) > 0 ? String(item.price) : ''
    draft.barterExpect = item.barterExpect ?? ''
    draft.condition = item.condition
    draft.category = item.category ?? ''
    draft.qualityDesc = item.description ?? ''
    showToast('已载入物品，修改后需要重新提交 AI 质检')
  } catch (error) {
    showToast(error instanceof Error ? error.message : '物品加载失败', 'alert')
    editingId.value = ''
  }
}

onMounted(() => {
  restoreDraft()
})

onUnmounted(() => {
  if (saveTimer) clearTimeout(saveTimer)
})

watch(
  draft,
  () => {
    if (editingId.value) return
    if (saveTimer) clearTimeout(saveTimer)
    saveTimer = setTimeout(() => {
      setStorage(STORAGE_KEYS.draftItem, { ...draft })
    }, 1000)
  },
  { deep: true },
)

function restoreDraft(): void {
  if (editingId.value) return
  const saved = getStorage<ItemDraft | null>(STORAGE_KEYS.draftItem, null)
  if (!saved) return
  const hasContent = saved.title || (saved.images && saved.images.length)
  if (!hasContent) return
  // 兼容历史草稿：旧版类目/成色与服务端枚举不一致，直接提交会被校验拒绝。
  if (saved.category && !ITEM_CATEGORIES.includes(saved.category)) saved.category = ''
  if (saved.condition && !ITEM_CONDITIONS.includes(saved.condition)) saved.condition = ''
  Object.assign(draft, saved)
  showToast('已恢复上次未完成的草稿')
}

function onPriceInput(event: any): void {
  draft.price = String(event?.detail?.value ?? '').replace(/[^\d.]/g, '')
}

function selectTrade(value: TradeType): void {
  draft.tradeType = value
}

function chooseCategory(): void {
  uni.showActionSheet({
    itemList: ITEM_CATEGORIES,
    success: (res: any) => {
      draft.category = ITEM_CATEGORIES[Number(res.tapIndex)] ?? ''
    },
  })
}

function chooseCondition(): void {
  uni.showActionSheet({
    itemList: ITEM_CONDITIONS,
    success: (res: any) => {
      draft.condition = ITEM_CONDITIONS[Number(res.tapIndex)] ?? ''
    },
  })
}

function chooseExpectTime(): void {
  const options = ['今天下午', '明天上午', '周末白天', '时间可协商']
  uni.showActionSheet({
    itemList: options,
    success: (res: any) => {
      draft.expectTime = options[Number(res.tapIndex)] ?? ''
    },
  })
}

async function pickVideo(): Promise<void> {
  try {
    const path = await prepareVideo()
    draft.videoUrl = path
    showToast('视频凭证已添加')
  } catch {
    showToast('未选择视频', 'alert')
  }
}

async function pickInvoices(): Promise<void> {
  try {
    const paths = await new Promise<string[]>((resolve, reject) => {
      uni.chooseImage({
        count: 5,
        sizeType: ['compressed'],
        sourceType: ['album', 'camera'],
        success: (res: any) => resolve(res.tempFilePaths ?? []),
        fail: reject,
      })
    })
    draft.invoices = [...(draft.invoices ?? []), ...paths].slice(0, 5)
    showToast('购买凭证已添加')
  } catch {
    // 用户取消
  }
}

async function generateDescription(): Promise<void> {
  if (!draft.images.length) {
    showToast('请先上传照片，AI 才能帮你写描述', 'alert')
    return
  }
  if (!draft.title.trim()) {
    draft.title = '九成新闲置好物，邻居自用'
  }
  if (draft.qualityDesc.length < 20) {
    draft.qualityDesc = '家中自用，整体保养良好，功能正常。照片为近期实拍，细节可随时私信了解，欢迎同小区邻居当面验货。'
  }
  showToast('AI 已生成标题与描述草稿，请确认后发布')
}

function goNext(): void {
  const validation = validateItemDraft({ ...draft })
  if (!validation.valid) {
    showToast(Object.values(validation.errors)[0], 'alert')
    return
  }
  step.value = 2
}

/**
 * 端侧照片 → 媒体对象键：
 * - 编辑时已存在的照片按原始对象键回传，避免把会过期的签名 URL 写回服务端；
 * - 新增照片先上传到对象存储，再提交对象键。
 */
async function resolveImageKeys(): Promise<string[]> {
  const keys: string[] = []
  for (const image of draft.images) {
    const existing = imageKeyByUrl.value[image]
    if (existing) {
      keys.push(existing)
      continue
    }
    keys.push(await uploadOne(image, 'ITEM_IMAGE'))
  }
  return keys
}

async function submitItem(): Promise<void> {
  if (submitting.value) return
  const validation = validateItemDraft({ ...draft })
  if (!validation.valid) {
    showToast(Object.values(validation.errors)[0], 'alert')
    if (Object.keys(validation.errors).length > 0) {
      step.value = 1
    }
    return
  }
  submitting.value = true
  try {
    const payload = { ...draft, images: await resolveImageKeys() }
    let targetId = editingId.value
    if (editingId.value) {
      await itemService.update(editingId.value, payload)
      await itemService.submit(editingId.value)
    } else {
      const created = await itemService.publish(payload)
      targetId = created.id
      removeStorage(STORAGE_KEYS.draftItem)
    }
    showToast('已提交 AI 质检')
    setTimeout(() => {
      uni.redirectTo({ url: `/pages/item/audit?id=${targetId}` })
    }, 500)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '提交失败', 'alert')
  } finally {
    submitting.value = false
  }
}

async function pickLifeVideo(): Promise<void> {
  try {
    const path = await prepareVideo()
    lifeVideo.value = path
    showToast('视频已选择')
  } catch {
    showToast('未选择视频', 'alert')
  }
}

async function submitLife(): Promise<void> {
  if (lifeSubmitting.value) return
  if (lifeMediaType.value === 'video' && !lifeVideo.value) {
    showToast('请先选择视频', 'alert')
    return
  }
  if (lifeMediaType.value === 'gallery' && lifeImages.value.length === 0) {
    showToast('请先添加照片', 'alert')
    return
  }
  if (!lifeTitle.value.trim()) {
    showToast('请填写标题', 'alert')
    return
  }
  lifeSubmitting.value = true
  try {
    // 相册/相机返回的是本地临时路径，必须先上传到对象存储，
    // 服务端只保存对象键，展示时再签发可访问 URL。
    showToast('正在上传媒体文件…')
    const media = lifeMediaType.value === 'video'
      ? [await uploadOne(lifeVideo.value, 'LIFE_VIDEO')]
      : await uploadMany(lifeImages.value, 'PUBLIC_IMAGE')
    await lifeService.publish({
      mediaType: lifeMediaType.value,
      media,
      title: lifeTitle.value.trim(),
      description: lifeDescription.value.trim(),
      category: lifeCategory.value as any,
    })
    showToast('生活动态已提交审核')
    setTimeout(() => {
      uni.navigateTo({ url: '/pages/life/mine' })
    }, 500)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '发布失败', 'alert')
  } finally {
    lifeSubmitting.value = false
  }
}

function onCancel(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else uni.switchTab({ url: '/pages/home/index' })
}

function openPublishRule(): void {
  uni.showModal({
    title: '发布规范',
    content: `发布物品须真实、合法、无侵权；禁止发布违禁品与虚假信息。完整规范请访问：${APP_INFO.publishRuleUrl}`,
    showCancel: false,
    confirmText: '我知道了',
  })
}
</script>

