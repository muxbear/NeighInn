  width: 42px;
  height: 42px;
  align-items: center;
  justify-content: center;
}
.report__nav-title {
  flex: 1;
  text-align: center;
  font-size: $ni-font-16;
  font-weight: 700;
  color: $ni-color-text-primary;
}
