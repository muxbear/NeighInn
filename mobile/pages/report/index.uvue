  font-size: $ni-font-11;
  font-weight: 600;
  color: $ni-color-danger-deep;
}
.report__target-desc {
  margin-top: 2px;
  font-size: $ni-font-9;
  color: #9a6a55;
}
.report__card {
  margin-top: 10px;
  padding: 14px;
  border-radius: $ni-radius-16;
  background-color: $ni-color-white;
  box-shadow: $ni-shadow-card;
}
.report__card-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 9px;
}
.report__card-title {
  font-size: $ni-font-14;
  font-weight: 700;
  color: $ni-color-text-primary;
}
.report__card-desc {
  margin-top: 3px;
  margin-bottom: 9px;
  font-size: $ni-font-9;
  color: $ni-color-text-tertiary;
}
.report__count {
  font-size: $ni-font-8;
  color: $ni-color-text-tertiary;
}
.report__reasons {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 10px;
}
.report__reason {
  height: 32px;
  padding-left: 11px;
  padding-right: 11px;
  border-radius: 10px;
  background-color: $ni-color-fill-2;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
  margin-bottom: 8px;
}
.report__reason--active {
  background-color: $ni-color-danger-bg;
  border: 1px solid #f2b79f;
}
.report__reason-text {
  font-size: $ni-font-9;
  color: $ni-color-text-secondary;
}
.report__reason-text--active {
  color: $ni-color-danger-deep;
  font-weight: 700;
}
.report__tip {
  flex-direction: row;
  align-items: flex-start;
  padding: 10px;
  border-radius: $ni-radius-11;
  background-color: #fff8e8;
  margin-top: 10px;
  margin-bottom: 14px;
}
.report__tip-text {
  flex: 1;
  margin-left: 5px;
  font-size: 7px;
