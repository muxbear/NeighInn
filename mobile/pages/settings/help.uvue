  padding-right: 12px;
  border-radius: 10px;
  background-color: $ni-color-fill-2;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
  margin-bottom: 8px;
}
.feedback__type--active {
  background-color: $ni-color-primary-bg;
  border: 1px solid #ffb58b;
}
.feedback__type-text {
  font-size: $ni-font-10;
  color: $ni-color-text-secondary;
}
.feedback__type-text--active {
  color: $ni-color-primary-dark;
  font-weight: 700;
}
