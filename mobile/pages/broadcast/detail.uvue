<template>
  <scroll-view class="broadcast-detail" :class="`broadcast-detail--${tone}`" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="broadcast-detail__header" :class="`broadcast-detail__header--${tone}`">
      <ni-status-bar />
      <view class="broadcast-detail__nav">
        <view class="broadcast-detail__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <text class="broadcast-detail__nav-title">小区喇叭站</text>
        <view class="broadcast-detail__nav-button" @click="onShare">
          <ni-icon name="share" :size="18" state="secondary" />
        </view>
      </view>

      <template v-if="broadcast">
        <view class="broadcast-detail__hero">
          <view class="broadcast-detail__hero-icon" :class="`broadcast-detail__hero-icon--${tone}`">
            <ni-icon :name="broadcast.icon" :size="31" :state="heroIconState" />
          </view>
          <view class="broadcast-detail__type" :class="`broadcast-detail__type--${tone}`">
            <text class="broadcast-detail__type-text" :class="`broadcast-detail__type-text--${tone}`">{{ broadcast.type }}</text>
          </view>
          <text class="broadcast-detail__title">{{ broadcast.title }}</text>
          <text class="broadcast-detail__desc">{{ broadcast.detail }}</text>
          <view class="broadcast-detail__source">
            <ni-icon name="megaphone" :size="14" state="tertiary" />
            <text class="broadcast-detail__source-text">{{ broadcast.publisher?.name || '邻里小栈' }} · {{ broadcast.meta }}</text>
          </view>
        </view>
      </template>
    </view>

    <template v-if="broadcast">
      <view class="broadcast-detail__facts">
        <view v-for="fact in facts" :key="fact.label" class="broadcast-detail__fact">
          <ni-icon :name="fact.icon" :size="18" :state="heroIconState" />
          <text class="broadcast-detail__fact-label">{{ fact.label }}</text>
          <text class="broadcast-detail__fact-value">{{ fact.value }}</text>
        </view>
      </view>

      <view class="broadcast-detail__card">
        <text class="broadcast-detail__card-title">详细说明</text>
        <text class="broadcast-detail__card-body">{{ broadcast.description || broadcast.detail }}</text>
        <view class="broadcast-detail__tip" :class="`broadcast-detail__tip--${tone}`">
          <ni-icon name="shield" :size="14" :state="tipIconState" />
          <text class="broadcast-detail__tip-text" :class="`broadcast-detail__tip-text--${tone}`">{{ broadcast.tip || '请在小区公共区域交接，注意保护个人隐私。' }}</text>
        </view>
      </view>

      <view v-if="broadcast.publisher" class="broadcast-detail__card broadcast-detail__publisher-card">
        <view class="broadcast-detail__publisher">
          <ni-avatar :src="broadcast.publisher.avatar" :name="broadcast.publisher.name" :size="43" variant="orange" />
          <view class="broadcast-detail__publisher-copy">
            <view class="broadcast-detail__publisher-row">
              <text class="broadcast-detail__publisher-name">{{ broadcast.publisher.name }}</text>
              <ni-icon v-if="broadcast.publisher.verified" name="shield" :size="9" state="gold" />
              <text class="broadcast-detail__publisher-verified">认证业主</text>
            </view>
            <text class="broadcast-detail__publisher-meta">发布者 · 阳光花园小区</text>
          </view>
          <view class="broadcast-detail__message" @click="onChat">
            <ni-icon name="message" :size="14" state="active" />
            <text class="broadcast-detail__message-text">私信</text>
          </view>
        </view>
      </view>

      <view class="broadcast-detail__card broadcast-detail__responses" @click="onRespond">
        <view class="broadcast-detail__avatar-stack">
          <ni-avatar
            v-for="(avatar, index) in responderAvatars"
            :key="avatar + index"
            :src="avatar"
            :name="'邻'"
            :size="27"
            variant="green"
            :class="{ 'broadcast-detail__stack-avatar--gap': index > 0 }"
          />
        </view>
        <view class="broadcast-detail__response-copy">
          <text class="broadcast-detail__response-title">已有 {{ broadcast.responseCount || 0 }} 位邻居响应</text>
          <text class="broadcast-detail__response-desc">邻居就在身边，互相搭把手</text>
        </view>
        <ni-icon name="chevron" :size="15" state="tertiary" />
      </view>

      <view class="broadcast-detail__safety">
        <ni-icon name="shield" :size="16" state="gold" />
        <text class="broadcast-detail__safety-text">平台建议：接送、上门等服务请在物业登记；不要向陌生人透露门牌号与验证码。</text>
      </view>

      <view class="broadcast-detail__bottom-space" />

      <view class="broadcast-detail__bar">
        <view class="broadcast-detail__favorite" @click="onFavorite">
          <ni-icon name="heart" :size="21" :state="broadcast.favorited ? 'active' : 'secondary'" :filled="broadcast.favorited" />
          <text class="broadcast-detail__favorite-text">{{ broadcast.favorited ? '已收藏' : '收藏' }}</text>
        </view>
        <view class="broadcast-detail__primary">
          <ni-button
            :type="tone === 'free' ? 'gift' : tone === 'reward' ? 'gold' : 'primary'"
            size="lg"
            block
            @tap="onRespond"
          >
            {{ broadcast.action }}
          </ni-button>
        </view>
      </view>
    </template>

    <view v-else-if="loading" class="broadcast-detail__loading">
      <ni-skeleton :rows="4" :avatar="false" />
    </view>

    <view v-else class="broadcast-detail__error">
      <ni-empty icon="megaphone" title="播报不存在或已结束" desc="去首页看看邻里的最新动态吧" action-text="返回首页" @action="goHome" />
    </view>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="90" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad, onShareAppMessage } from '@dcloudio/uni-app'
import type { Broadcast } from '../../models'
import { useNotificationStore } from '../../stores/notification.store'
import { useToast } from '../../composables/useToast'
import { useIM } from '../../composables/useIM'
import { notificationService } from '../../services/notification.service'

const notificationStore = useNotificationStore()
const { toast, showToast } = useToast()
const { openChat } = useIM()

const broadcastId = ref('')
const broadcast = ref<Broadcast | null>(null)
const loading = ref(true)

const tone = computed(() => broadcast.value?.tone ?? 'urgent')
const heroIconState = computed(() => {
  if (tone.value === 'free') return 'green'
  if (tone.value === 'reward') return 'gold'
  if (tone.value === 'urgent') return 'danger'
  return 'active'
})
const tipIconState = computed(() => 'gold')
const facts = computed(() => {
  if (!broadcast.value) return []
  if (broadcast.value.facts && broadcast.value.facts.length) return broadcast.value.facts
  return [
    { icon: 'clock', label: '时间', value: '今天 17:20' },
    { icon: 'pin', label: '地点', value: '小区北门' },
    { icon: 'friend', label: '邻里', value: '认证业主' },
  ]
})
const responderAvatars = computed(() => broadcast.value?.responderAvatars ?? [])

onShareAppMessage(() => ({
  title: broadcast.value?.title ?? '邻里小栈 · 小区喇叭站',
  path: `/pages/broadcast/detail?id=${broadcastId.value}`,
}))

onLoad(async (options: any) => {
  broadcastId.value = String(options?.id ?? '')
  if (!broadcastId.value) {
    loading.value = false
    return
  }
  try {
    broadcast.value = await notificationStore.fetchBroadcastDetail(broadcastId.value)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '加载失败', 'alert')
  } finally {
    loading.value = false
  }
})

function goBack(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else uni.switchTab({ url: '/pages/home/index' })
}
function goHome(): void {
  uni.switchTab({ url: '/pages/home/index' })
}

async function onFavorite(): Promise<void> {
  if (!broadcast.value) return
  try {
    await notificationStore.toggleBroadcastFavorite(broadcast.value.id)
    showToast(broadcast.value.favorited ? '已收藏' : '已取消收藏')
  } catch (error) {
    showToast(error instanceof Error ? error.message : '操作失败', 'alert')
  }
}

async function onRespond(): Promise<void> {
  if (!broadcast.value) return
  try {
    const result = await notificationService.respondBroadcast(broadcast.value.id)
    broadcast.value.responseCount = result.responseCount
    showToast('已响应，发布者会收到提醒')
  } catch (error) {
    showToast(error instanceof Error ? error.message : '响应失败', 'alert')
  }
}

function onChat(): void {
  const publisher = broadcast.value?.publisher
  if (!publisher) return
  openChat(publisher.id, broadcast.value?.id).catch((error) => {
    showToast(error instanceof Error ? error.message : '打开会话失败', 'alert')
  })
}

function onShare(): void {
  if (!broadcast.value) return
  uni.setClipboardData({
    data: `https://www.neighinn.com/broadcast/${broadcast.value.id}`,
    success: () => showToast('播报链接已复制'),
  })
}
</script>

