  justify-content: center;
}
.odetail__appointment-copy {
  flex: 1;
  margin-left: 8px;
}
.odetail__appointment-time {
  font-size: $ni-font-12;
  font-weight: 700;
  color: $ni-color-text-primary;
}
.odetail__appointment-place {
  margin-top: 2px;
  font-size: $ni-font-9;
  color: $ni-color-text-secondary;
}
.odetail__appointment-actions {
  margin-top: 9px;
}
.odetail__appointment-action {
  height: 34px;
  border-radius: 10px;
  background-image: $ni-gradient-brand;
  align-items: center;
  justify-content: center;
}
.odetail__appointment-action-text {
  font-size: $ni-font-10;
  font-weight: 700;
  color: #ffffff;
}
.odetail__info-row {
  min-height: 42px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-bottom: $ni-border-divider;
}
