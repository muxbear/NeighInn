  background-color: $ni-color-fill-2;
}
.odetail__status--danger {
  background-color: $ni-color-danger-bg;
}
.odetail__status-icon {
  width: 46px;
  height: 46px;
  border-radius: 15px;
  background-color: rgba(255, 255, 255, 0.22);
  align-items: center;
  justify-content: center;
}
.odetail__status-copy {
  flex: 1;
  margin-left: 10px;
}
.odetail__status-title {
  font-size: $ni-font-20;
  font-weight: 700;
  color: $ni-color-text-primary;
}
.odetail__status-title--light {
  color: #ffffff;
}
.odetail__status-desc {
  margin-top: 3px;
  font-size: $ni-font-9;
  line-height: 15px;
  color: $ni-color-text-secondary;
}
.odetail__status-desc--light {
  color: rgba(255, 255, 255, 0.88);
}
.odetail__card {
  margin: 10px 14px 0;
  padding: 14px;
  border-radius: $ni-radius-16;
