  border-bottom: 0;
}
.odetail__info-label {
  font-size: $ni-font-10;
  color: $ni-color-text-tertiary;
}
.odetail__info-value {
  font-size: $ni-font-10;
  font-weight: 600;
  color: $ni-color-text-primary;
}
.odetail__peer {
  flex-direction: row;
  align-items: center;
}
.odetail__peer-name {
  margin-left: 5px;
  margin-right: 5px;
  font-size: $ni-font-10;
  font-weight: 600;
  color: $ni-color-text-primary;
}
.odetail__timeline {
  margin-top: 12px;
}
.odetail__timeline-item {
  flex-direction: row;
  align-items: flex-start;
  min-height: 44px;
}
.odetail__timeline-left {
  width: 18px;
  align-items: center;
}
.odetail__timeline-dot {
  width: 18px;
  height: 18px;
  border-radius: 9px;
  background-color: #eee9e4;
  align-items: center;
