  background-color: $ni-color-gift-bg;
}
.orders__category-icon--swap {
  background-color: $ni-color-swap-bg;
}
.orders__category-icon--monetary {
  background-color: $ni-color-primary-bg;
}
.orders__category-title {
  font-size: $ni-font-9;
  color: $ni-color-text-secondary;
}
.orders__category-title--active {
  color: $ni-color-text-primary;
  font-weight: 700;
}
