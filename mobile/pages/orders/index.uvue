<template>
  <scroll-view class="orders" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="orders__header">
      <ni-status-bar />
      <view class="orders__nav">
        <view class="orders__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <view class="orders__nav-center">
          <text class="orders__nav-title">我的订单</text>
          <text class="orders__nav-sub">担保交易 · 赠与 · 互换</text>
        </view>
        <view class="orders__help" @click="goHelp">
          <ni-icon name="message" :size="19" state="secondary" />
        </view>
      </view>
    </view>

    <view class="orders__categories">
      <view
        v-for="category in categories"
        :key="category.key"
        class="orders__category"
        :class="{ 'orders__category--active': activeType === category.key }"
        @click="switchType(category.key)"
      >
        <view class="orders__category-icon" :class="`orders__category-icon--${category.key}`">
          <ni-icon :name="category.icon" :size="18" :state="category.key === 'free' ? 'green' : category.key === 'swap' ? 'blue' : 'active'" />
        </view>
        <text class="orders__category-title" :class="{ 'orders__category-title--active': activeType === category.key }">{{ category.label }}</text>
        <text class="orders__category-count">{{ countOf(category.key) }} 单</text>
      </view>
    </view>

    <view class="orders__body">
      <view class="orders__head">
        <view class="orders__head-copy">
          <text class="orders__head-title">{{ activeLabel }}</text>
          <text class="orders__head-sub">订单状态会通过消息与通知实时同步</text>
        </view>
        <text class="orders__refresh" @click="refresh">刷新</text>
      </view>

      <view v-if="loading && orders.length === 0" class="orders__loading">
        <ni-skeleton :rows="4" :avatar="false" />
      </view>

      <view v-else-if="orders.length === 0" class="orders__empty">
        <ni-empty
          :icon="activeIcon"
          :title="`还没有${activeLabel}`"
          desc="去首页看看邻居分享的好物吧"
          action-text="去逛逛"
          @action="goHome"
        />
      </view>

      <view v-else class="orders__list">
        <order-card
          v-for="order in orders"
          :key="order.id"
          :order="order"
          @contact="onContact(order)"
          @detail="openDetail(order.id)"
        />
      </view>

      <view class="orders__safety">
        <ni-icon name="shield" :size="15" state="gold" />
        <text class="orders__safety-text">担保交易请通过平台支付，线下验货满意后再确认放款；切勿私下转账。</text>
      </view>
    </view>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="40" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad, onPullDownRefresh } from '@dcloudio/uni-app'
import type { Order } from '../../models'
import { useOrderStore } from '../../stores/order.store'
import { useToast } from '../../composables/useToast'
import { useIM } from '../../composables/useIM'
import { ORDER_CATEGORIES } from '../../config/constants'

type OrderType = 'free' | 'swap' | 'monetary'

const orderStore = useOrderStore()
const { toast, showToast } = useToast()
const { openChat } = useIM()

const categories = ORDER_CATEGORIES
const activeType = ref<OrderType>('monetary')
const loading = computed(() => orderStore.loading)

const orders = computed<Order[]>(() => orderStore.ordersByType[activeType.value] ?? [])
const activeLabel = computed(() => categories.find((item) => item.key === activeType.value)?.label ?? '订单')
const activeIcon = computed(() => categories.find((item) => item.key === activeType.value)?.icon ?? 'box')

onLoad((options: any) => {
  const requested = String(options?.type ?? 'monetary')
  if (requested === 'free' || requested === 'swap' || requested === 'monetary') {
    activeType.value = requested
  }
  loadAll()
})

onPullDownRefresh(async () => {
  try {
    await loadAll()
  } finally {
    uni.stopPullDownRefresh()
  }
})

async function loadAll(): Promise<void> {
  await Promise.all([
    orderStore.fetchOrders('free', true).catch(() => undefined),
    orderStore.fetchOrders('swap', true).catch(() => undefined),
    orderStore.fetchOrders('monetary', true).catch(() => undefined),
  ])
}

async function refresh(): Promise<void> {
  await loadAll()
  showToast('订单已刷新')
}

function countOf(type: string): number {
  return orderStore.ordersByType[type as OrderType]?.length ?? 0
}

function switchType(type: OrderType): void {
  activeType.value = type
}

function openDetail(id: string): void {
  uni.navigateTo({ url: `/pages/orders/detail?id=${id}` })
}

async function onContact(order: Order): Promise<void> {
  const peerId = order.role === 'buyer' ? order.seller.id : order.buyer.id
  try {
    await openChat(peerId)
  } catch (error) {
    showToast(error instanceof Error ? error.message : '打开会话失败', 'alert')
  }
}

function goBack(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else uni.switchTab({ url: '/pages/profile/index' })
}
function goHelp(): void {
  uni.navigateTo({ url: '/pages/settings/help' })
}
function goHome(): void {
  uni.switchTab({ url: '/pages/home/index' })
}
</script>

