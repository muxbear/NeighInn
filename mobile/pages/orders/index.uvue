  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
}
.orders__category--active {
  background-color: #ffffff;
  box-shadow: 0 1px 5px rgba(60, 45, 35, 0.09);
}
.orders__category-icon {
  width: 30px;
  height: 30px;
  border-radius: 10px;
  align-items: center;
  justify-content: center;
  margin-right: 5px;
}
