<template>
  <scroll-view class="zone" :class="`zone--${zoneKey}`" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="zone__header" :class="`zone__header--${tone}`">
      <ni-status-bar />
      <view class="zone__nav">
        <view class="zone__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <text class="zone__nav-title">{{ zoneConfig.name }}</text>
        <view class="zone__nav-actions">
          <view class="zone__nav-button zone__nav-button--action" @click="goSearch">
            <ni-icon name="search" :size="18" state="secondary" />
          </view>
          <view class="zone__nav-button zone__nav-button--action" @click="openSettings">
            <ni-icon name="settings" :size="18" state="secondary" />
          </view>
        </view>
      </view>

      <view class="zone__hero">
        <view class="zone__hero-icon" :class="`zone__hero-icon--${tone}`">
          <ni-icon :name="zoneConfig.icon" :size="30" :state="heroIconState" />
        </view>
        <view class="zone__hero-copy">
          <text class="zone__hero-title">{{ zoneConfig.name }}</text>
          <text class="zone__hero-sub">{{ zoneConfig.description }}</text>
          <text class="zone__hero-meta">阳光花园小区 · 认证业主专属 · 2,138 位认证邻里</text>
        </view>
      </view>
    </view>

    <view class="zone__sticky" :style="{ top: statusBarHeight + 'px' }">
      <scroll-view class="zone__tabs-scroll" scroll-x :show-scrollbar="false">
        <view class="zone__tabs">
          <view
            v-for="category in categories"
            :key="category"
            class="zone__tab"
            @click="selectCategory(category)"
          >
            <text class="zone__tab-text" :class="{ 'zone__tab-text--active': activeCategory === category }">{{ category }}</text>
            <view v-if="activeCategory === category" class="zone__tab-line" />
          </view>
        </view>
      </scroll-view>
    </view>

    <template v-if="zoneKey !== 'service'">
      <view class="zone__body">
        <view class="zone__body-head">
          <view class="zone__body-title-row">
            <text class="zone__body-title">{{ listTitle }}</text>
            <view class="zone__verified">
              <ni-icon name="shield" :size="11" state="green" />
              <text class="zone__verified-text">业主已认证</text>
            </view>
          </view>
          <text class="zone__sort" @click="chooseSort">{{ activeSort }}</text>
        </view>

        <view v-if="loading && zoneItems.length === 0" class="zone__loading">
          <ni-skeleton :rows="4" :avatar="false" />
        </view>

        <view v-else-if="zoneItems.length === 0" class="zone__empty">
          <ni-empty
            :icon="zoneConfig.icon"
            :title="`还没有${zoneConfig.name}物品`"
            desc="成为第一个分享的邻居吧"
            action-text="去发布"
            @action="goPublish"
          />
        </view>

        <view v-else class="zone__grid">
          <view
            v-for="(item, index) in zoneItems"
            :key="item.id"
            class="zone__cell"
            :class="{ 'zone__cell--gap': index % 2 === 0 }"
          >
            <product-card :item="item" @tap="goItem(item.id)" @favorite="onFavorite(item)" />
          </view>
        </view>

        <view v-if="zoneItems.length > 0" class="zone__load-more" @click="loadMore">
          <ni-loading v-if="loading" :size="16" text="正在加载" />
          <template v-else>
            <view class="zone__load-line" />
            <text class="zone__load-text">{{ hasMore ? '继续向下滑动，加载更多' : '专属区的好物都在这里了' }}</text>
            <view class="zone__load-line" />
          </template>
        </view>
      </view>
    </template>

    <template v-else>
      <view class="zone__service-body">
        <view class="zone__service-tabs">
          <view
            class="zone__service-tab"
            :class="{ 'zone__service-tab--active': serviceKind === '求助' }"
            @click="switchServiceKind('求助')"
          >
            <text class="zone__service-tab-title" :class="{ 'zone__service-tab-title--active': serviceKind === '求助' }">邻里求助</text>
            <text class="zone__service-tab-sub">需要邻居帮忙</text>
          </view>
          <view
            class="zone__service-tab"
            :class="{ 'zone__service-tab--active offer': serviceKind === '提供' }"
            @click="switchServiceKind('提供')"
          >
            <text class="zone__service-tab-title" :class="{ 'zone__service-tab-title--active': serviceKind === '提供' }">邻里服务</text>
            <text class="zone__service-tab-sub">可以提供的帮助</text>
          </view>
        </view>

        <view class="zone__service-head">
          <view class="zone__service-head-copy">
            <text class="zone__service-title">{{ serviceKind === '求助' ? '等你搭把手' : '邻居可以提供' }}</text>
            <text class="zone__service-sub">{{ serviceKind === '求助' ? '力所能及，温暖就在身边' : '发现身边可靠的服务与陪伴' }}</text>
          </view>
          <view class="zone__service-publish" @click="openServicePublish">
            <ni-icon name="plus" :size="12" state="white" />
            <text class="zone__service-publish-text">发布</text>
          </view>
        </view>

        <view v-if="services.length === 0" class="zone__empty">
          <ni-empty icon="friend" title="暂时没有互助信息" desc="邻里之间，互相搭把手" />
        </view>

        <view v-else class="zone__service-list">
          <service-card
            v-for="post in services"
            :key="post.id"
            :post="post"
            fluid
            @tap="onServiceOpen(post)"
            @respond="onServiceRespond(post)"
          />
        </view>

        <view v-if="services.length > 0" class="zone__load-more" @click="loadMore">
          <view class="zone__load-line" />
          <text class="zone__load-text">{{ serviceHasMore ? '继续向下滑动，加载更多' : '邻里互助信息都在这里了' }}</text>
          <view class="zone__load-line" />
        </view>

        <view class="zone__safety">
          <ni-icon name="shield" :size="15" state="gold" />
          <text class="zone__safety-text">邻里互助请在小区公共区域进行，涉及上门服务请提前在物业登记。</text>
        </view>
      </view>
    </template>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="40" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad, onReachBottom } from '@dcloudio/uni-app'
import type { Item, ServiceKind, ServicePost, ZoneKey } from '../../models'
import { useItemStore } from '../../stores/item.store'
import { useToast } from '../../composables/useToast'
import { useSystemMetrics } from '../../composables/useSystemMetrics'
import {
  ITEM_CATEGORIES,
  SERVICE_CATEGORIES,
  SORT_OPTIONS,
  ZONE_MAP,
} from '../../config/constants'
import { serviceService } from '../../services/service.service'

const itemStore = useItemStore()
const { toast, showToast } = useToast()
const { statusBarHeight } = useSystemMetrics()

const zoneKey = ref<ZoneKey>('gift')
const activeCategory = ref('全部')
const activeSort = ref('最新发布')
const serviceKind = ref<ServiceKind>('求助')
const serviceCategory = ref('全部')
const allServices = ref<ServicePost[]>([])
const visibleServiceCount = ref(4)

const zoneConfig = computed(() => ZONE_MAP[zoneKey.value])
const tone = computed(() => zoneConfig.value.tone)
const heroIconState = computed(() => {
  if (tone.value === 'gift') return 'green'
  if (tone.value === 'swap') return 'blue'
  if (tone.value === 'service') return 'gold'
  return 'active'
})
const categories = computed(() =>
  zoneKey.value === 'service' ? ['全部', ...SERVICE_CATEGORIES.slice(1)] : ['全部', ...ITEM_CATEGORIES],
)
const listTitle = computed(() => {
  if (zoneKey.value === 'gift') return '邻居正在赠送'
  if (zoneKey.value === 'swap') return '邻居正在交换'
  return '邻居正在出售'
})
const zoneItems = computed(() => itemStore.getZoneItems(zoneKey.value, activeCategory.value, activeSort.value))
const totalCount = computed(() => itemStore.getZoneTotal(zoneKey.value, activeCategory.value, activeSort.value) || zoneItems.value.length)
const loading = computed(() => itemStore.isLoadingZone(zoneKey.value, activeCategory.value, activeSort.value))
const hasMore = computed(() => itemStore.hasMoreZone(zoneKey.value, activeCategory.value, activeSort.value))
const services = computed(() => allServices.value.slice(0, visibleServiceCount.value))
const serviceHasMore = computed(
  () => visibleServiceCount.value < Math.min(12, allServices.value.length),
)

onLoad((options: any) => {
  const requested = String(options?.zone ?? 'gift')
  if (requested === 'swap' || requested === 'sale' || requested === 'service') {
    zoneKey.value = requested
  }
  loadInitial()
})

onReachBottom(() => {
  loadMore()
})

async function loadInitial(): Promise<void> {
  if (zoneKey.value === 'service') {
    await loadServices()
    return
  }
  await itemStore.fetchZone(zoneKey.value, {
    category: activeCategory.value,
    sort: activeSort.value,
    refresh: true,
  })
}

async function loadServices(): Promise<void> {
  const result = await serviceService.getList(serviceKind.value, serviceCategory.value, 1, 50)
  allServices.value = result.list
  visibleServiceCount.value = 4
}

async function loadMore(): Promise<void> {
  if (zoneKey.value === 'service') {
    if (!serviceHasMore.value) return
    visibleServiceCount.value = Math.min(12, visibleServiceCount.value + 4)
    return
  }
  if (loading.value || !hasMore.value) return
  await itemStore.fetchZone(zoneKey.value, {
    category: activeCategory.value,
    sort: activeSort.value,
    refresh: false,
  })
}

async function selectCategory(category: string): Promise<void> {
  activeCategory.value = category
  if (zoneKey.value === 'service') {
    serviceCategory.value = category
    await loadServices()
  } else {
    await itemStore.fetchZone(zoneKey.value, {
      category,
      sort: activeSort.value,
      refresh: true,
    })
  }
}

async function switchServiceKind(kind: ServiceKind): Promise<void> {
  if (serviceKind.value === kind) return
  serviceKind.value = kind
  await loadServices()
}

function chooseSort(): void {
  uni.showActionSheet({
    itemList: [...SORT_OPTIONS],
    success: async (res: any) => {
      const index = Number(res.tapIndex) || 0
      activeSort.value = SORT_OPTIONS[index] ?? SORT_OPTIONS[0]
      await itemStore.fetchZone(zoneKey.value, {
        category: activeCategory.value,
        sort: activeSort.value,
        refresh: true,
      })
    },
  })
}

function goBack(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else uni.switchTab({ url: '/pages/home/index' })
}
function goSearch(): void {
  uni.navigateTo({ url: '/pages/home/search' })
}
function goPublish(): void {
  uni.navigateTo({ url: '/pages/publish/index' })
}
function openServicePublish(): void {
  showToast('邻里互助发布将在后续版本开放')
}
function goItem(id: string): void {
  uni.navigateTo({ url: `/pages/item/detail?id=${id}` })
}
function openSettings(): void {
  showToast('专属区设置即将开放')
}

async function onFavorite(item: Item): Promise<void> {
  try {
    await itemStore.toggleFavorite(item)
    showToast(item.favorite ? '已收藏' : '已取消收藏')
  } catch (error) {
    showToast(error instanceof Error ? error.message : '操作失败', 'alert')
  }
}

function onServiceOpen(post: ServicePost): void {
  showToast(`${post.author} · ${post.category}`)
}

async function onServiceRespond(post: ServicePost): Promise<void> {
  try {
    const result = await serviceService.respond(post.id)
    post.responses = result.responses
    showToast(post.kind === '求助' ? '已响应，等待邻居联系' : '已发送咨询，请留意消息')
  } catch (error) {
    showToast(error instanceof Error ? error.message : '操作失败', 'alert')
  }
}
</script>

