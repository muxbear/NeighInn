<template>
  <scroll-view class="credit-page" direction="vertical" :show-scrollbar="false" style="flex: 1; height: 1px;">
    <view class="credit-page__header">
      <ni-status-bar />
      <view class="credit-page__nav">
        <view class="credit-page__nav-button" @click="goBack">
          <ni-icon name="chevron" :size="19" state="dark" :rotate="180" />
        </view>
        <text class="credit-page__nav-title">信用中心</text>
        <view class="credit-page__nav-placeholder" />
      </view>
    </view>

    <view class="credit-page__content">
      <view class="credit-page__hero">
        <view class="credit-page__hero-head">
          <view class="credit-page__hero-icon">
            <ni-icon name="shield" :size="24" state="gold" />
          </view>
          <view class="credit-page__hero-copy">
            <text class="credit-page__hero-level">{{ credit.level }}</text>
            <text class="credit-page__hero-desc">{{ credit.nextLevel }}</text>
          </view>
        </view>
        <view class="credit-page__score-row">
          <text class="credit-page__score">{{ credit.score }}</text>
          <text class="credit-page__score-unit">分</text>
        </view>
        <ni-progress :percent="creditPercent" :height="6" color="#D4A055" />
        <view class="credit-page__score-labels">
          <text class="credit-page__score-label">0</text>
          <text class="credit-page__score-label">100</text>
        </view>
      </view>

      <view class="credit-page__levels">
        <view v-for="level in levels" :key="level.name" class="credit-page__level" :class="{ 'credit-page__level--active': level.active }">
          <text class="credit-page__level-name" :class="{ 'credit-page__level-name--active': level.active }">{{ level.name }}</text>
          <text class="credit-page__level-range">{{ level.range }}</text>
        </view>
      </view>

      <view class="credit-page__records">
        <view class="credit-page__records-head">
          <text class="credit-page__records-title">信用明细</text>
          <text class="credit-page__records-sub">近 90 天</text>
        </view>
        <view v-for="record in credit.records" :key="record.id" class="credit-page__record">
          <view class="credit-page__record-icon">
            <ni-icon name="spark" :size="14" state="gold" />
          </view>
          <view class="credit-page__record-copy">
            <text class="credit-page__record-title">{{ record.title }}</text>
            <text class="credit-page__record-time">{{ record.time }}</text>
          </view>
          <text class="credit-page__record-delta">+{{ record.delta }}</text>
        </view>
      </view>

      <view class="credit-page__rules">
        <text class="credit-page__rules-title">如何提升信用分</text>
        <text class="credit-page__rules-item">· 完成实名认证、住户认证（各 +5 信用值）</text>
        <text class="credit-page__rules-item">· 完成担保交易、按时赴约、收到好评</text>
        <text class="credit-page__rules-item">· 参与邻里互助、服务响应及时</text>
        <text class="credit-page__rules-item">· 遵守平台规则，不发布违禁物品</text>
        <text class="credit-page__rules-item">· 违规、爽约、恶意评价会扣减信用分</text>
      </view>
    </view>

    <ni-toast :visible="toast.visible" :text="toast.text" :icon="toast.icon" :bottom="40" />
  </scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import type { CreditInfo } from '../../models'
import { itemService } from '../../services/item.service'
import { useToast } from '../../composables/useToast'

const { toast, showToast } = useToast()

const credit = ref<CreditInfo>({
  score: 92,
  level: '信用极好',
  nextLevel: '距离下一等级还差 8 分',
  records: [],
})
const creditPercent = computed(() => Math.max(0, Math.min(100, credit.value.score)))
const levels = [
  { name: '待提升', range: '0–59', active: false },
  { name: '一般', range: '60–74', active: false },
  { name: '良好', range: '75–89', active: false },
  { name: '极好', range: '90–100', active: true },
]

onLoad(async () => {
  try {
    credit.value = await itemService.getCreditInfo()
  } catch (error) {
    showToast(error instanceof Error ? error.message : '信用信息加载失败', 'alert')
  }
})

function goBack(): void {
  const pages = typeof getCurrentPages === 'function' ? getCurrentPages() : []
  if (pages.length > 1) uni.navigateBack({ delta: 1 })
  else uni.switchTab({ url: '/pages/profile/index' })
}
</script>

